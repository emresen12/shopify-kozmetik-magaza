{% doc %}
  Reviews Header component for kozmetik theme.

  @example
  {% content_for 'block', type: 'reviews-header', id: 'reviews-header-1' %}
{% enddoc %}

<div class="sp-section-header" {{ block.shopify_attributes }}>
  <span class="sec-subtitle">{{ block.settings.subtitle | default: "CLIENT EXPERIENCE" }}</span>
  <h3 class="sec-title">{{ block.settings.title | default: "Müşteri Değerlendirmeleri" }}</h3>
</div>

{% schema %}
{
  "name": "Yorumlar Grubu Başlığı",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Bölüm Üst Başlığı", "default": "CLIENT EXPERIENCE" },
    { "type": "text", "id": "title", "label": "Bölüm Ana Başlığı", "default": "Müşteri Değerlendirmeleri" }
  ],
  "presets": [
    {
      "name": "Yorumlar Grubu Başlığı"
    }
  ]
}
{% endschema %}
