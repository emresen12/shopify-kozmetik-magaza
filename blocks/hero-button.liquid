{% doc %}
  Hero Button block component for kozmetik theme.

  @example
  {% content_for 'block', type: 'hero-button', id: 'hero-button-1' %}
{% enddoc %}

<div class="hero-button-block" style="
  --btn-size: {{ block.settings.font_size }}px;
  --btn-weight: {{ block.settings.font_weight }};
  --btn-bg-start: {{ block.settings.bg_color_start }};
  --btn-bg-end: {{ block.settings.bg_color_end }};
  --btn-color: {{ block.settings.text_color }};
  --btn-border: {{ block.settings.border_color }};
  --btn-radius: {{ block.settings.border_radius }}px;
  --btn-py: {{ block.settings.padding_vertical }}px;
  --btn-px: {{ block.settings.padding_horizontal }}px;
  --btn-mb: {{ block.settings.margin_bottom }}px;
" {{ block.shopify_attributes }}>
  <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="hero-button-element {{ block.settings.button_style }}">
    <span>{{ block.settings.text | default: "Koleksiyonu Keşfet" }}</span>
    {% if block.settings.show_icon %}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    {% endif %}
  </a>
</div>

{% stylesheet %}
  .hero-button-block {
    margin-bottom: var(--btn-mb, 20px);
    display: inline-block;
  }

  .hero-button-element {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--btn-size, 15px);
    font-weight: var(--btn-weight, 700);
    color: var(--btn-color, #ffffff);
    padding: var(--btn-py, 14px) var(--btn-px, 32px);
    border-radius: var(--btn-radius, 14px);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .hero-button-element.primary {
    background: linear-gradient(135deg, var(--btn-bg-start, #c25b82) 0%, var(--btn-bg-end, #a44267) 100%);
    border: 1px solid var(--btn-border, transparent);
  }

  .hero-button-element.secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
  }

  .hero-button-element.outline {
    background: transparent;
    border: 1px solid var(--btn-border, #f7cad0);
    color: var(--btn-color, #f7cad0);
  }

  .hero-button-element:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(194, 91, 130, 0.4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Buton",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Buton Metni",
      "default": "Koleksiyonu Keşfet"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Buton Linki"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Buton Tarzı",
      "options": [
        { "value": "primary", "label": "Birincil (Dolu / Gradyan)" },
        { "value": "secondary", "label": "İkincil (Cam Efektli)" },
        { "value": "outline", "label": "Çerçeveli (Outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Ok İkonu Göster",
      "default": true
    },
    {
      "type": "header",
      "content": "Tipografi"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Yazı Boyutu",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Yazı Kalınlığı",
      "options": [
        { "value": "600", "label": "Yarı Kalın (600)" },
        { "value": "700", "label": "Kalın (700)" },
        { "value": "800", "label": "Ekstra Kalın (800)" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Renkler & Kenarlık"
    },
    {
      "type": "color",
      "id": "bg_color_start",
      "label": "Arka Plan / Gradyan Başlangıcı",
      "default": "#c25b82"
    },
    {
      "type": "color",
      "id": "bg_color_end",
      "label": "Gradyan Bitiş Rengi",
      "default": "#a44267"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Metin Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Kenarlık Rengi (Outline için)",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Köşe Yuvarlama (Radius)",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Boşluklar"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Dikey İç Boşluk (Padding Y)",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Yatay İç Boşluk (Padding X)",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Alt Dış Boşluk (Margin Bottom)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Hero Buton"
    }
  ]
}
{% endschema %}
