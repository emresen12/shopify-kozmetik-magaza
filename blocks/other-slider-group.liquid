{% doc %}
  Other Slider Group block component for kozmetik theme.

  @example
  {% content_for 'block', type: 'other-slider-group', id: 'other-slider-group-1' %}
{% enddoc %}

<div class="sp-other-products-section" {{ block.shopify_attributes }}>
  <div class="sp-section-header-slider">
    <div>
      <span class="sec-subtitle">{{ block.settings.subtitle | default: "TÜM ÜRÜNLERİMİZ" }}</span>
      <h3 class="sec-title">{{ block.settings.title | default: "Diğer Ürünlerimiz" }}</h3>
    </div>
    
    <div class="slider-arrow-controls">
      <button type="button" class="slider-arrow-btn slider-prev" id="SpOtherSliderPrev" aria-label="Önceki Ürünler">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button type="button" class="slider-arrow-btn slider-next" id="SpOtherSliderNext" aria-label="Sonraki Ürünler">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <div class="other-products-track" id="SpOtherProductsTrack">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .sp-other-products-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Diğer Ürünler Grubu",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Bölüm Üst Başlığı", "default": "TÜM ÜRÜNLERİMİZ" },
    { "type": "text", "id": "title", "label": "Bölüm Ana Başlığı", "default": "Diğer Ürünlerimiz" }
  ],
  "presets": [
    {
      "name": "Diğer Ürünler Grubu"
    }
  ]
}
{% endschema %}
