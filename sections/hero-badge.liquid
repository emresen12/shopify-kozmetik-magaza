{% comment %}
  Standalone Hero Badge Section
{% endcomment %}

<div class="hero-badge-section-wrapper full-width" style="text-align: {{ section.settings.alignment }};">
  <span class="hero-badge-pill" style="display: inline-block; padding: 6px 16px; border-radius: 20px; background: rgba(194, 91, 130, 0.2); color: #f7cad0; border: 1px solid rgba(247, 202, 208, 0.4); font-size: 13px; font-weight: 700;">
    ✦ SEÇKİN KOLEKSİYONLAR
  </span>
</div>

{% schema %}
{
  "name": "Hero Rozeti (Section)",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Hizalama",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" },
        { "value": "right", "label": "Sağ" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hero Rozeti (Section)"
    }
  ]
}
{% endschema %}
