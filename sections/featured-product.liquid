{% comment %}
  Ultra-Luxury High-Fashion Cosmetic Product Spotlight Section (100% Block-Based)
{% endcomment %}

<div class="featured-product-section full-width" id="featuredProduct">
  <!-- Glowing Atmosphere Orbs -->
  <div class="luxury-orb orb-top-left"></div>
  <div class="luxury-orb orb-bottom-right"></div>

  <div class="featured-product-container">
    {% assign display_product = section.settings.featured_product %}

    <!-- Left: Product Image Gallery -->
    <div class="featured-product__gallery">
      <div class="luxury-image-frame">
        <div class="frame-aura-glow"></div>
        {% if display_product and display_product.featured_image %}
          {{ display_product.featured_image | image_url: width: 800 | image_tag: class: 'featured-product__img', loading: 'lazy' }}
        {% else %}
          <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Gençleştirici Serum" class="featured-product__img" width="600" height="600" loading="lazy">
        {% endif %}

        {% if section.settings.badge_text != blank %}
          <span class="metallic-sale-tag">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>
      
      <div class="featured-product__thumbs">
        <div class="thumb-glass-card active">
          {% if display_product and display_product.featured_image %}
            {{ display_product.featured_image | image_url: width: 150 | image_tag: loading: 'lazy' }}
          {% else %}
            <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Serum 1" width="80" height="80">
          {% endif %}
        </div>
        <div class="thumb-glass-card">
          <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Cream Demo" width="80" height="80">
        </div>
      </div>
    </div>

    <!-- Right: High-Fashion Glass Content Panel (Rendered dynamically from Blocks) -->
    <div class="featured-product__glass-card">
      
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'subheading' %}
            <div class="brand-subheading" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {% when 'title' %}
            <h2 class="featured-product__title" {{ block.shopify_attributes }}>
              {% if display_product %}{{ display_product.title }}{% else %}{{ block.settings.text }}{% endif %}
            </h2>

          {% when 'rating' %}
            <div class="featured-product__rating" {{ block.shopify_attributes }}>
              <div class="stars">{{ block.settings.stars }}</div>
              <span class="rating-score">{{ block.settings.score }}</span>
              <span class="rating-count">{{ block.settings.count_text }}</span>
            </div>

          {% when 'price' %}
            <div class="featured-product__price-box" {{ block.shopify_attributes }}>
              <span class="price-current">
                {% if display_product %}{{ display_product.price | money }}{% else %}{{ block.settings.price }}{% endif %}
              </span>
              <span class="price-compare">
                {% if display_product and display_product.compare_at_price %}{{ display_product.compare_at_price | money }}{% else %}{{ block.settings.compare_price }}{% endif %}
              </span>
              {% if block.settings.savings_text != blank %}
                <span class="gold-savings-badge">{{ block.settings.savings_text }}</span>
              {% endif %}
            </div>

          {% when 'description' %}
            <p class="featured-product__description" {{ block.shopify_attributes }}>
              {% if display_product and display_product.description != blank %}
                {{ display_product.description | strip_html | truncate: 220 }}
              {% else %}
                {{ block.settings.text }}
              {% endif %}
            </p>

          {% when 'cert_pill' %}
            <div class="dark-cert-pill" {{ block.shopify_attributes }}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
              {{ block.settings.text }}
            </div>

          {% when 'volume_options' %}
            <div class="featured-product__option" {{ block.shopify_attributes }}>
              <span class="option-label">{{ block.settings.label }}</span>
              <div class="option-chips">
                <button type="button" class="dark-chip-btn active" data-volume="30ml">{{ block.settings.opt_1 }}</button>
                <button type="button" class="dark-chip-btn" data-volume="50ml">{{ block.settings.opt_2 }}</button>
              </div>
            </div>

          {% when 'buy_buttons' %}
            <div class="featured-product__actions" {{ block.shopify_attributes }}>
              <div class="dark-qty-stepper">
                <button type="button" class="dstepper-btn qty-minus" aria-label="Azalt">-</button>
                <input type="number" value="1" min="1" class="dstepper-input qty-input" readonly>
                <button type="button" class="dstepper-btn qty-plus" aria-label="Artır">+</button>
              </div>
              
              <button type="button" class="haute-add-btn demo-add-btn">
                <span>{{ block.settings.btn_text }}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              </button>
            </div>

          {% when 'accordion' %}
            <div class="featured-product__accordion" {{ block.shopify_attributes }}>
              <details class="accordion-item" open>
                <summary class="accordion-header">
                  <span>{{ block.settings.title }}</span>
                  <span class="acc-icon">+</span>
                </summary>
                <div class="accordion-body">
                  {{ block.settings.content }}
                </div>
              </details>
            </div>

        {% endcase %}
      {% endfor %}

      <!-- Toast Alert -->
      <div class="cart-toast" id="cartToast">
        ✓ Özel bakım ürünü sepete başarıyla eklendi!
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .featured-product-section {
    position: relative;
    background: linear-gradient(135deg, #0f0b10 0%, #170f1a 50%, #0b080c 100%);
    padding: 100px 24px;
    margin: 0;
    overflow: hidden;
    color: #ffffff;
  }

  .luxury-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 1;
  }

  .orb-top-left {
    width: 500px;
    height: 500px;
    background: rgba(194, 91, 130, 0.18);
    top: -100px;
    left: -100px;
  }

  .orb-bottom-right {
    width: 600px;
    height: 600px;
    background: rgba(247, 202, 208, 0.14);
    bottom: -150px;
    right: -150px;
  }

  .featured-product-container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .featured-product__gallery {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .luxury-image-frame {
    position: relative;
    border-radius: 32px;
    padding: 8px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.05) 100%);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .frame-aura-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(194, 91, 130, 0.35) 0%, transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .featured-product__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 26px;
    display: block;
    position: relative;
    z-index: 2;
  }

  .metallic-sale-tag {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 3;
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 8px 18px;
    border-radius: 30px;
    letter-spacing: 0.1em;
    box-shadow: 0 8px 20px rgba(194, 91, 130, 0.4);
  }

  .featured-product__thumbs {
    display: flex;
    gap: 14px;
  }

  .thumb-glass-card {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    padding: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    cursor: pointer;
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .thumb-glass-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  .thumb-glass-card.active,
  .thumb-glass-card:hover {
    border-color: #c25b82;
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(194, 91, 130, 0.3);
  }

  .featured-product__glass-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 36px;
    padding: 50px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .brand-subheading {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #f7cad0;
    text-transform: uppercase;
  }

  .featured-product__title {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
    color: #ffffff;
  }

  .featured-product__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
  }

  .stars {
    color: #f7cad0;
    letter-spacing: 2px;
  }

  .rating-score {
    font-weight: 800;
    color: #ffffff;
  }

  .rating-count {
    color: rgba(255, 255, 255, 0.65);
    font-size: 0.82rem;
  }

  .featured-product__price-box {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .price-current {
    font-size: 2.1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .price-compare {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: line-through;
  }

  .gold-savings-badge {
    background: rgba(247, 202, 208, 0.15);
    border: 1px solid rgba(247, 202, 208, 0.3);
    color: #f7cad0;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .featured-product__description {
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }

  .dark-cert-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .featured-product__option {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .option-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  .option-chips {
    display: flex;
    gap: 12px;
  }

  .dark-chip-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 14px;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .dark-chip-btn.active,
  .dark-chip-btn:hover {
    background: rgba(194, 91, 130, 0.3);
    border-color: #f7cad0;
    box-shadow: 0 4px 15px rgba(194, 91, 130, 0.25);
  }

  .featured-product__actions {
    display: flex;
    gap: 16px;
  }

  .dark-qty-stepper {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    overflow: hidden;
  }

  .dstepper-btn {
    width: 42px;
    height: 48px;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .dstepper-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .dstepper-input {
    width: 40px;
    text-align: center;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 800;
    outline: none;
  }

  .haute-add-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    padding: 14px 28px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(194, 91, 130, 0.4);
    transition: all 0.3s ease;
  }

  .haute-add-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(194, 91, 130, 0.55);
  }

  .cart-toast {
    display: none;
    background: rgba(42, 157, 143, 0.25);
    border: 1px solid rgba(42, 157, 143, 0.5);
    color: #52b788;
    padding: 12px 20px;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    animation: fadeIn 0.3s ease;
  }

  .featured-product__accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }

  .accordion-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
  }

  .accordion-header {
    padding: 16px 20px;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
    list-style: none;
  }

  .accordion-header::-webkit-details-marker {
    display: none;
  }

  .accordion-body {
    padding: 0 20px 18px;
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
  }

  @media (max-width: 992px) {
    .featured-product-container {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // Quantity stepper
    const minus = document.querySelector('.qty-minus');
    const plus = document.querySelector('.qty-plus');
    const input = document.querySelector('.qty-input');

    if (minus && plus && input) {
      minus.addEventListener('click', () => {
        let val = parseInt(input.value) || 1;
        if (val > 1) input.value = val - 1;
      });
      plus.addEventListener('click', () => {
        let val = parseInt(input.value) || 1;
        input.value = val + 1;
      });
    }

    // Chip selection
    const chips = document.querySelectorAll('.dark-chip-btn');
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
      });
    });

    // Toast alert
    const demoAddBtn = document.querySelector('.demo-add-btn');
    const toast = document.getElementById('cartToast');
    if (demoAddBtn && toast) {
      demoAddBtn.addEventListener('click', () => {
        toast.style.display = 'block';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 3000);
      });
    }
  });
{% endjavascript %}

