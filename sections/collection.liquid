{% comment %}
  Dark Luxury Collection Page Section with Compact Product Cards
{% endcomment %}

<div class="collection-page-section full-width">
  <div class="collection-hero-banner">
    <div class="hero-orb orb-1"></div>
    <div class="hero-orb orb-2"></div>
    <div class="collection-hero-content">
      <span class="collection-badge">✦ SEÇKİN KOLEKSİYONLAR</span>
      <h1 class="collection-main-title">{{ collection.title | default: "Tüm Ürünlerimiz" }}</h1>
      <p class="collection-main-desc">
        {{ collection.description | default: "Doğanın en saf ve etkili içerikleriyle formüle edilmiş, cildinize anında ışıltı ve canlılık veren ürünlerimizi keşfedin." }}
      </p>
    </div>
  </div>

  <div class="collection-container">
    <!-- Filter Tabs & Sort Bar -->
    <div class="collection-filter-bar">
      <div class="filter-pills">
        <button type="button" class="filter-pill active">Tüm Ürünler</button>
        <button type="button" class="filter-pill">Serumlar</button>
        <button type="button" class="filter-pill">Nemlendiriciler</button>
        <button type="button" class="filter-pill">Yüz Maskeleri</button>
        <button type="button" class="filter-pill">Göz Bakımı</button>
      </div>
      <div class="collection-sort-box">
        <span class="sort-label">Sırala:</span>
        <select class="dark-sort-select">
          <option value="manual">Öne Çıkanlar</option>
          <option value="price-ascending">Fiyat: Düşükten Yükseğe</option>
          <option value="price-descending">Fiyat: Yüksekten Düşüğe</option>
          <option value="created-descending">En Yeniler</option>
        </select>
      </div>
    </div>

    <!-- Compact Product Grid -->
    <div class="collection-products-grid">
      {% paginate collection.products by 24 %}
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <div class="compact-product-card">
              <div class="compact-card__img-box">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 450 | image_tag: class: 'compact-card__img', loading: 'lazy' }}
                  {% else %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="{{ product.title }}" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% endif %}
                </a>

                <span class="compact-card__tag">✦ SEÇKİN</span>

                <button type="button" class="compact-wishlist-btn" aria-label="Favorilere Ekle">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </button>

                <button type="button" class="compact-quick-add-btn demo-add-btn">
                  + Sepete Ekle
                </button>
              </div>

              <div class="compact-card__info">
                <div class="compact-card__rating">
                  <span class="stars">★★★★★</span>
                  <span class="rating-val">5.0</span>
                </div>
                <h3 class="compact-card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <div class="compact-card__price-row">
                  <span class="compact-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="compact-compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% comment %} Demonstration fallback products for display {% endcomment %}
          {% assign demo_titles = "Radiance Glow Serum,Hydra-Luxe Velvet Cream,Rose Infusion Mask,Midnight Repair Oil,Botanical Cleansing Elixir,Lumière Gold Eye Complex,Peptide Renewal Concentrate,Satin Finish Sunscreen" | split: "," %}
          {% assign demo_prices = "₺450,00,₺620,00,₺380,00,₺740,00,₺310,00,₺590,00,₺850,00,₺420,00" | split: "," %}
          {% assign demo_old_prices = "₺590,00,₺750,00,₺460,00,₺900,00,₺390,00,₺720,00,₺990,00,₺510,00" | split: "," %}
          
          {% for i in (1..8) %}
            {% assign demo_idx = forloop.index0 %}
            {% assign mod2 = forloop.index | modulo: 2 %}
            {% assign mod3 = forloop.index | modulo: 3 %}

            <div class="compact-product-card">
              <div class="compact-card__img-box">
                <a href="#">
                  {% if mod2 == 0 %}
                    <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Demo Ürün" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% else %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Demo Ürün" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% endif %}
                </a>

                {% if mod3 == 0 %}
                  <span class="compact-card__tag sale-tag">%25 İNDİRİM</span>
                {% else %}
                  <span class="compact-card__tag">✦ SEÇKİN</span>
                {% endif %}

                <button type="button" class="compact-wishlist-btn" aria-label="Favorilere Ekle">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </button>

                <button type="button" class="compact-quick-add-btn demo-add-btn">
                  + Sepete Ekle
                </button>
              </div>

              <div class="compact-card__info">
                <div class="compact-card__rating">
                  <span class="stars">★★★★★</span>
                  <span class="rating-val">5.0</span>
                </div>
                <h3 class="compact-card__title">
                  <a href="#">{{ demo_titles[demo_idx] }}</a>
                </h3>
                <div class="compact-card__price-row">
                  <span class="compact-price">{{ demo_prices[demo_idx] }}</span>
                  <span class="compact-compare-price">{{ demo_old_prices[demo_idx] }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if paginate.pages > 1 %}
          <div class="dark-pagination-wrapper">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-page-section {
    background: linear-gradient(180deg, #0b080c 0%, #130d16 40%, #09060a 100%);
    color: #ffffff;
    padding-bottom: 90px;
    margin: 0;
    min-height: 100vh;
  }

  .collection-hero-banner {
    position: relative;
    padding: 140px 24px 60px;
    text-align: center;
    background: radial-gradient(circle at center, rgba(194, 91, 130, 0.15) 0%, transparent 70%);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .hero-orb.orb-1 {
    width: 400px;
    height: 400px;
    background: rgba(194, 91, 130, 0.2);
    top: -50px;
    left: 20%;
  }

  .hero-orb.orb-2 {
    width: 350px;
    height: 350px;
    background: rgba(247, 202, 208, 0.15);
    bottom: -50px;
    right: 20%;
  }

  .collection-hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
    margin: 0 auto;
  }

  .collection-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    color: #f7cad0;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 30px;
    letter-spacing: 1.5px;
    margin-bottom: 14px;
  }

  .collection-main-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 14px;
    background: linear-gradient(135deg, #ffffff 0%, #f7cad0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .collection-main-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    margin: 0;
  }

  .collection-container {
    max-width: 1320px;
    margin: 40px auto 0;
    padding: 0 24px;
  }

  /* Filter & Sort Bar */
  .collection-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 36px;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px);
    border-radius: 20px;
  }

  .filter-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 8px 18px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: rgba(194, 91, 130, 0.3);
    border-color: #f7cad0;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.2);
  }

  .collection-sort-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sort-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
  }

  .dark-sort-select {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: #ffffff;
    padding: 8px 14px;
    font-size: 0.85rem;
    outline: none;
    cursor: pointer;
  }

  .dark-sort-select option {
    background: #130d16;
    color: #ffffff;
  }

  /* Compact Products Grid (5-column layout on desktop) */
  .collection-products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 22px;
  }

  .compact-product-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .compact-product-card:hover {
    transform: translateY(-6px);
    border-color: rgba(247, 202, 208, 0.4);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(194, 91, 130, 0.2);
  }

  .compact-card__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }

  .compact-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compact-product-card:hover .compact-card__img {
    transform: scale(1.08);
  }

  .compact-card__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .compact-card__tag.sale-tag {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    border: none;
  }

  .compact-wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.2s ease;
  }

  .compact-wishlist-btn:hover {
    background: #c25b82;
    border-color: #c25b82;
    transform: scale(1.1);
  }

  .compact-quick-add-btn {
    position: absolute;
    bottom: -40px;
    left: 10px;
    right: 10px;
    padding: 8px;
    background: rgba(18, 12, 20, 0.9);
    border: 1px solid rgba(247, 202, 208, 0.4);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    border-radius: 10px;
    cursor: pointer;
    z-index: 3;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compact-product-card:hover .compact-quick-add-btn {
    bottom: 10px;
  }

  .compact-quick-add-btn:hover {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    border-color: transparent;
  }

  /* Card Info */
  .compact-card__info {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .compact-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
  }

  .compact-card__rating .stars {
    color: #f7cad0;
    letter-spacing: 1px;
  }

  .compact-card__rating .rating-val {
    color: rgba(255, 255, 255, 0.6);
    font-weight: 700;
  }

  .compact-card__title {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .compact-card__title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .compact-card__title a:hover {
    color: #f7cad0;
  }

  .compact-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }

  .compact-price {
    font-size: 0.98rem;
    font-weight: 800;
    color: #f7cad0;
  }

  .compact-compare-price {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: line-through;
  }

  .dark-pagination-wrapper {
    margin-top: 50px;
    text-align: center;
    grid-column: 1 / -1;
  }

  .dark-pagination-wrapper a,
  .dark-pagination-wrapper span {
    display: inline-block;
    padding: 8px 14px;
    margin: 0 4px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .dark-pagination-wrapper .current {
    background: #c25b82;
    border-color: #c25b82;
  }

  @media (max-width: 768px) {
    .collection-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koleksiyon Ürünleri",
  "settings": [],
  "presets": [
    {
      "name": "Koleksiyon Ürünleri"
    }
  ]
}
{% endschema %}
