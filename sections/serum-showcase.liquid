{% comment %}
  Standalone Serum Image Showcase Section with Block-Level Inspector Click Support
  Clicking the image in Shopify Theme Editor selects the Image Block and opens its properties!
{% endcomment %}

<div class="serum-showcase-section full-width" style="
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
  --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
  --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  --max-width: {{ section.settings.max_width }}px;
  --bg-color: {{ section.settings.bg_color }};
  --orb-1-color: {{ section.settings.orb_1_color }};
  --orb-2-color: {{ section.settings.orb_2_color }};
  --frame-bg: {{ section.settings.frame_bg }};
  --frame-border: {{ section.settings.frame_border }};
  --frame-radius: {{ section.settings.frame_radius }}px;
  --frame-blur: {{ section.settings.frame_blur }}px;
  --badge-bg: {{ section.settings.badge_bg }};
  --badge-text-color: {{ section.settings.badge_text_color }};
  --img-radius: {{ section.settings.img_radius }}px;
">

  <!-- Glowing Background Orbs -->
  <div class="serum-orb orb-1"></div>
  <div class="serum-orb orb-2"></div>

  <div class="serum-showcase-container">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image' %}
            <div class="serum-glass-frame" style="
              --max-width: {{ block.settings.max_width | default: 1000 }}px;
              --frame-bg: {{ block.settings.frame_bg | default: 'rgba(255, 255, 255, 0.04)' }};
              --frame-border: {{ block.settings.frame_border | default: 'rgba(255, 255, 255, 0.15)' }};
              --frame-radius: {{ block.settings.frame_radius | default: 32 }}px;
              --frame-blur: {{ block.settings.frame_blur | default: 20 }}px;
              --aura-glow-color: {{ block.settings.aura_glow_color | default: 'rgba(194, 91, 130, 0.25)' }};
              --img-radius: {{ block.settings.img_radius | default: 24 }}px;
              --badge-bg: {{ block.settings.badge_bg | default: '#c25b82' }};
              --badge-text-color: {{ block.settings.badge_text_color | default: '#ffffff' }};
              --badge-font-size: {{ block.settings.badge_font_size | default: 13 }}px;
              --caption-bg: {{ block.settings.caption_bg | default: 'rgba(15, 11, 16, 0.7)' }};
              --caption-title-color: {{ block.settings.caption_title_color | default: '#ffffff' }};
              --caption-title-size: {{ block.settings.caption_title_size | default: 22 }}px;
              --caption-sub-color: {{ block.settings.caption_subtitle_color | default: 'rgba(255, 255, 255, 0.75)' }};
              --padding-top: {{ block.settings.padding_top | default: 0 }}px;
              --padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
              --margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
            " {{ block.shopify_attributes }}>
              <div class="serum-aura-glow"></div>
              
              <!-- Main Serum Image -->
              <div class="serum-image-wrapper">
                {% if block.settings.serum_image != blank %}
                  {{ block.settings.serum_image | image_url: width: 1200 | image_tag: class: 'serum-showcase-img', loading: 'lazy' }}
                {% elsif section.settings.serum_image != blank %}
                  {{ section.settings.serum_image | image_url: width: 1200 | image_tag: class: 'serum-showcase-img', loading: 'lazy' }}
                {% else %}
                  <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Lüks Gençleştirici Serum" class="serum-showcase-img" width="800" height="800" loading="lazy">
                {% endif %}
              </div>

              <!-- Badge Overlay -->
              {% assign badge_val = block.settings.badge_text | default: section.settings.badge_text %}
              {% if badge_val != blank %}
                <div class="serum-badge-overlay">
                  <span>{{ badge_val }}</span>
                </div>
              {% endif %}

              <!-- Caption Overlay -->
              {% assign title_val = block.settings.caption_title | default: section.settings.caption_title %}
              {% if title_val != blank %}
                <div class="serum-caption-overlay">
                  <h3>{{ title_val }}</h3>
                  {% assign sub_val = block.settings.caption_subtitle | default: section.settings.caption_subtitle %}
                  {% if sub_val != blank %}
                    <p>{{ sub_val }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    {% else %}
      <div class="serum-glass-frame" {{ section.shopify_attributes }}>
        <div class="serum-aura-glow"></div>
        <div class="serum-image-wrapper">
          {% if section.settings.serum_image != blank %}
            {{ section.settings.serum_image | image_url: width: 1200 | image_tag: class: 'serum-showcase-img', loading: 'lazy' }}
          {% else %}
            <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Lüks Gençleştirici Serum" class="serum-showcase-img" width="800" height="800" loading="lazy">
          {% endif %}
        </div>
        {% if section.settings.badge_text != blank %}
          <div class="serum-badge-overlay">
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {% endif %}
        {% if section.settings.caption_title != blank %}
          <div class="serum-caption-overlay">
            <h3>{{ section.settings.caption_title }}</h3>
            {% if section.settings.caption_subtitle != blank %}
              <p>{{ section.settings.caption_subtitle }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .serum-showcase-section {
    position: relative;
    width: 100%;
    background: var(--bg-color, #0b080c);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 80px);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .serum-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 1;
  }

  .serum-orb.orb-1 {
    top: -10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: var(--orb-1-color, rgba(194, 91, 130, 0.2));
  }

  .serum-orb.orb-2 {
    bottom: -10%;
    right: 20%;
    width: 450px;
    height: 450px;
    background: var(--orb-2-color, rgba(247, 202, 208, 0.15));
  }

  .serum-showcase-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-width, 1000px);
    padding: 0 24px;
    margin: 0 auto;
  }

  .serum-glass-frame {
    position: relative;
    background: var(--frame-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--frame-border, rgba(255, 255, 255, 0.15));
    backdrop-filter: blur(var(--frame-blur, 20px));
    border-radius: var(--frame-radius, 32px);
    padding: 24px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
  }

  .serum-glass-frame:hover {
    transform: translateY(-6px);
    border-color: rgba(247, 202, 208, 0.4);
    box-shadow: 0 40px 90px rgba(194, 91, 130, 0.25);
  }

  .serum-aura-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--frame-radius, 32px);
    background: linear-gradient(135deg, rgba(247, 202, 208, 0.2) 0%, transparent 50%, rgba(194, 91, 130, 0.2) 100%);
    z-index: 0;
    pointer-events: none;
  }

  .serum-image-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: var(--img-radius, 24px);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .serum-showcase-img {
    width: 100%;
    max-height: 650px;
    object-fit: cover;
    display: block;
    border-radius: var(--img-radius, 24px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .serum-glass-frame:hover .serum-showcase-img {
    transform: scale(1.03);
  }

  .serum-badge-overlay {
    position: absolute;
    top: 40px;
    left: 40px;
    z-index: 3;
    background: var(--badge-bg, linear-gradient(135deg, #c25b82 0%, #a24367 100%));
    color: var(--badge-text-color, #ffffff);
    padding: 10px 20px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .serum-caption-overlay {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
    z-index: 3;
    background: rgba(15, 11, 16, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 20px 28px;
    color: #ffffff;
  }

  .serum-caption-overlay h3 {
    margin: 0 0 6px 0;
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
  }

  .serum-caption-overlay p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 768px) {
    .serum-showcase-section {
      padding-top: var(--mobile-padding-top, 40px);
      padding-bottom: var(--mobile-padding-bottom, 40px);
    }

    .serum-glass-frame {
      padding: 14px;
      border-radius: 20px;
    }

    .serum-badge-overlay {
      top: 24px;
      left: 24px;
      padding: 8px 14px;
      font-size: 0.72rem;
    }

    .serum-caption-overlay {
      bottom: 24px;
      left: 24px;
      right: 24px;
      padding: 14px 18px;
    }

    .serum-caption-overlay h3 {
      font-size: 1.1rem;
    }
  }
{% endstylesheet %}

