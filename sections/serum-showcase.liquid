{% comment %}
  Dual Image Showcase Section with Sticky Vertical Skincare Text ("Cilt Bakımı")
  - Entire frames and sticky text are 100% clickable, redirecting to /collections/cilt-bakimi
{% endcomment %}

<div class="serum-showcase-section full-width" style="
  --padding-top: {{ section.settings.padding_top | default: 80 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  --mobile-padding-top: {{ section.settings.mobile_padding_top | default: 40 }}px;
  --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom | default: 40 }}px;
  --max-width: {{ section.settings.max_width | default: 1200 }}px;
  --bg-color: {{ section.settings.bg_color | default: '#0b080c' }};
  --orb-1-color: {{ section.settings.orb_1_color | default: 'rgba(194, 91, 130, 0.2)' }};
  --orb-2-color: {{ section.settings.orb_2_color | default: 'rgba(247, 202, 208, 0.15)' }};
">

  <!-- Glowing Background Orbs -->
  <div class="serum-orb orb-1"></div>
  <div class="serum-orb orb-2"></div>

  <div class="serum-showcase-container">
    {% assign target_url = collections['cilt-bakimi'].url | default: routes.all_products_collection_url %}
    <div class="serum-showcase-layout">
      
      <!-- Sticky Vertical Side Text ("CİLT BAKIMI") - Clickable -->
      {% if section.settings.show_side_text %}
        <div class="serum-sticky-col">
          <a href="{{ section.settings.side_text_url | default: target_url }}" class="serum-sticky-link" title="{{ section.settings.side_text | default: 'CİLT BAKIMI' }} Koleksiyonu">
            <div class="serum-sticky-text-wrapper">
              <span class="serum-vertical-text">{{ section.settings.side_text | default: "CİLT BAKIMI" }}</span>
              <div class="serum-vertical-line"></div>
            </div>
          </a>
        </div>
      {% endif %}

      <!-- Dual Images Grid - Clickable Frames -->
      <div class="serum-images-grid">
        {% assign img_blocks = section.blocks | where: "type", "image" %}
        {% if img_blocks.size > 0 %}
          {% for block in img_blocks %}
            <a href="{{ block.settings.url | default: target_url }}" class="serum-glass-frame" style="
              --frame-bg: {{ block.settings.frame_bg | default: 'rgba(255, 255, 255, 0.04)' }};
              --frame-border: {{ block.settings.frame_border | default: 'rgba(255, 255, 255, 0.15)' }};
              --frame-radius: {{ block.settings.frame_radius | default: 28 }}px;
              --frame-blur: {{ block.settings.frame_blur | default: 20 }}px;
              --aura-glow-color: {{ block.settings.aura_glow_color | default: 'rgba(194, 91, 130, 0.25)' }};
              --img-radius: {{ block.settings.img_radius | default: 20 }}px;
            " {{ block.shopify_attributes }}>
              <div class="serum-aura-glow"></div>
              
              <!-- Image Wrapper -->
              <div class="serum-image-wrapper">
                {% if block.settings.serum_image != blank %}
                  {{ block.settings.serum_image | image_url: width: 1000 | image_tag: class: 'serum-showcase-img', loading: 'lazy', alt: block.settings.caption_title }}
                {% else %}
                  {% if forloop.index == 1 %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Lüks Hyalüronik Serum" class="serum-showcase-img" width="600" height="750" loading="lazy">
                  {% else %}
                    <img src="{{ 'zmm-hero.jpg' | asset_url }}" alt="Cilt Bakım Rutini" class="serum-showcase-img" width="600" height="750" loading="lazy">
                  {% endif %}
                {% endif %}
              </div>

              <!-- Badge Overlay -->
              {% if block.settings.badge_text != blank %}
                <div class="serum-badge-overlay">
                  <span>{{ block.settings.badge_text }}</span>
                </div>
              {% endif %}

              <!-- Caption Overlay -->
              {% if block.settings.caption_title != blank %}
                <div class="serum-caption-overlay">
                  <h3>{{ block.settings.caption_title }}</h3>
                  {% if block.settings.caption_subtitle != blank %}
                    <p>{{ block.settings.caption_subtitle }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </a>
          {% endfor %}
        {% else %}
          <!-- Default Fallback: 2 Images Side-by-Side (Clickable) -->
          <a href="{{ target_url }}" class="serum-glass-frame" {{ section.shopify_attributes }}>
            <div class="serum-aura-glow"></div>
            <div class="serum-image-wrapper">
              <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Lüks Hyalüronik Serum" class="serum-showcase-img" width="600" height="750" loading="lazy">
            </div>
            <div class="serum-badge-overlay">
              <span>✦ SAF HYALÜRONİK SERUM</span>
            </div>
            <div class="serum-caption-overlay">
              <h3>Radiance Glow Serum</h3>
              <p>Derinlemesine nem & ışıltı veren gençlik iksiri</p>
            </div>
          </a>

          <a href="{{ target_url }}" class="serum-glass-frame" {{ section.shopify_attributes }}>
            <div class="serum-aura-glow"></div>
            <div class="serum-image-wrapper">
              <img src="{{ 'zmm-hero.jpg' | asset_url }}" alt="Gece Nemlendirici Bakım" class="serum-showcase-img" width="600" height="750" loading="lazy">
            </div>
            <div class="serum-badge-overlay">
              <span>✦ GECE BAKIM İKSİRİ</span>
            </div>
            <div class="serum-caption-overlay">
              <h3>Velvet Hydra Gece Kremi</h3>
              <p>Gece boyunca yenileyici ve elastikiyet artırıcı formül</p>
            </div>
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .serum-showcase-section {
    position: relative;
    width: 100%;
    background: var(--bg-color, #0b080c);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 80px);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .serum-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 1;
  }

  .serum-orb.orb-1 {
    top: -10%;
    left: 15%;
    width: 550px;
    height: 550px;
    background: var(--orb-1-color, rgba(194, 91, 130, 0.2));
  }

  .serum-orb.orb-2 {
    bottom: -10%;
    right: 15%;
    width: 500px;
    height: 500px;
    background: var(--orb-2-color, rgba(247, 202, 208, 0.15));
  }

  .serum-showcase-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max-width, 1200px);
    padding: 0 24px;
    margin: 0 auto;
  }

  .serum-showcase-layout {
    display: flex;
    align-items: flex-start;
    gap: 36px;
    position: relative;
    width: 100%;
  }

  /* Sticky Vertical Side Text Link */
  .serum-sticky-col {
    position: sticky;
    top: 140px;
    flex-shrink: 0;
    width: 50px;
    display: flex;
    justify-content: center;
    align-self: flex-start;
    padding-top: 10px;
    z-index: 5;
  }

  .serum-sticky-link {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  .serum-sticky-text-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .serum-vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #f7cad0;
    white-space: nowrap;
    background: linear-gradient(180deg, #ffffff 0%, #f7cad0 50%, #c25b82 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 2px 10px rgba(194, 91, 130, 0.3));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .serum-sticky-link:hover .serum-vertical-text {
    filter: drop-shadow(0 0 16px rgba(247, 202, 208, 0.7));
    transform: rotate(180deg) scale(1.05);
  }

  .serum-vertical-line {
    width: 2px;
    height: 90px;
    background: linear-gradient(to bottom, #c25b82 0%, #f7cad0 50%, transparent 100%);
    border-radius: 2px;
  }

  /* Dual Images Grid & Clickable Glass Frames */
  .serum-images-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    width: 100%;
  }

  a.serum-glass-frame,
  div.serum-glass-frame {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    background: var(--frame-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--frame-border, rgba(255, 255, 255, 0.15));
    backdrop-filter: blur(var(--frame-blur, 20px));
    border-radius: var(--frame-radius, 28px);
    padding: 18px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
  }

  .serum-glass-frame:hover {
    transform: translateY(-6px);
    border-color: rgba(247, 202, 208, 0.4);
    box-shadow: 0 35px 80px rgba(194, 91, 130, 0.25);
  }

  .serum-aura-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--frame-radius, 28px);
    background: linear-gradient(135deg, rgba(247, 202, 208, 0.15) 0%, transparent 50%, rgba(194, 91, 130, 0.2) 100%);
    z-index: 0;
    pointer-events: none;
  }

  .serum-image-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    border-radius: var(--img-radius, 20px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .serum-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--img-radius, 20px);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .serum-glass-frame:hover .serum-showcase-img {
    transform: scale(1.05);
  }

  .serum-badge-overlay {
    position: absolute;
    top: 32px;
    left: 32px;
    z-index: 3;
    background: linear-gradient(135deg, #c25b82 0%, #a24367 100%);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 24px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .serum-caption-overlay {
    position: absolute;
    bottom: 32px;
    left: 32px;
    right: 32px;
    z-index: 3;
    background: rgba(15, 11, 16, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 16px 20px;
    color: #ffffff;
  }

  .serum-caption-overlay h3 {
    margin: 0 0 4px 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
  }

  .serum-caption-overlay p {
    margin: 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 900px) {
    .serum-showcase-layout {
      flex-direction: column;
      gap: 20px;
    }

    .serum-sticky-col {
      position: relative;
      top: 0;
      width: 100%;
      height: auto;
      justify-content: flex-start;
    }

    .serum-sticky-text-wrapper {
      flex-direction: row;
      gap: 14px;
    }

    .serum-vertical-text {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.1rem;
      letter-spacing: 0.2em;
    }

    .serum-vertical-line {
      width: 60px;
      height: 2px;
      margin-top: 0;
      background: linear-gradient(to right, #c25b82 0%, #f7cad0 50%, transparent 100%);
    }

    .serum-images-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Çift Görselli Vitrin",
  "settings": [
    {
      "type": "header",
      "content": "📌 Yan Kayan Dikey Yazı (Sticky Text)"
    },
    {
      "type": "checkbox",
      "id": "show_side_text",
      "label": "Yanda Kayan Dikey Yazıyı Göster",
      "default": true
    },
    {
      "type": "text",
      "id": "side_text",
      "label": "Dikey Yazı Metni",
      "default": "CİLT BAKIMI"
    },
    {
      "type": "url",
      "id": "side_text_url",
      "label": "Dikey Yazı Yönlendirme Linki"
    },
    {
      "type": "header",
      "content": "🖼️ Konteyner Boyutları & Arka Plan"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maksimum Vitrin Genişliği (px)",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bölüm Arka Plan Rengi",
      "default": "#0b080c"
    },
    {
      "type": "color",
      "id": "orb_1_color",
      "label": "Üst Işık Küre Rengi",
      "default": "rgba(194, 91, 130, 0.2)"
    },
    {
      "type": "color",
      "id": "orb_2_color",
      "label": "Alt Işık Küre Rengi",
      "default": "rgba(247, 202, 208, 0.15)"
    },
    {
      "type": "header",
      "content": "📐 Bölüm Boşlukları (Section Spacing)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Üst İç Boşluk (Masaüstü)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Alt İç Boşluk (Masaüstü)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Üst İç Boşluk (Mobil)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Alt İç Boşluk (Mobil)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "🖼️ Görsel Bloğu",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "serum_image",
          "label": "Görsel Seçin"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Tıklanınca Gidilecek Koleksiyon / Sayfa Linki"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Görsel Üstü Rozet Metni",
          "default": "✦ SAF HYALÜRONİK SERUM"
        },
        {
          "type": "text",
          "id": "caption_title",
          "label": "Görsel Altı Başlık",
          "default": "Radiance Glow Serum"
        },
        {
          "type": "text",
          "id": "caption_subtitle",
          "label": "Görsel Altı Açıklama",
          "default": "Derinlemesine nem & ışıltı veren gençlik iksiri"
        },
        {
          "type": "color",
          "id": "frame_bg",
          "label": "Çerçeve Arka Plan Rengi",
          "default": "rgba(255, 255, 255, 0.04)"
        },
        {
          "type": "color",
          "id": "frame_border",
          "label": "Çerçeve Kenarlık Rengi",
          "default": "rgba(255, 255, 255, 0.15)"
        },
        {
          "type": "color",
          "id": "aura_glow_color",
          "label": "Işıltı Efekti (Aura Glow) Rengi",
          "default": "rgba(194, 91, 130, 0.25)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Çift Görselli Vitrin (Sticky Cilt Bakımı)",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "url": "/collections/cilt-bakimi",
            "badge_text": "✦ SAF HYALÜRONİK SERUM",
            "caption_title": "Radiance Glow Serum",
            "caption_subtitle": "Derinlemesine nem & ışıltı veren gençlik iksiri"
          }
        },
        {
          "type": "image",
          "settings": {
            "url": "/collections/cilt-bakimi",
            "badge_text": "✦ GECE BAKIM İKSİRİ",
            "caption_title": "Velvet Hydra Gece Kremi",
            "caption_subtitle": "Gece boyunca yenileyici ve elastikiyet artırıcı formül"
          }
        }
      ]
    }
  ]
}
{% endschema %}
