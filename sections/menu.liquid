<div id="MegaMenu" class="mega-menu" aria-hidden="true">
  <!-- Kozmetik Teması Arka Plan Efekti -->
  <div class="mega-menu__bg-glow"></div>

  <!-- Ana İçerik Alanı -->
  <div class="mega-menu__content">
    
    <!-- 1. Kolon: Ana Kategoriler -->
    <div class="mega-menu__main-cats">
      <ul class="mega-menu__main-list">
        {% assign is_first_cat = true %}
        {% for block in section.blocks %}
          {% if block.type == 'main_category' %}
            <li>
              <button class="mega-menu__main-btn {% if is_first_cat %}is-active{% endif %}" data-target="mega-menu-panel-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.title }}
              </button>
            </li>
            {% assign is_first_cat = false %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    <!-- 2, 3 ve 4. Kolonlar (Seçili kategoriye göre değişen alan) -->
    <div class="mega-menu__panels">
      {% assign is_first_panel = true %}
      {% for block in section.blocks %}
        {% if block.type == 'main_category' %}
          {% assign main_cat_id = block.id %}
          <div id="mega-menu-panel-{{ main_cat_id }}" class="mega-menu__panel {% if is_first_panel %}is-active{% endif %}">
            <div class="mega-menu__panel-inner">
              
              <!-- 2. ve 3. Kolon: Alt Kategoriler (Bölüm/Büyük Block) -->
              <div class="mega-menu__sub-cats">
                {% assign found_our_category = false %}
                {% for sub_block in section.blocks %}
                  {% if sub_block.type == 'main_category' %}
                    {% if sub_block.id == main_cat_id %}
                      {% assign found_our_category = true %}
                    {% else %}
                      {% assign found_our_category = false %}
                    {% endif %}
                  {% endif %}
                  
                  {% if found_our_category and sub_block.type == 'submenu_column' %}
                    <div class="mega-menu__sub-list-item" {{ sub_block.shopify_attributes }}>
                      {% if sub_block.settings.title != blank %}
                        <a href="{{ sub_block.settings.link | default: '#' }}" class="mega-menu__sub-link">{{ sub_block.settings.title }}</a>
                      {% endif %}
                      
                      {% assign menu = linklists[sub_block.settings.menu] %}
                      <ul class="mega-menu__child-list">
                        {% if menu != blank and menu.links.size > 0 %}
                          {% for link in menu.links %}
                            <li><a href="{{ link.url }}" class="mega-menu__child-link">{{ link.title }}</a></li>
                          {% endfor %}
                        {% else %}
                          <!-- Dynamic Fallback Placeholders based on submenu column title -->
                          {% assign sub_title = sub_block.settings.title | downcase %}
                          {% if sub_title contains 'yüz' %}
                            <li><a href="#" class="mega-menu__child-link">Fondöten</a></li>
                            <li><a href="#" class="mega-menu__child-link">Kapatıcı & Concealer</a></li>
                            <li><a href="#" class="mega-menu__child-link">Pudra & Sabitleyici</a></li>
                            <li><a href="#" class="mega-menu__child-link">Allık</a></li>
                            <li><a href="#" class="mega-menu__child-link">Bronzer & Aydınlatıcı</a></li>
                          {% elsif sub_title contains 'göz' %}
                            <li><a href="#" class="mega-menu__child-link">Maskara</a></li>
                            <li><a href="#" class="mega-menu__child-link">Göz Farı Paletleri</a></li>
                            <li><a href="#" class="mega-menu__child-link">Eyeliner & Kalem</a></li>
                            <li><a href="#" class="mega-menu__child-link">Kaş Ürünleri</a></li>
                          {% elsif sub_title contains 'dudak' %}
                            <li><a href="#" class="mega-menu__child-link">Ruj & Likit Ruj</a></li>
                            <li><a href="#" class="mega-menu__child-link">Dudak Parlatıcısı (Gloss)</a></li>
                            <li><a href="#" class="mega-menu__child-link">Dudak Kalemi</a></li>
                            <li><a href="#" class="mega-menu__child-link">Dudak Bakımı & Balm</a></li>
                          {% elsif sub_title contains 'aksesuar' or sub_title contains 'fırça' %}
                            <li><a href="#" class="mega-menu__child-link">Makyaj Fırçaları</a></li>
                            <li><a href="#" class="mega-menu__child-link">Makyaj Süngerleri</a></li>
                            <li><a href="#" class="mega-menu__child-link">Fırça Temizleyiciler</a></li>
                          {% elsif sub_title contains 'temizleme' or sub_title contains 'tonik' %}
                            <li><a href="#" class="mega-menu__child-link">Yüz Temizleme Jeli</a></li>
                            <li><a href="#" class="mega-menu__child-link">Makyaj Temizleyici</a></li>
                            <li><a href="#" class="mega-menu__child-link">Tonik & Mist</a></li>
                            <li><a href="#" class="mega-menu__child-link">Peeling & Arındırıcı</a></li>
                          {% elsif sub_title contains 'nemlendirici' or sub_title contains 'serum' %}
                            <li><a href="#" class="mega-menu__child-link">Gündüz Kremi</a></li>
                            <li><a href="#" class="mega-menu__child-link">Gece Kremi</a></li>
                            <li><a href="#" class="mega-menu__child-link">Yüz Serumu</a></li>
                            <li><a href="#" class="mega-menu__child-link">Göz Çevresi Bakımı</a></li>
                          {% elsif sub_title contains 'bakım' or sub_title contains 'özel' %}
                            <li><a href="#" class="mega-menu__child-link">Yüz Maskeleri</a></li>
                            <li><a href="#" class="mega-menu__child-link">Güneş Kremi (SPF)</a></li>
                            <li><a href="#" class="mega-menu__child-link">Leke Karşıtı Bakım</a></li>
                          {% elsif sub_title contains 'kadın' or sub_title contains 'kadin' %}
                            <li><a href="#" class="mega-menu__child-link">Eau de Parfum (EDP)</a></li>
                            <li><a href="#" class="mega-menu__child-link">Eau de Toilette (EDT)</a></li>
                            <li><a href="#" class="mega-menu__child-link">Çiçeksi & Meyvemsi</a></li>
                          {% elsif sub_title contains 'erkek' %}
                            <li><a href="#" class="mega-menu__child-link">Ferah & Su Notaları</a></li>
                            <li><a href="#" class="mega-menu__child-link">Odunsu & Baharatlı</a></li>
                          {% elsif sub_title contains 'vücut' or sub_title contains 'ev' %}
                            <li><a href="#" class="mega-menu__child-link">Vücut Spreyi</a></li>
                            <li><a href="#" class="mega-menu__child-link">Kokulu Mumlar</a></li>
                            <li><a href="#" class="mega-menu__child-link">Oda Kokusu</a></li>
                          {% else %}
                            <li><a href="#" class="mega-menu__child-link">Yeni Gelenler</a></li>
                            <li><a href="#" class="mega-menu__child-link">Çok Satanlar</a></li>
                            <li><a href="#" class="mega-menu__child-link">Hediye Setleri</a></li>
                          {% endif %}
                        {% endif %}
                      </ul>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

              <!-- 4. Kolon: Öne Çıkan Görseller (Bölüm/Büyük Block) -->
              <div class="mega-menu__featured">
                {% assign found_our_category = false %}
                {% for img_block in section.blocks %}
                  {% if img_block.type == 'main_category' %}
                    {% if img_block.id == main_cat_id %}
                      {% assign found_our_category = true %}
                    {% else %}
                      {% assign found_our_category = false %}
                    {% endif %}
                  {% endif %}
                  
                  {% if found_our_category and img_block.type == 'featured_image' %}
                    <div class="mega-menu__featured-item" {{ img_block.shopify_attributes }}>
                      <a href="{{ img_block.settings.link | default: '#' }}" class="mega-menu__featured-link">
                        <div class="mega-menu__featured-img-wrap">
                          {% if img_block.settings.image != blank %}
                            {{ img_block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'mega-menu__featured-img' }}
                          {% else %}
                            <div class="mega-menu__featured-placeholder">
                               {% assign placeholder_index = forloop.index | modulo: 4 | plus: 1 %}
                               {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'mega-menu__featured-img placeholder-svg' }}
                            </div>
                          {% endif %}
                        </div>
                        <span class="mega-menu__featured-title">{{ img_block.settings.title }}</span>
                      </a>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

            </div>
          </div>
          {% assign is_first_panel = false %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Kozmetik Temasına Uygun Mega Menu Stilleri */
.mega-menu {
  position: fixed;
  top: 82px; /* Header yüksekliği (Desktop) */
  left: 0;
  width: 100vw;
  height: calc(100vh - 82px);
  background: rgba(15, 11, 16, 0.96);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  color: #ffffff;
  z-index: 999; /* Header'ın (1000) bir tık altında */
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow-y: auto;
  font-family: 'Neue-Helvetica', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.mega-menu__bg-glow {
  position: absolute;
  top: -20%;
  right: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, rgba(194, 91, 130, 0.15) 0%, rgba(15, 11, 16, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
}

.mega-menu *, .mega-menu *::before, .mega-menu *::after {
  box-sizing: inherit;
}

.mega-menu.is-open {
  opacity: 1;
  visibility: visible;
}

/* Header'daki Hamburgere Ait Çizgileri X Yapma Efekti */
.menu-toggle-btn svg line {
  transition: transform 0.3s ease, opacity 0.3s ease;
  transform-origin: 50% 50%;
}
.menu-toggle-btn.is-active svg line:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}
.menu-toggle-btn.is-active svg line:nth-child(2) {
  opacity: 0;
}
.menu-toggle-btn.is-active svg line:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* Main Content Grid */
.mega-menu__content {
  display: flex;
  flex: 1;
  padding: 40px;
  height: 100%;
}

/* 1. Kolon: Ana Kategoriler */
.mega-menu__main-cats {
  width: 350px;
  flex-shrink: 0;
  padding-right: 40px;
  overflow-y: auto;
  -ms-overflow-style: none;
  scrollbar-width: none;
  border-right: 1px solid rgba(255, 255, 255, 0.05);
}
.mega-menu__main-cats::-webkit-scrollbar {
  display: none;
}

.mega-menu__main-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 25px;
}

.mega-menu__main-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 64px;
  font-family: 'Didot', 'Bodoni MT', 'Times New Roman', Times, serif;
  color: rgba(255, 255, 255, 0.2);
  text-align: left;
  padding: 0;
  line-height: 1;
  transition: color 0.4s ease, transform 0.4s ease;
  width: 100%;
  position: relative;
}

.mega-menu__main-btn.is-active,
.mega-menu__main-btn:hover {
  color: #ffffff;
  transform: translateX(10px);
}

.mega-menu__main-btn.is-active::before {
  content: '';
  position: absolute;
  left: -20px;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 40%;
  background: linear-gradient(to bottom, #c25b82, #a24367);
  border-radius: 4px;
}

/* Sağ Taraf Panelleri */
.mega-menu__panels {
  flex: 1;
  position: relative;
  overflow-y: auto;
  overflow-x: hidden;
}

.mega-menu__panel {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
  pointer-events: none;
}

.mega-menu__panel.is-active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  position: relative;
  animation: fadeSlideIn 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateX(20px); }
  to { opacity: 1; transform: translateX(0); }
}

.mega-menu__panel-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
}

/* 2. ve 3. Kolon: Alt Kategoriler */
.mega-menu__sub-cats {
  column-count: 2;
  column-gap: 40px;
}

.mega-menu__sub-list-item {
  margin-bottom: 35px;
  break-inside: avoid;
}

.mega-menu__sub-link {
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  color: #f7cad0; /* Altın/Pembe Vurgu */
  text-transform: uppercase;
  display: block;
  margin-bottom: 15px;
  letter-spacing: 1px;
}

.mega-menu__child-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mega-menu__child-link {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: color 0.3s ease, padding-left 0.3s ease;
}

.mega-menu__child-link:hover {
  color: #ffffff;
  padding-left: 5px;
}

/* 4. Kolon: Öne Çıkan Görseller */
.mega-menu__featured {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.mega-menu__featured-item {
  width: 100%;
}

.mega-menu__featured-link {
  text-decoration: none;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mega-menu__featured-img-wrap {
  width: 100%;
  aspect-ratio: 3/4;
  overflow: hidden;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.mega-menu__featured-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.03);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mega-menu__featured-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.mega-menu__featured-img.placeholder-svg {
  filter: invert(0.8) sepia(0.2) hue-rotate(300deg) brightness(0.9);
  padding: 20px;
}

.mega-menu__featured-link:hover .mega-menu__featured-img {
  transform: scale(1.05);
}

.mega-menu__featured-title {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  transition: color 0.3s ease;
}

.mega-menu__featured-link:hover .mega-menu__featured-title {
  color: #f7cad0;
}

/* Responsive Düzenlemeler */
@media (max-width: 1200px) {
  .mega-menu__main-btn {
    font-size: 48px;
  }
  .mega-menu__main-cats {
    width: 250px;
  }
  .mega-menu__panel-inner {
    grid-template-columns: 1fr;
  }
  .mega-menu__featured {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (max-width: 990px) {
  .mega-menu {
    top: 70px; /* Mobil Header Yüksekliği */
    height: calc(100vh - 70px);
  }
  .mega-menu__content {
    flex-direction: column;
    padding: 20px;
  }
  .mega-menu__main-cats {
    width: 100%;
    padding-right: 0;
    margin-bottom: 30px;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .mega-menu__main-list {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: 20px;
  }
  .mega-menu__main-btn {
    font-size: 32px;
    white-space: nowrap;
  }
  .mega-menu__main-btn.is-active::before {
    top: auto;
    bottom: -10px;
    left: 0;
    width: 100%;
    height: 3px;
    transform: none;
  }
  .mega-menu__featured {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const megaMenu = document.getElementById('MegaMenu');
  if (!megaMenu) return;

  const toggleBtns = document.querySelectorAll('.menu-toggle-btn');
  const mainCats = megaMenu.querySelectorAll('.mega-menu__main-btn');
  const panels = megaMenu.querySelectorAll('.mega-menu__panel');

  const openMenu = () => {
    megaMenu.classList.add('is-open');
    megaMenu.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden'; 
    toggleBtns.forEach(btn => btn.classList.add('is-active'));
  };

  const closeMenu = () => {
    megaMenu.classList.remove('is-open');
    megaMenu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = ''; 
    toggleBtns.forEach(btn => btn.classList.remove('is-active'));
  };

  const toggleMenu = (e) => {
    if(e) e.preventDefault();
    const isOpen = megaMenu.classList.contains('is-open');
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  };

  toggleBtns.forEach(btn => btn.addEventListener('click', toggleMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && megaMenu.classList.contains('is-open')) {
      closeMenu();
    }
  });

  mainCats.forEach(btn => {
    btn.addEventListener('mouseenter', () => activatePanel(btn));
    btn.addEventListener('click', () => activatePanel(btn));
  });

  function activatePanel(activeBtn) {
    mainCats.forEach(b => b.classList.remove('is-active'));
    panels.forEach(p => p.classList.remove('is-active'));

    activeBtn.classList.add('is-active');
    
    const targetId = activeBtn.getAttribute('data-target');
    const targetPanel = document.getElementById(targetId);
    if (targetPanel) {
      targetPanel.classList.add('is-active');
    }
  }
});
</script>

