{% comment %}
  Zoom Scroll Hero Section ('zoom-scroll-hero.liquid')
  - Smooth scale-down (zoom-out) effect on scroll
  - Image shrinks smoothly from 100% full-screen to rounded card while scrolling
  - Content overlays fade gracefully and section below slides naturally over it
{% endcomment %}

<div
  class="zoom-scroll-hero full-width"
  data-min-scale="{{ section.settings.min_scale | default: 78 | divided_by: 100.0 }}"
  data-max-radius="{{ section.settings.max_border_radius | default: 36 }}"
  style="
    --zsh-scroll-height: {{ section.settings.scroll_height | default: 200 }}vh;
    --zsh-bg: {{ section.settings.bg_color | default: '#0b080c' }};
    --zsh-text: {{ section.settings.text_color | default: '#ffffff' }};
    --zsh-card-bg: {{ section.settings.card_bg | default: 'rgba(15, 11, 16, 0.55)' }};
  ">

  <div class="zsh-pin-container">
    <div class="zsh-sticky-frame">

      <!-- Media Wrapper (Scales down on scroll) -->
      <div class="zsh-media-wrap">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
            {%- endif -%}
            {{ section.settings.image | image_url: width: 2200 | image_tag: class: 'zsh-img', loading: 'eager', alt: section.settings.heading }}
          </picture>
        {%- else -%}
          <img
            src="{{ 'hero-banner.jpg' | asset_url }}"
            alt="{{ section.settings.heading | default: 'Zoom Hero' }}"
            class="zsh-img"
            width="1920"
            height="1080"
            loading="eager">
        {%- endif -%}

        <div class="zsh-overlay"></div>
      </div>

      <!-- Content Overlay Card -->
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="zsh-content-wrapper">
          <div class="zsh-content-card">

            {%- if section.settings.subheading != blank -%}
              <div class="zsh-badge">
                <span>{{ section.settings.subheading }}</span>
              </div>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="zsh-title">
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <p class="zsh-desc">
                {{ section.settings.description }}
              </p>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
              <div class="zsh-btn-wrap">
                <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="zsh-btn">
                  <span>{{ section.settings.button_label }}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            {%- endif -%}

            <!-- Feature Pills / Blocks -->
            {%- if section.blocks.size > 0 -%}
              <div class="zsh-features">
                {%- for block in section.blocks -%}
                  <div class="zsh-feature-pill" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon_text != blank -%}
                      <span class="zsh-feature-icon">{{ block.settings.icon_text }}</span>
                    {%- endif -%}
                    <span class="zsh-feature-label">{{ block.settings.title }}</span>
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

          </div>
        </div>
      {%- endif -%}

    </div>
  </div>

</div>

{% stylesheet %}
  .zoom-scroll-hero {
    position: relative;
    width: 100%;
    background-color: var(--zsh-bg);
    color: var(--zsh-text);
  }

  /* ── Pinning outer container height ── */
  .zsh-pin-container {
    position: relative;
    width: 100%;
    height: var(--zsh-scroll-height, 200vh);
  }

  /* ── Sticky Frame viewport ── */
  .zsh-sticky-frame {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Media Wrapper (shrinks on scroll) ── */
  .zsh-media-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    will-change: transform, border-radius;
    transition: transform 0.1s linear, border-radius 0.1s linear, box-shadow 0.3s ease;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }

  .zsh-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .zsh-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(11, 8, 12, 0.25) 0%, rgba(11, 8, 12, 0.75) 100%);
    pointer-events: none;
  }

  /* ── Content Card Overlay ── */
  .zsh-content-wrapper {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1200px;
    padding: 0 24px;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .zsh-content-card {
    pointer-events: auto;
    max-width: 660px;
    width: 100%;
    background: var(--zsh-card-bg);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 28px;
    padding: 44px 40px;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    will-change: transform, opacity;
    transition: opacity 0.2s linear, transform 0.2s linear;
  }

  .zsh-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 18px;
    border-radius: 30px;
    background: rgba(194, 91, 130, 0.2);
    border: 1px solid rgba(194, 91, 130, 0.4);
    color: #f7cad0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .zsh-title {
    margin: 0 0 16px 0;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .zsh-desc {
    margin: 0 0 28px 0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .zsh-btn-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  .zsh-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    color: #0b080c;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 40px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .zsh-btn:hover {
    background: #f7cad0;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(247, 202, 208, 0.35);
  }

  .zsh-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .zsh-feature-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Responsive Mobile Adjustments */
  @media (max-width: 768px) {
    .zsh-content-card {
      padding: 28px 20px;
      border-radius: 20px;
    }
    .zsh-desc {
      font-size: 13.5px;
    }
    .zsh-btn {
      padding: 13px 28px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
(function() {
  function initZoomScrollHero() {
    var sections = document.querySelectorAll('.zoom-scroll-hero');
    if (!sections.length) return;

    sections.forEach(function(sec) {
      var pin = sec.querySelector('.zsh-pin-container');
      var media = sec.querySelector('.zsh-media-wrap');
      var card = sec.querySelector('.zsh-content-card');
      if (!pin || !media) return;

      var minScale = parseFloat(sec.dataset.minScale || '0.78');
      var maxRadius = parseInt(sec.dataset.maxRadius || '36', 10);

      var ticking = false;

      function updateZoom() {
        var rect = pin.getBoundingClientRect();
        var totalScroll = pin.offsetHeight - window.innerHeight;
        if (totalScroll <= 0) {
          ticking = false;
          return;
        }

        // Progress goes from 0 (section top at viewport top) to 1 (scrolled through pin height)
        var progress = -rect.top / totalScroll;
        progress = Math.max(0, Math.min(1, progress));

        var scale = 1 - (progress * (1 - minScale));
        var radius = progress * maxRadius;
        var opacity = 1 - (progress * 1.3);
        opacity = Math.max(0, opacity);

        media.style.transform = 'scale(' + scale + ')';
        media.style.borderRadius = radius + 'px';

        if (card) {
          card.style.opacity = opacity;
          card.style.transform = 'translateY(' + (-progress * 50) + 'px)';
        }

        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          requestAnimationFrame(updateZoom);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      updateZoom();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZoomScrollHero);
  } else {
    initZoomScrollHero();
  }
})();
{% endjavascript %}

