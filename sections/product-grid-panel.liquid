{% comment %}
  Ultra-Luxury High-Fashion Showcase Product Grid Panel
{% endcomment %}

<div class="product-grid-panel full-width">
  <!-- Glowing Background Orbs -->
  <div class="grid-orb orb-g1"></div>
  <div class="grid-orb orb-g2"></div>

  <div class="product-grid-panel__container">
    
    <!-- Section Header -->
    <div class="product-grid-panel__header">
      <div class="header-title-group">
        {% if section.settings.subheading != blank %}
          <span class="luxury-subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="luxury-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="haute-view-all-btn">
          <span>{{ section.settings.button_text }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>

    <!-- Product Cards Grid -->
    <div class="product-grid-panel__grid">
      {% assign selected_collection = section.settings.collection %}
      
      {% if selected_collection != blank and selected_collection.products.size > 0 %}
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          <div class="haute-product-card">
            <div class="card-image-wrapper">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 450 | image_tag: class: 'card-img', loading: 'lazy' }}
                {% else %}
                  <img src="{{ 'luxury-serum.jpg' | asset_url }}" class="card-img" alt="{{ product.title }}" width="400" height="400" loading="lazy">
                {% endif %}
              </a>
              <span class="card-badge badge-bestseller">✦ SEÇKİN</span>
              <button type="button" class="wishlist-heart-btn" aria-label="Favorilere Ekle" title="Favorilere Ekle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
              <button type="button" class="quick-add-glass-btn demo-quick-add">
                <span>+ Sepete Hızlı Ekle</span>
              </button>
            </div>
            <div class="card-info">
              <div class="card-rating">★★★★★ <span>(5.0)</span></div>
              <h3 class="card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="card-desc">{{ product.description | strip_html | truncate: 60 }}</p>
              <div class="card-price-row">
                <span class="price-current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="price-old">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% elsif section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="haute-product-card" {{ block.shopify_attributes }}>
            <div class="card-image-wrapper">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 450 | image_tag: class: 'card-img', loading: 'lazy' }}
              {% else %}
                <img src="{{ 'luxury-serum.jpg' | asset_url }}" class="card-img" alt="{{ block.settings.title }}" width="400" height="400" loading="lazy">
              {% endif %}

              {% if block.settings.badge_text != blank %}
                <span class="card-badge badge-bestseller">{{ block.settings.badge_text }}</span>
              {% endif %}

              <button type="button" class="wishlist-heart-btn" aria-label="Favorilere Ekle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
              <button type="button" class="quick-add-glass-btn demo-quick-add">
                <span>+ Sepete Hızlı Ekle</span>
              </button>
            </div>
            <div class="card-info">
              <div class="card-rating">★★★★★ <span>(4.9)</span></div>
              <h3 class="card-title"><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></h3>
              <p class="card-desc">{{ block.settings.description }}</p>
              <div class="card-price-row">
                <span class="price-current">{{ block.settings.price }}</span>
                {% if block.settings.compare_price != blank %}
                  <span class="price-old">{{ block.settings.compare_price }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% comment %} Default demo cards for preview {% endcomment %}
        {% assign demo_titles = "Lumière Radiance Serum 30ml,Velvet Hydra Besleyici Gece Kremi,Isparta Gül Suyu Arındırıcı Tonik,Anti-Aging Peptit Göz Çevresi Kremi" | split: "," %}
        {% assign demo_descs = "Cilt bariyerini yenileyici ve nemlendirici gençlik iksiri,Gece boyunca yoğun elastikiyet ve nem bakımı,Gözenek sıkılaştırıcı %100 doğal gül suyu,Göz altı morlukları ve şişlik karşıtı peptit kompleks" | split: "," %}
        {% assign demo_prices = "₺450,00,₺520,00,₺280,00,₺390,00" | split: "," %}
        {% assign demo_olds = "₺650,00,₺700,00,₺350,00,₺500,00" | split: "," %}
        {% assign demo_badges = "EN ÇOK SATAN,YENİ,ORGANİK,%20 İNDİRİM" | split: "," %}

        {% for i in (1..4) %}
          {% assign idx = forloop.index0 %}
          <div class="haute-product-card">
            <div class="card-image-wrapper">
              {% if forloop.index % 2 == 0 %}
                <img src="{{ 'luxury-cream.jpg' | asset_url }}" class="card-img" alt="Demo Ürün" width="400" height="400" loading="lazy">
              {% else %}
                <img src="{{ 'luxury-serum.jpg' | asset_url }}" class="card-img" alt="Demo Ürün" width="400" height="400" loading="lazy">
              {% endif %}
              <span class="card-badge badge-bestseller">{{ demo_badges[idx] }}</span>
              <button type="button" class="wishlist-heart-btn" aria-label="Favorilere Ekle">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              </button>
              <button type="button" class="quick-add-glass-btn demo-quick-add">
                <span>+ Sepete Hızlı Ekle</span>
              </button>
            </div>
            <div class="card-info">
              <div class="card-rating">★★★★★ <span>(4.9)</span></div>
              <h3 class="card-title"><a href="#">{{ demo_titles[idx] }}</a></h3>
              <p class="card-desc">{{ demo_descs[idx] }}</p>
              <div class="card-price-row">
                <span class="price-current">{{ demo_prices[idx] }}</span>
                <span class="price-old">{{ demo_olds[idx] }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</div>

{% stylesheet %}
  .product-grid-panel {
    position: relative;
    background: linear-gradient(135deg, #0d090e 0%, #160f18 50%, #0a070b 100%);
    padding: 90px 24px;
    margin: 0;
    overflow: hidden;
    color: #ffffff;
  }

  .grid-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 1;
  }

  .orb-g1 {
    width: 450px;
    height: 450px;
    background: rgba(194, 91, 130, 0.18);
    top: -50px;
    right: -100px;
  }

  .orb-g2 {
    width: 500px;
    height: 500px;
    background: rgba(247, 202, 208, 0.15);
    bottom: -100px;
    left: -100px;
  }

  .product-grid-panel__container {
    position: relative;
    z-index: 2;
    max-width: 1300px;
    margin: 0 auto;
  }

  .product-grid-panel__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
  }

  .luxury-subheading {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #f7cad0;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .luxury-heading {
    font-size: 2.2rem;
    font-weight: 800;
    margin: 0;
    background: linear-gradient(135deg, #ffffff 0%, #ffdfeb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .haute-view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    font-size: 0.92rem;
    padding: 10px 20px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    transition: all 0.25s ease;
  }

  .haute-view-all-btn:hover {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(194, 91, 130, 0.35);
  }

  .product-grid-panel__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 22px;
  }

  .haute-product-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .haute-product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 28px 60px rgba(194, 91, 130, 0.25);
    border-color: rgba(194, 91, 130, 0.5);
    background: rgba(255, 255, 255, 0.08);
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .haute-product-card:hover .card-img {
    transform: scale(1.08);
  }

  .card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.08em;
    color: #ffffff;
    z-index: 2;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    background: linear-gradient(135deg, #c25b82, #993b60);
  }

  .wishlist-heart-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #ffffff;
    transition: all 0.25s ease;
    z-index: 2;
  }

  .wishlist-heart-btn:hover {
    background: #ffffff;
    color: #e63946;
    transform: scale(1.1);
  }

  .quick-add-glass-btn {
    position: absolute;
    bottom: -40px;
    left: 10px;
    right: 10px;
    background: rgba(15, 11, 16, 0.85);
    backdrop-filter: blur(12px);
    color: #ffffff;
    border: 1.5px solid rgba(247, 202, 208, 0.4);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 9px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 3;
  }

  .haute-product-card:hover .quick-add-glass-btn {
    bottom: 10px;
  }

  .quick-add-glass-btn:hover {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    border-color: transparent;
  }

  .card-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-rating {
    font-size: 0.8rem;
    color: #f7cad0;
    letter-spacing: 1px;
  }

  .card-rating span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.78rem;
  }

  .card-title {
    font-size: 0.92rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.3;
  }

  .card-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-title a:hover {
    color: #f7cad0;
  }

  .card-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
    line-height: 1.4;
  }

  .card-price-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
  }

  .price-current {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
  }

  .price-old {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: line-through;
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const wishlistBtns = document.querySelectorAll('.wishlist-heart-btn');
    wishlistBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('active');
        const svg = btn.querySelector('svg');
        if (btn.classList.contains('active')) {
          svg.setAttribute('fill', '#e63946');
          svg.setAttribute('stroke', '#e63946');
        } else {
          svg.setAttribute('fill', 'none');
          svg.setAttribute('stroke', 'currentColor');
        }
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Vitrin Ürün Kartları",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Koleksiyon Seçin"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Üst Başlık Rozeti",
      "default": "✦ SEÇKİN BAKIM KOLEKSİYONU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Ana Başlık",
      "default": "Çok Satan Kozmetik Ürünlerimiz"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Buton Metni",
      "default": "Tüm Koleksiyonu Keşfet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Buton Bağlantısı"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Gösterilecek Ürün Sayısı",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Özel Ürün Kartı",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ürün Görseli"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Rozet Metni",
          "default": "EN ÇOK SATAN"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ürün Adı",
          "default": "Lumière Radiance Serum 30ml"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Kısa Açıklama",
          "default": "Cilt bariyerini yenileyici ve nemlendirici gençlik iksiri"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Fiyat",
          "default": "₺450,00"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Eski Fiyat",
          "default": "₺650,00"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Ürün Bağlantısı"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrin Ürün Kartları",
      "category": "Ürün"
    }
  ]
}
{% endschema %}
