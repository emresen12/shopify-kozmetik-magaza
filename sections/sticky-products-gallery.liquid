{% comment %}
  Sticky Products Gallery Section ('sticky-products-gallery.liquid')
  - Dynamic block-based section supporting 2, 3, or more image columns
  - Sticky overlay text scrolling with the section
{% endcomment %}

{%- assign image_blocks = section.blocks | where: 'type', 'image' -%}
{%- assign caption_blocks = section.blocks | where: 'type', 'image_caption' -%}
{%- assign sticky_blocks = section.blocks | where: 'type', 'sticky_text' -%}
{%- assign sticky_block = sticky_blocks.first -%}
{%- assign cols_count = image_blocks.size | default: 2 -%}

<div class="spg-section full-width"
  style="
    --spg-bg: {{ section.settings.bg_color | default: '#0b080c' }};
    --spg-text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --spg-caption-bg: {{ section.settings.caption_bg | default: 'rgba(10,7,12,0.72)' }};
    --spg-padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --spg-padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  ">

  <div class="spg-outer">

    <!-- ── Image columns ──────────────────────────────────── -->
    <div class="spg-images-grid" style="grid-template-columns: repeat({{ cols_count }}, 1fr);">
      {%- for img_block in image_blocks -%}
        {%- assign current_target = forloop.index | append: '' -%}
        {%- assign cap_block = null -%}
        {%- for cb in caption_blocks -%}
          {%- if cb.settings.image_target == current_target -%}
            {%- assign cap_block = cb -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="spg-img-cell-wrapper">
          <a
            href="{{ img_block.settings.url | default: routes.all_products_collection_url }}"
            class="spg-img-cell"
            {{ img_block.shopify_attributes }}>

            {%- if img_block.settings.image != blank -%}
              {{ img_block.settings.image | image_url: width: 1400 | image_tag:
                  class: 'spg-img',
                  loading: 'lazy',
                  alt: cap_block.settings.caption_title }}
            {%- else -%}
              <img
                src="{{ 'zmm-hero.jpg' | asset_url }}"
                alt="Ürün {{ forloop.index }}"
                class="spg-img"
                width="800" height="1000"
                loading="lazy">
            {%- endif -%}

            {%- if img_block.settings.badge != blank -%}
              <div class="spg-badge"
                style="
                  background: {{ img_block.settings.badge_bg | default: '#c25b82' }};
                  color: {{ img_block.settings.badge_text_color | default: '#ffffff' }};
                ">
                {{ img_block.settings.badge }}
              </div>
            {%- endif -%}
          </a>

          {%- if cap_block != blank -%}
            <div class="spg-caption" {{ cap_block.shopify_attributes }}>
              <h3 style="color: {{ cap_block.settings.caption_title_color | default: '#ffffff' }};">
                {{ cap_block.settings.caption_title }}
              </h3>
              {%- if cap_block.settings.caption_subtitle != blank -%}
                <p style="color: {{ cap_block.settings.caption_subtitle_color | default: 'rgba(255,255,255,0.75)' }};">
                  {{ cap_block.settings.caption_subtitle }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- ── Sticky overlay text block ───────────────────── -->
    {%- if sticky_block != blank -%}
      <div class="spg-sticky-text-wrap" {{ sticky_block.shopify_attributes }}
        style="
          justify-content: {{ sticky_block.settings.overlay_position | default: 'flex-end' }};
          padding-right: {{ sticky_block.settings.overlay_offset | default: 40 }}px;
          padding-left: {{ sticky_block.settings.overlay_offset | default: 40 }}px;
        ">
        <a
          href="{{ sticky_block.settings.overlay_url | default: routes.all_products_collection_url }}"
          class="spg-sticky-link">
          <span
            class="spg-heading"
            style="
              font-size: {{ sticky_block.settings.overlay_font_size | default: 56 }}px;
              color: {{ sticky_block.settings.overlay_text_color | default: '#ffffff' }};
              letter-spacing: {{ sticky_block.settings.overlay_letter_spacing | default: 6 }}px;
            ">
            {{ sticky_block.settings.overlay_text | default: 'ÜRÜNLER' }}
          </span>
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .spg-section {
    position: relative;
    width: 100%;
    margin: 0;
    padding-top: var(--spg-padding-top);
    padding-bottom: var(--spg-padding-bottom);
    background-color: var(--spg-bg);
    color: var(--spg-text-color);
  }

  /* CSS Grid Overlap: images + sticky text share same cell */
  .spg-outer {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    width: 100%;
  }

  .spg-images-grid,
  .spg-sticky-text-wrap {
    grid-column: 1;
    grid-row: 1;
  }

  /* ── Images ── */
  .spg-images-grid {
    display: grid;
    gap: 0;
    z-index: 1;
    width: 100%;
  }

  .spg-img-cell-wrapper {
    position: relative;
    width: 100%;
  }

  .spg-img-cell {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #0b080c;
    min-height: 320px;
  }

  .spg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
    padding: 0;
    border: none;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .spg-img-cell:hover .spg-img {
    transform: scale(1.04);
  }

  /* Badge */
  .spg-badge {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 3;
    padding: 7px 16px;
    border-radius: 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(0,0,0,0.35);
    border: 1px solid rgba(255,255,255,0.2);
  }

  /* Caption */
  .spg-caption {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    z-index: 3;
    background: var(--spg-caption-bg);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 16px 20px;
    pointer-events: none;
  }
  .spg-caption h3 {
    margin: 0 0 4px 0;
    font-family: 'Georgia', serif;
    font-size: 18px;
    font-weight: 400;
  }
  .spg-caption p {
    margin: 0;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
  }

  /* ── Sticky Overlay Text ── */
  .spg-sticky-text-wrap {
    align-self: start;
    position: sticky;
    top: 50vh;
    transform: translateY(-50%);
    z-index: 20;
    pointer-events: none;
    width: 100%;
    display: flex;
    box-sizing: border-box;
  }

  .spg-sticky-link {
    pointer-events: auto;
    text-decoration: none;
  }

  .spg-heading {
    display: block;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 2px 20px rgba(0,0,0,0.7);
    transition: opacity 0.3s ease;
  }
  .spg-sticky-link:hover .spg-heading {
    opacity: 0.7;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .spg-images-grid {
      grid-template-columns: 1fr !important;
    }
    .spg-sticky-text-wrap {
      justify-content: center !important;
      padding-right: 0 !important;
      padding-left: 0 !important;
    }
    .spg-heading {
      font-size: clamp(1.8rem, 6vw, 2.8rem) !important;
    }
  }
{% endstylesheet %}

