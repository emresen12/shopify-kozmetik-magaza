{% comment %}
  Modular Collection Hero Banner Section with Block-Level Click Inspector Support
  Clicking on Badge, Title, or Description in Theme Editor directly selects its block settings.
{% endcomment %}

<div class="collection-hero-banner-section full-width" style="
  --hero-bg: {{ section.settings.bg_color }};
  --orb-1-color: {{ section.settings.orb_1_color }};
  --orb-2-color: {{ section.settings.orb_2_color }};
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="hero-orb orb-1"></div>
  <div class="hero-orb orb-2"></div>

  <div class="collection-hero-content" style="text-align: {{ section.settings.text_align }};">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'badge' %}
          <div class="collection-badge-wrapper" style="margin-bottom: {{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
            <span class="collection-badge" style="
              font-size: {{ block.settings.font_size }}px;
              font-weight: {{ block.settings.font_weight }};
              letter-spacing: {{ block.settings.letter_spacing }}px;
              color: {{ block.settings.text_color }};
              background: {{ block.settings.bg_color }};
              border: 1px solid {{ block.settings.border_color }};
              border-radius: {{ block.settings.border_radius }}px;
              padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
            ">
              {{ block.settings.text }}
            </span>
          </div>

        {% when 'title' %}
          {% assign title_tag = block.settings.heading_tag | default: 'h1' %}
          <div class="collection-title-wrapper" {{ block.shopify_attributes }}>
            <{{ title_tag }} class="collection-main-title" style="
              font-size: {{ block.settings.font_size_desktop }}px;
              --title-size-mob: {{ block.settings.font_size_mobile }}px;
              font-weight: {{ block.settings.font_weight }};
              line-height: {{ block.settings.line_height }};
              letter-spacing: {{ block.settings.letter_spacing }}px;
              text-transform: {{ block.settings.text_transform }};
              margin-bottom: {{ block.settings.margin_bottom }}px;
              padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
              {% if block.settings.use_gradient %}
                background: linear-gradient(135deg, {{ block.settings.color_start }} 0%, {{ block.settings.color_end }} 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
              {% else %}
                color: {{ block.settings.color_start }};
              {% endif %}
            ">
              {% if block.settings.custom_title != blank %}
                {{ block.settings.custom_title }}
              {% else %}
                {{ collection.title | default: "Tüm Ürünlerimiz" }}
              {% endif %}
            </{{ title_tag }}>
          </div>

        {% when 'description' %}
          <div class="collection-desc-wrapper" {{ block.shopify_attributes }}>
            <p class="collection-main-desc" style="
              font-size: {{ block.settings.font_size }}px;
              --desc-size-mob: {{ block.settings.font_size_mobile }}px;
              font-weight: {{ block.settings.font_weight }};
              line-height: {{ block.settings.line_height }};
              color: {{ block.settings.text_color }};
              max-width: {{ block.settings.max_width }}px;
              margin-bottom: {{ block.settings.margin_bottom }}px;
              padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
              {% if section.settings.text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
            ">
              {% if block.settings.custom_description != blank %}
                {{ block.settings.custom_description }}
              {% else %}
                {{ collection.description | default: "Doğanın en saf ve etkili içerikleriyle formüle edilmiş, cildinize anında ışıltı ve canlılık veren ürünlerimizi keşfedin." }}
              {% endif %}
            </p>
          </div>

      {% endcase %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .collection-hero-banner-section {
    position: relative;
    padding-top: var(--padding-top, 120px);
    padding-bottom: var(--padding-bottom, 50px);
    padding-left: 24px;
    padding-right: 24px;
    background: var(--hero-bg, #0b080c);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .collection-hero-banner-section .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .collection-hero-banner-section .hero-orb.orb-1 {
    width: 420px;
    height: 420px;
    background: var(--orb-1-color, rgba(194, 91, 130, 0.2));
    top: -50px;
    left: 18%;
  }

  .collection-hero-banner-section .hero-orb.orb-2 {
    width: 380px;
    height: 380px;
    background: var(--orb-2-color, rgba(247, 202, 208, 0.15));
    bottom: -50px;
    right: 18%;
  }

  .collection-hero-content {
    position: relative;
    z-index: 2;
    max-width: 780px;
    margin: 0 auto;
  }

  .collection-badge-wrapper {
    display: inline-block;
  }

  .collection-badge {
    display: inline-block;
    backdrop-filter: blur(12px);
  }

  .collection-main-title {
    margin: 0;
  }

  .collection-main-desc {
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .collection-main-title {
      font-size: var(--title-size-mob, 28px) !important;
    }
    .collection-main-desc {
      font-size: var(--desc-size-mob, 14px) !important;
    }
  }
{% endstylesheet %}

