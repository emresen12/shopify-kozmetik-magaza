{% comment %}
  Kozmetik Hero Banner Section with Full Visual Click Inspector Support
  Each element (Badge, Title, Subtitle, Button, Stats) is an interactive section block.
  Clicking on any element in Shopify Theme Editor directly selects that element's block settings in the panel!
{% endcomment %}

<div class="hero-banner-section full-width" style="
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
  --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
  --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  --card-bg-color: {{ section.settings.card_bg_color }};
  --card-border-color: {{ section.settings.card_border_color }};
  --card-border-radius: {{ section.settings.card_border_radius }}px;
  --card-blur: {{ section.settings.card_blur }}px;
  --card-padding: {{ section.settings.card_padding }}px;
  --min-height: {{ section.settings.min_height }}vh;
  --overlay-opacity: {{ section.settings.overlay_opacity }};
">
  <div class="hero-banner__image-container">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-banner__img', loading: 'eager' }}
    {% else %}
      <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="Kozmetik Hero Banner" class="hero-banner__img" width="1920" height="1080" loading="eager">
    {% endif %}
    <div class="hero-banner__overlay"></div>
  </div>

  <div class="hero-banner__content-wrapper">
    <div class="hero-banner__card" style="text-align: {{ section.settings.card_alignment }};">
      
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'badge' %}
            <div class="hero-block-badge-wrapper" style="
              margin-bottom: {{ block.settings.margin_bottom }}px;
            " {{ block.shopify_attributes }}>
              <span class="hero-block-badge" style="
                font-size: {{ block.settings.font_size }}px;
                font-weight: {{ block.settings.font_weight }};
                letter-spacing: {{ block.settings.letter_spacing }}px;
                color: {{ block.settings.text_color }};
                background: {{ block.settings.bg_color }};
                border: 1px solid {{ block.settings.border_color }};
                border-radius: {{ block.settings.border_radius }}px;
                padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
              ">
                {{ block.settings.text }}
              </span>
            </div>

          {% when 'title' %}
            {% assign title_tag = block.settings.heading_tag | default: 'h1' %}
            <div class="hero-block-title-wrapper" {{ block.shopify_attributes }}>
              <{{ title_tag }} class="hero-block-title" style="
                font-size: {{ block.settings.font_size_desktop }}px;
                --title-size-mob: {{ block.settings.font_size_mobile }}px;
                font-weight: {{ block.settings.font_weight }};
                line-height: {{ block.settings.line_height }};
                letter-spacing: {{ block.settings.letter_spacing }}px;
                text-transform: {{ block.settings.text_transform }};
                text-align: {{ block.settings.text_align }};
                padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
                margin-bottom: {{ block.settings.margin_bottom }}px;
                {% if block.settings.use_gradient %}
                  background: linear-gradient(135deg, {{ block.settings.color_start }} 0%, {{ block.settings.color_end }} 100%);
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                {% else %}
                  color: {{ block.settings.color_start }};
                {% endif %}
              ">
                {{ block.settings.text }}
              </{{ title_tag }}>
            </div>

          {% when 'subtitle' %}
            <div class="hero-block-subtitle-wrapper" style="
              text-align: {{ block.settings.text_align }};
            " {{ block.shopify_attributes }}>
              <p class="hero-block-subtitle" style="
                font-size: {{ block.settings.font_size }}px;
                --sub-size-mob: {{ block.settings.font_size_mobile }}px;
                font-weight: {{ block.settings.font_weight }};
                line-height: {{ block.settings.line_height }};
                color: {{ block.settings.text_color }};
                max-width: {{ block.settings.max_width }}px;
                padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
                margin-bottom: {{ block.settings.margin_bottom }}px;
                {% if block.settings.text_align == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
              ">
                {{ block.settings.text }}
              </p>
            </div>

          {% when 'button' %}
            <div class="hero-block-button-wrapper" style="
              margin-bottom: {{ block.settings.margin_bottom }}px;
            " {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: routes.all_products_collection_url }}" class="hero-block-btn {{ block.settings.button_style }}" style="
                font-size: {{ block.settings.font_size }}px;
                font-weight: {{ block.settings.font_weight }};
                color: {{ block.settings.text_color }};
                border-radius: {{ block.settings.border_radius }}px;
                padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
                {% if block.settings.button_style == 'primary' %}
                  background: linear-gradient(135deg, {{ block.settings.bg_color_start }} 0%, {{ block.settings.bg_color_end }} 100%);
                  border: 1px solid transparent;
                {% elsif block.settings.button_style == 'outline' %}
                  background: transparent;
                  border: 1px solid {{ block.settings.border_color }};
                {% endif %}
              ">
                <span>{{ block.settings.text }}</span>
                {% if block.settings.show_icon %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                {% endif %}
              </a>
            </div>

          {% when 'stats' %}
            <div class="hero-block-stats-wrapper" style="
              margin-top: {{ block.settings.margin_top }}px;
              margin-bottom: {{ block.settings.margin_bottom }}px;
            " {{ block.shopify_attributes }}>
              <div class="hero-block-stats-grid">
                <div class="stat-item">
                  <span class="stat-num" style="font-size: {{ block.settings.number_font_size }}px; color: {{ block.settings.number_color }};">{{ block.settings.stat_1_number }}</span>
                  <span class="stat-text" style="font-size: {{ block.settings.label_font_size }}px; color: {{ block.settings.label_color }};">{{ block.settings.stat_1_label }}</span>
                </div>
                
                <div class="stat-divider" style="background: {{ block.settings.divider_color }};"></div>

                <div class="stat-item">
                  <span class="stat-num" style="font-size: {{ block.settings.number_font_size }}px; color: {{ block.settings.number_color }};">{{ block.settings.stat_2_number }}</span>
                  <span class="stat-text" style="font-size: {{ block.settings.label_font_size }}px; color: {{ block.settings.label_color }};">{{ block.settings.stat_2_label }}</span>
                </div>

                <div class="stat-divider" style="background: {{ block.settings.divider_color }};"></div>

                <div class="stat-item">
                  <span class="stat-num" style="font-size: {{ block.settings.number_font_size }}px; color: {{ block.settings.number_color }};">{{ block.settings.stat_3_number }}</span>
                  <span class="stat-text" style="font-size: {{ block.settings.label_font_size }}px; color: {{ block.settings.label_color }};">{{ block.settings.stat_3_label }}</span>
                </div>
              </div>
            </div>

        {% endcase %}
      {% endfor %}

    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner-section {
    position: relative;
    width: 100%;
    min-height: var(--min-height, 82vh);
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-bottom: 0;
    background: #0f0b10;
    padding-top: var(--padding-top, 60px);
    padding-bottom: var(--padding-bottom, 60px);
  }

  .hero-banner__image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    animation: heroZoom 15s infinite alternate ease-in-out;
  }

  @keyframes heroZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.06); }
  }

  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(15, 11, 16, var(--overlay-opacity, 0.78)) 0%, rgba(15, 11, 16, 0.4) 60%, rgba(15, 11, 16, 0.15) 100%);
  }

  .hero-banner__content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-banner__card {
    max-width: 680px;
    background: var(--card-bg-color, rgba(15, 11, 16, 0.45));
    border: 1px solid var(--card-border-color, rgba(255, 255, 255, 0.12));
    backdrop-filter: blur(var(--card-blur, 16px));
    border-radius: var(--card-border-radius, 24px);
    padding: var(--card-padding, 40px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .hero-block-badge-wrapper {
    display: inline-block;
  }

  .hero-block-badge {
    display: inline-block;
    backdrop-filter: blur(12px);
  }

  .hero-block-title-wrapper {
    width: 100%;
  }

  .hero-block-title {
    margin: 0;
  }

  .hero-block-subtitle-wrapper {
    width: 100%;
  }

  .hero-block-subtitle {
    margin: 0;
  }

  .hero-block-button-wrapper {
    display: inline-block;
  }

  .hero-block-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .hero-block-btn.secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
  }

  .hero-block-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(194, 91, 130, 0.4);
  }

  .hero-block-stats-grid {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero-block-stats-grid .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero-block-stats-grid .stat-num {
    font-weight: 800;
    line-height: 1;
  }

  .hero-block-stats-grid .stat-text {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .hero-block-stats-grid .stat-divider {
    width: 1px;
    height: 32px;
  }

  @media (max-width: 768px) {
    .hero-banner-section {
      padding-top: var(--mobile-padding-top, 40px);
      padding-bottom: var(--mobile-padding-bottom, 40px);
      min-height: 70vh;
    }

    .hero-banner__card {
      padding: 24px;
    }

    .hero-block-title {
      font-size: var(--title-size-mob, 32px) !important;
    }

    .hero-block-subtitle {
      font-size: var(--sub-size-mob, 14px) !important;
    }

    .hero-block-stats-grid .stat-divider {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kozmetik Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "🖼️ Arka Plan Görseli & Karartma"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Arka Plan Görseli"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Görsel Karartma Oranı (Overlay Opacity)",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.8
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Banner Yüksekliği (vh)",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 82
    },
    {
      "type": "header",
      "content": "🔲 Cam Kart (Glass Card) Ayarları"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Kart İçi Metin Hizalaması",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" },
        { "value": "right", "label": "Sağ" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Kart Arka Plan Rengi",
      "default": "rgba(15, 11, 16, 0.45)"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Kart Kenarlık Rengi",
      "default": "rgba(255, 255, 255, 0.12)"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Kart Köşe Yuvarlama (Radius)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_blur",
      "label": "Cam Bulanıklık Efekti (Backdrop Blur)",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Kart İç Boşluğu (Padding)",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "📐 Bölüm Boşlukları (Section Spacing)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Üst İç Boşluk (Masaüstü)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Alt İç Boşluk (Masaüstü)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Üst İç Boşluk (Mobil)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Alt İç Boşluk (Mobil)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "🏷️ Hero Rozeti (Badge)",
