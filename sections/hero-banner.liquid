{% comment %}
  Luxury Cosmetic Hero Banner Section
{% endcomment %}

<div class="hero-banner-section full-width">
  <div class="hero-banner__image-container">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero-banner__img', loading: 'eager' }}
    {% else %}
      <img src="{{ 'hero-banner.jpg' | asset_url }}" alt="Cilt Bakımı Koleksiyonu" class="hero-banner__img" width="1920" height="1080" loading="eager">
    {% endif %}
    <div class="hero-banner__overlay"></div>
  </div>

  <div class="hero-banner__content-wrapper">
    <div class="hero-banner__card">
      {% if section.settings.badge_text != blank %}
        <span class="hero-badge">{{ section.settings.badge_text }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h1 class="hero-title">
          {{ section.settings.title }}
        </h1>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="hero-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      <div class="hero-buttons">
        {% if section.settings.btn_text_1 != blank %}
          <a href="{{ section.settings.btn_link_1 | default: routes.all_products_collection_url }}" class="hero-btn primary-btn">
            <span>{{ section.settings.btn_text_1 }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}

        {% if section.settings.btn_text_2 != blank %}
          <a href="{{ section.settings.btn_link_2 | default: '#featuredProduct' }}" class="hero-btn secondary-btn">
            <span>{{ section.settings.btn_text_2 }}</span>
          </a>
        {% endif %}
      </div>

      <!-- Dynamic Feature stats blocks -->
      {% if section.blocks.size > 0 %}
        <div class="hero-stats">
          {% for block in section.blocks %}
            {% if forloop.index > 1 %}
              <div class="stat-divider"></div>
            {% endif %}
            <div class="stat-item" {{ block.shopify_attributes }}>
              <span class="stat-num">{{ block.settings.number }}</span>
              <span class="stat-text">{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner-section {
    position: relative;
    width: 100%;
    min-height: 82vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-bottom: 0;
    background: #0f0b10;
  }

  .hero-banner__image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    animation: heroZoom 15s infinite alternate ease-in-out;
  }

  .hero-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(15, 11, 16, 0.75) 0%, rgba(15, 11, 16, 0.35) 60%, rgba(15, 11, 16, 0.1) 100%);
  }

  .hero-banner__content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 1300px;
    width: 100%;
    margin: 0 auto;
    padding: 130px 24px 70px;
  }

  .hero-banner__card {
    max-width: 620px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 28px;
    padding: 44px;
    color: #ffffff;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    animation: heroFadeUp 0.8s ease forwards;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #f7cad0;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #ffffff 0%, #ffdfeb 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 30px;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    margin-bottom: 36px;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .primary-btn {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(194, 91, 130, 0.4);
  }

  .primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(194, 91, 130, 0.5);
  }

  .secondary-btn {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .secondary-btn:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding-top: 24px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f7cad0;
  }

  .stat-text {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .stat-divider {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.2);
  }

  @keyframes heroZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.06); }
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero-banner-section {
      min-height: 70vh;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-banner__card {
      padding: 24px;
    }
    .hero-buttons {
      flex-direction: column;
    }
  }
{% endstylesheet %}

