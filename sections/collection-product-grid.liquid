{% comment %}
  Modular Collection Product Grid Section
  Fully customizable in Shopify Theme Editor (Grid Columns, Card Glassmorphism, Badges, Buttons, Ratings, Typography)
{% endcomment %}

<div class="collection-product-grid-section full-width" style="
  --grid-columns-desktop: {{ section.settings.columns_desktop }};
  --grid-columns-mobile: {{ section.settings.columns_mobile }};
  --grid-gap: {{ section.settings.grid_gap }}px;
  --max-width: {{ section.settings.max_width }}px;
  --card-bg: {{ section.settings.card_bg }};
  --card-border: {{ section.settings.card_border_color }};
  --card-radius: {{ section.settings.card_radius }}px;
  --card-blur: {{ section.settings.card_blur }}px;
  --card-hover-border: {{ section.settings.card_hover_border }};
  --card-hover-lift: -{{ section.settings.card_hover_lift }}px;
  --badge-bg: {{ section.settings.badge_bg }};
  --badge-color: {{ section.settings.badge_text_color }};
  --sale-badge-start: {{ section.settings.sale_badge_bg_start }};
  --sale-badge-end: {{ section.settings.sale_badge_bg_end }};
  --wishlist-bg: {{ section.settings.wishlist_bg }};
  --wishlist-icon-color: {{ section.settings.wishlist_icon_color }};
  --wishlist-hover-bg: {{ section.settings.wishlist_hover_bg }};
  --quick-add-bg: {{ section.settings.quick_add_bg }};
  --quick-add-color: {{ section.settings.quick_add_text_color }};
  --quick-add-border: {{ section.settings.quick_add_border_color }};
  --quick-add-hover-start: {{ section.settings.quick_add_hover_bg_start }};
  --quick-add-hover-end: {{ section.settings.quick_add_hover_bg_end }};
  --star-color: {{ section.settings.star_color }};
  --rating-val-color: {{ section.settings.rating_val_color }};
  --title-size: {{ section.settings.title_font_size }}px;
  --title-weight: {{ section.settings.title_font_weight }};
  --title-color: {{ section.settings.title_color }};
  --title-hover-color: {{ section.settings.title_hover_color }};
  --price-size: {{ section.settings.price_font_size }}px;
  --price-weight: {{ section.settings.price_font_weight }};
  --price-color: {{ section.settings.price_color }};
  --compare-price-color: {{ section.settings.compare_price_color }};
  --pagination-bg: {{ section.settings.pagination_bg }};
  --pagination-color: {{ section.settings.pagination_text_color }};
  --pagination-active-bg: {{ section.settings.pagination_active_bg }};
  --pagination-active-color: {{ section.settings.pagination_active_text_color }};
">
  <div class="grid-section-container">
    <div class="collection-products-grid">
      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products.size > 0 %}
          {% for product in collection.products %}
            <div class="compact-product-card">
              <div class="compact-card__img-box">
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 450 | image_tag: class: 'compact-card__img', loading: 'lazy' }}
                  {% else %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="{{ product.title }}" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% endif %}
                </a>

                {% if section.settings.show_badge %}
                  {% if product.compare_at_price > product.price %}
                    <span class="compact-card__tag sale-tag">%25 İNDİRİM</span>
                  {% else %}
                    <span class="compact-card__tag">{{ section.settings.default_badge_text | default: "✦ SEÇKİN" }}</span>
                  {% endif %}
                {% endif %}

                {% if section.settings.show_wishlist %}
                  <button type="button" class="compact-wishlist-btn" aria-label="Favorilere Ekle">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                {% endif %}

                {% if section.settings.show_quick_add %}
                  <button type="button" class="compact-quick-add-btn demo-add-btn">
                    {{ section.settings.quick_add_text | default: "+ Sepete Ekle" }}
                  </button>
                {% endif %}
              </div>

              <div class="compact-card__info">
                {% if section.settings.show_rating %}
                  <div class="compact-card__rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-val">5.0</span>
                  </div>
                {% endif %}

                <h3 class="compact-card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="compact-card__price-row">
                  <span class="compact-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="compact-compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% comment %} Demonstration fallback products when no products in store {% endcomment %}
          {% assign demo_titles = "Radiance Glow Serum,Hydra-Luxe Velvet Cream,Rose Infusion Mask,Midnight Repair Oil,Botanical Cleansing Elixir,Lumière Gold Eye Complex,Peptide Renewal Concentrate,Satin Finish Sunscreen" | split: "," %}
          {% assign demo_prices = "₺450,00,₺620,00,₺380,00,₺740,00,₺310,00,₺590,00,₺850,00,₺420,00" | split: "," %}
          {% assign demo_old_prices = "₺590,00,₺750,00,₺460,00,₺900,00,₺390,00,₺720,00,₺990,00,₺510,00" | split: "," %}
          
          {% for i in (1..8) %}
            {% assign demo_idx = forloop.index0 %}
            {% assign mod2 = forloop.index | modulo: 2 %}
            {% assign mod3 = forloop.index | modulo: 3 %}

            <div class="compact-product-card">
              <div class="compact-card__img-box">
                <a href="#">
                  {% if mod2 == 0 %}
                    <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Demo Ürün" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% else %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Demo Ürün" class="compact-card__img" width="300" height="300" loading="lazy">
                  {% endif %}
                </a>

                {% if section.settings.show_badge %}
                  {% if mod3 == 0 %}
                    <span class="compact-card__tag sale-tag">%25 İNDİRİM</span>
                  {% else %}
                    <span class="compact-card__tag">{{ section.settings.default_badge_text | default: "✦ SEÇKİN" }}</span>
                  {% endif %}
                {% endif %}

                {% if section.settings.show_wishlist %}
                  <button type="button" class="compact-wishlist-btn" aria-label="Favorilere Ekle">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                {% endif %}

                {% if section.settings.show_quick_add %}
                  <button type="button" class="compact-quick-add-btn demo-add-btn">
                    {{ section.settings.quick_add_text | default: "+ Sepete Ekle" }}
                  </button>
                {% endif %}
              </div>

              <div class="compact-card__info">
                {% if section.settings.show_rating %}
                  <div class="compact-card__rating">
                    <span class="stars">★★★★★</span>
                    <span class="rating-val">5.0</span>
                  </div>
                {% endif %}

                <h3 class="compact-card__title">
                  <a href="#">{{ demo_titles[demo_idx] }}</a>
                </h3>

                <div class="compact-card__price-row">
                  <span class="compact-price">{{ demo_prices[demo_idx] }}</span>
                  <span class="compact-compare-price">{{ demo_old_prices[demo_idx] }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% if paginate.pages > 1 %}
          <div class="dark-pagination-wrapper">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</div>

{% stylesheet %}
  .grid-section-container {
    max-width: var(--max-width, 1320px);
    margin: 0 auto 80px;
    padding: 0 24px;
  }

  .collection-products-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-desktop, 5), 1fr);
    gap: var(--grid-gap, 22px);
  }

  .compact-product-card {
    background: var(--card-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--card-border, rgba(255, 255, 255, 0.12));
    backdrop-filter: blur(var(--card-blur, 16px));
    border-radius: var(--card-radius, 20px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .compact-product-card:hover {
    transform: translateY(var(--card-hover-lift, -6px));
    border-color: var(--card-hover-border, rgba(247, 202, 208, 0.4));
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(194, 91, 130, 0.2);
  }

  .compact-card__img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
  }

  .compact-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compact-product-card:hover .compact-card__img {
    transform: scale(1.08);
  }

  .compact-card__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--badge-bg, rgba(255, 255, 255, 0.15));
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    color: var(--badge-color, #ffffff);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .compact-card__tag.sale-tag {
    background: linear-gradient(135deg, var(--sale-badge-start, #c25b82) 0%, var(--sale-badge-end, #a44267) 100%);
    border: none;
  }

  .compact-wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--wishlist-bg, rgba(0, 0, 0, 0.4));
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    color: var(--wishlist-icon-color, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: all 0.2s ease;
  }

  .compact-wishlist-btn:hover {
    background: var(--wishlist-hover-bg, #c25b82);
    border-color: var(--wishlist-hover-bg, #c25b82);
    transform: scale(1.1);
  }

  .compact-quick-add-btn {
    position: absolute;
    bottom: -40px;
    left: 10px;
    right: 10px;
    padding: 8px;
    background: var(--quick-add-bg, rgba(18, 12, 20, 0.9));
    border: 1px solid var(--quick-add-border, rgba(247, 202, 208, 0.4));
    backdrop-filter: blur(10px);
    color: var(--quick-add-color, #ffffff);
    font-size: 0.78rem;
    font-weight: 800;
    border-radius: 10px;
    cursor: pointer;
    z-index: 3;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .compact-product-card:hover .compact-quick-add-btn {
    bottom: 10px;
  }

  .compact-quick-add-btn:hover {
    background: linear-gradient(135deg, var(--quick-add-hover-start, #c25b82) 0%, var(--quick-add-hover-end, #a44267) 100%);
    border-color: transparent;
  }

  .compact-card__info {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .compact-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
  }

  .compact-card__rating .stars {
    color: var(--star-color, #f7cad0);
    letter-spacing: 1px;
  }

  .compact-card__rating .rating-val {
    color: var(--rating-val-color, rgba(255, 255, 255, 0.6));
    font-weight: 700;
  }

  .compact-card__title {
    margin: 0;
    font-size: var(--title-size, 14px);
    font-weight: var(--title-weight, 700);
    line-height: 1.35;
  }

  .compact-card__title a {
    color: var(--title-color, #ffffff);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .compact-card__title a:hover {
    color: var(--title-hover-color, #f7cad0);
  }

  .compact-card__price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }

  .compact-price {
    font-size: var(--price-size, 16px);
    font-weight: var(--price-weight, 800);
    color: var(--price-color, #f7cad0);
  }

  .compact-compare-price {
    font-size: 0.78rem;
    color: var(--compare-price-color, rgba(255, 255, 255, 0.45));
    text-decoration: line-through;
  }

  .dark-pagination-wrapper {
    margin-top: 50px;
    text-align: center;
    grid-column: 1 / -1;
  }

  .dark-pagination-wrapper a,
  .dark-pagination-wrapper span {
    display: inline-block;
    padding: 8px 14px;
    margin: 0 4px;
    border-radius: 10px;
    background: var(--pagination-bg, rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--pagination-color, #ffffff);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .dark-pagination-wrapper .current {
    background: var(--pagination-active-bg, #c25b82);
    border-color: var(--pagination-active-bg, #c25b82);
    color: var(--pagination-active-color, #ffffff);
  }

  @media (max-width: 1024px) {
    .collection-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .collection-products-grid {
      grid-template-columns: repeat(var(--grid-columns-mobile, 2), 1fr);
      gap: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koleksiyon Ürün Izgarası",
  "settings": [
    {
      "type": "header",
      "content": "Izgara & Mizanpaj Ayarları"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Sayfa Başına Gösterilecek Ürün Sayısı",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Masaüstü Sütun Sayısı",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobil Sütun Sayısı",
      "options": [
        { "value": "1", "label": "1 Sütun" },
        { "value": "2", "label": "2 Sütun" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Kartlar Arası Boşluk (Gap)",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maksimum Konteyner Genişliği",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "header",
      "content": "Ürün Kartı & Cam (Glassmorphism) Stil"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Kart Arka Plan Rengi",
      "default": "rgba(255, 255, 255, 0.04)"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Kart Kenarlık Rengi",
      "default": "rgba(255, 255, 255, 0.12)"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Kart Köşe Yuvarlama (Radius)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_blur",
      "label": "Cam Bulanıklık Efekti (Backdrop Blur)",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_hover_border",
      "label": "Kart Hover Kenarlık Rengi",
      "default": "rgba(247, 202, 208, 0.4)"
    },
    {
      "type": "range",
      "id": "card_hover_lift",
      "label": "Hover Yükselme Miktarı (Translate Y)",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "header",
      "content": "Rozet / Etiket (Badge) Ayarları"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Rozeti Göster",
      "default": true
    },
    {
      "type": "text",
      "id": "default_badge_text",
      "label": "Varsayılan Rozet Metni",
      "default": "✦ SEÇKİN"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Rozet Arka Planı",
      "default": "rgba(255, 255, 255, 0.15)"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Rozet Metin Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "sale_badge_bg_start",
      "label": "İndirim Rozeti Gradyan Başlangıcı",
      "default": "#c25b82"
    },
    {
      "type": "color",
      "id": "sale_badge_bg_end",
      "label": "İndirim Rozeti Gradyan Bitişi",
      "default": "#a44267"
    },
    {
      "type": "header",
      "content": "Butonlar (Favori & Hızlı Ekle)"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Favori Butonunu Göster",
      "default": true
    },
    {
      "type": "color",
      "id": "wishlist_bg",
      "label": "Favori Butonu Arka Planı",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "color",
      "id": "wishlist_icon_color",
      "label": "Favori İkon Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "wishlist_hover_bg",
      "label": "Favori Butonu Hover Rengi",
      "default": "#c25b82"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Hızlı Sepete Ekle Butonunu Göster",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_add_text",
      "label": "Hızlı Ekle Buton Metni",
      "default": "+ Sepete Ekle"
    },
    {
      "type": "color",
      "id": "quick_add_bg",
      "label": "Hızlı Ekle Arka Plan Rengi",
      "default": "rgba(18, 12, 20, 0.9)"
    },
    {
      "type": "color",
      "id": "quick_add_text_color",
      "label": "Hızlı Ekle Metin Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "quick_add_border_color",
      "label": "Hızlı Ekle Kenarlık Rengi",
      "default": "rgba(247, 202, 208, 0.4)"
    },
    {
      "type": "color",
      "id": "quick_add_hover_bg_start",
      "label": "Hızlı Ekle Hover Gradyan Başlangıcı",
      "default": "#c25b82"
    },
    {
      "type": "color",
      "id": "quick_add_hover_bg_end",
      "label": "Hızlı Ekle Hover Gradyan Bitişi",
      "default": "#a44267"
    },
    {
      "type": "header",
      "content": "Tipografi & Değerlendirme"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Değerlendirme Yıldızlarını Göster",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Yıldız Rengi",
      "default": "#f7cad0"
    },
    {
      "type": "color",
      "id": "rating_val_color",
      "label": "Puan Metin Rengi",
