    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Ürün Başlığı Yazı Boyutu",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Ürün Başlığı Yazı Kalınlığı",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Orta (500)" },
        { "value": "600", "label": "Yarı Kalın (600)" },
        { "value": "700", "label": "Kalın (700)" },
        { "value": "800", "label": "Ekstra Kalın (800)" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Ürün Başlığı Rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_hover_color",
      "label": "Ürün Başlığı Hover Rengi",
      "default": "#f7cad0"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "label": "Fiyat Yazı Boyutu",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "price_font_weight",
      "label": "Fiyat Yazı Kalınlığı",
      "options": [
