{% comment %}
  Modular Collection Product Grid Section with Fully Customizable Sticky Left Side Filter Panel
  Includes Block-Level Editor Control for Sidebar Header, Categories, Stock Availability, Price Range, Vendors, Tags, Trust Cards, Banners & Product Cards.
{% endcomment %}

<div class="collection-product-grid-section full-width" style="
  --grid-columns-desktop: {{ section.settings.columns_desktop }};
  --grid-columns-mobile: {{ section.settings.columns_mobile }};
  --grid-gap: {{ section.settings.grid_gap }}px;
  --max-width: {{ section.settings.max_width }}px;
  --padding-top: {{ section.settings.padding_top }}px;
  --padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="grid-section-container">
    
    <div class="collection-main-side-layout">
      
      <!-- Sol Yan Ekran Filtre Paneli (Sticky Side Filter Panel) -->
      <aside class="collection-sidebar-panel" id="collectionSidebarPanel" style="
        --sidebar-width: {{ section.settings.sidebar_width | default: 280 }}px;
        --sidebar-sticky-top: {{ section.settings.sidebar_sticky_top | default: 100 }}px;
        --sidebar-bg: {{ section.settings.sidebar_bg | default: '#151019' }};
        --sidebar-border: {{ section.settings.sidebar_border | default: 'rgba(255, 255, 255, 0.12)' }};
        --sidebar-radius: {{ section.settings.sidebar_radius | default: 20 }}px;
        --sidebar-blur: {{ section.settings.sidebar_blur | default: 16 }}px;
        --sidebar-padding: {{ section.settings.sidebar_padding | default: 24 }}px;
      ">
        
        <!-- Sidebar Header Block -->
        {% assign header_blocks = section.blocks | where: "type", "sidebar_header" %}
        {% if header_blocks.size > 0 %}
          {% for block in header_blocks %}
            <div class="sidebar-header" style="
              --hdr-title-color: {{ block.settings.title_color | default: '#ffffff' }};
              --hdr-icon-color: {{ block.settings.icon_color | default: '#f7cad0' }};
              --hdr-title-size: {{ block.settings.title_font_size | default: 14 }}px;
              --hdr-title-spacing: {{ block.settings.title_letter_spacing | default: 2 }}px;
              --hdr-reset-color: {{ block.settings.reset_color | default: 'rgba(255, 255, 255, 0.6)' }};
              --hdr-reset-bg: {{ block.settings.reset_bg | default: 'transparent' }};
              --hdr-reset-border: {{ block.settings.reset_border | default: 'rgba(255, 255, 255, 0.15)' }};
              --hdr-reset-hover-bg: {{ block.settings.reset_hover_bg | default: 'rgba(194, 91, 130, 0.2)' }};
              --hdr-reset-hover-border: {{ block.settings.reset_hover_border | default: '#f7cad0' }};
              --hdr-border-color: {{ block.settings.border_color | default: 'rgba(255, 255, 255, 0.08)' }};
            " {{ block.shopify_attributes }}>
              <div class="sidebar-title-group">
                <span class="sidebar-sparkle">{{ block.settings.icon | default: "✦" }}</span>
                <h3 class="sidebar-main-title">{{ block.settings.title | default: "FİLTRELER" }}</h3>
              </div>
              <button type="button" class="sidebar-reset-btn" id="resetSidebarFiltersBtn">
                <span>{{ block.settings.reset_text | default: "Temizle" }}</span>
              </button>
            </div>
          {% endfor %}
        {% else %}
          <div class="sidebar-header">
            <div class="sidebar-title-group">
              <span class="sidebar-sparkle">✦</span>
              <h3 class="sidebar-main-title">FİLTRELER</h3>
            </div>
            <button type="button" class="sidebar-reset-btn" id="resetSidebarFiltersBtn">
              <span>Temizle</span>
            </button>
          </div>
        {% endif %}

        <div class="sidebar-blocks-wrapper">
          
          <!-- Category Filter Block Group -->
          {% assign category_blocks = section.blocks | where: "type", "category_filter" %}
          {% if category_blocks.size > 0 %}
            {% assign cat_first = category_blocks | first %}
            <div class="sidebar-filter-block collapsible-block open" style="
              --blk-title-color: {{ cat_first.settings.title_color | default: '#f7cad0' }};
              --blk-title-size: {{ cat_first.settings.title_font_size | default: 12 }}px;
              --blk-title-spacing: {{ cat_first.settings.title_letter_spacing | default: 1.5 }}px;
            ">
              <div class="sidebar-block-header">
                <h4 class="sidebar-block-title">{{ cat_first.settings.block_title | default: "KATEGORİLER" }}</h4>
                <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
              </div>
              <div class="sidebar-block-content">
                <div class="sidebar-category-list" id="categoryFilterPills">
                  {% for block in category_blocks %}
                    <button type="button" class="filter-pill sidebar-cat-item {% if block.settings.is_active or forloop.first %}active{% endif %}"
                      data-category="{{ block.settings.category | default: 'all' }}"
                      style="
                        --cat-item-bg: {{ block.settings.item_bg | default: 'rgba(255, 255, 255, 0.03)' }};
                        --cat-item-border: {{ block.settings.item_border | default: 'rgba(255, 255, 255, 0.08)' }};
                        --cat-item-color: {{ block.settings.item_text_color | default: 'rgba(255, 255, 255, 0.75)' }};
                        --cat-active-bg-start: {{ block.settings.active_bg_start | default: 'rgba(194, 91, 130, 0.3)' }};
                        --cat-active-bg-end: {{ block.settings.active_bg_end | default: 'rgba(162, 67, 103, 0.3)' }};
                        --cat-active-border: {{ block.settings.active_border | default: '#f7cad0' }};
                        --cat-active-color: {{ block.settings.active_text_color | default: '#ffffff' }};
                        --cat-dot-color: {{ block.settings.dot_color | default: 'transparent' }};
                        --cat-active-dot-color: {{ block.settings.active_dot_color | default: '#f7cad0' }};
                      "
                      {{ block.shopify_attributes }}>
                      <span class="cat-label">{{ block.settings.label }}</span>
                      <span class="cat-dot"></span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}

          <!-- Stock Availability Filter Block -->
          {% assign avail_blocks = section.blocks | where: "type", "availability_filter" %}
          {% if avail_blocks.size > 0 %}
            {% for block in avail_blocks %}
              <div class="sidebar-filter-block collapsible-block open" style="
                --blk-title-color: {{ block.settings.title_color | default: '#f7cad0' }};
                --blk-title-size: {{ block.settings.title_font_size | default: 12 }}px;
                --stk-chk-bg: {{ block.settings.checkbox_bg | default: 'rgba(255, 255, 255, 0.05)' }};
                --stk-chk-border: {{ block.settings.checkbox_border | default: 'rgba(255, 255, 255, 0.2)' }};
                --stk-chk-checked-start: {{ block.settings.checkbox_checked_bg_start | default: '#c25b82' }};
                --stk-chk-checked-end: {{ block.settings.checkbox_checked_bg_end | default: '#a24367' }};
                --stk-chk-checked-border: {{ block.settings.checkbox_checked_border | default: '#f7cad0' }};
                --stk-checkmark-color: {{ block.settings.checkmark_color | default: '#ffffff' }};
                --stk-text-color: {{ block.settings.label_text_color | default: 'rgba(255, 255, 255, 0.85)' }};
                --stk-chk-radius: {{ block.settings.checkbox_radius | default: 6 }}px;
              " {{ block.shopify_attributes }}>
                <div class="sidebar-block-header">
                  <h4 class="sidebar-block-title">{{ block.settings.title | default: "STOK DURUMU" }}</h4>
                  <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
                </div>
                <div class="sidebar-block-content">
                  <div class="sidebar-stock-options">
                    <label class="stock-option-label">
                      <input type="checkbox" class="stock-checkbox-input" value="in_stock" checked>
                      <span class="custom-check-box"><span class="check-mark">✓</span></span>
                      <span class="stock-text">{{ block.settings.in_stock_label | default: "Stokta Var" }}</span>
                    </label>

                    <label class="stock-option-label">
                      <input type="checkbox" class="stock-checkbox-input" value="out_of_stock" checked>
                      <span class="custom-check-box"><span class="check-mark">✓</span></span>
                      <span class="stock-text">{{ block.settings.out_of_stock_label | default: "Tükendi / Stokta Yok" }}</span>
                    </label>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endif %}

          <!-- Price Range Filter Block -->
          {% assign price_blocks = section.blocks | where: "type", "price_filter" %}
          {% if price_blocks.size > 0 %}
            {% for block in price_blocks %}
              <div class="sidebar-filter-block collapsible-block open" style="
                --blk-title-color: {{ block.settings.title_color | default: '#f7cad0' }};
                --blk-title-size: {{ block.settings.title_font_size | default: 12 }}px;
                --prc-symbol-color: {{ block.settings.symbol_color | default: '#f7cad0' }};
                --prc-input-bg: {{ block.settings.input_bg | default: 'rgba(255, 255, 255, 0.05)' }};
                --prc-input-border: {{ block.settings.input_border | default: 'rgba(255, 255, 255, 0.12)' }};
                --prc-input-focus: {{ block.settings.input_focus_border | default: '#f7cad0' }};
                --prc-input-text: {{ block.settings.input_text_color | default: '#ffffff' }};
                --prc-input-radius: {{ block.settings.input_radius | default: 8 }}px;
                --prc-dash-color: {{ block.settings.dash_color | default: 'rgba(255, 255, 255, 0.4)' }};
              " {{ block.shopify_attributes }}>
                <div class="sidebar-block-header">
                  <h4 class="sidebar-block-title">{{ block.settings.title | default: "FİYAT ARALIĞI" }}</h4>
                  <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
                </div>
                <div class="sidebar-block-content">
                  <div class="sidebar-price-controls">
                    <div class="price-inputs-row">
                      <div class="price-input-box">
                        <span class="price-symbol">{{ block.settings.currency_symbol | default: "₺" }}</span>
                        <input type="number" class="price-num-input" id="minPriceInput" placeholder="{{ block.settings.min_placeholder | default: 'Min' }}" value="{{ block.settings.min_price_default | default: 0 }}" min="0">
                      </div>
                      <span class="price-dash">-</span>
                      <div class="price-input-box">
                        <span class="price-symbol">{{ block.settings.currency_symbol | default: "₺" }}</span>
                        <input type="number" class="price-num-input" id="maxPriceInput" placeholder="{{ block.settings.max_placeholder | default: 'Max' }}" value="{{ block.settings.max_price_limit | default: 1000 }}" min="0">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endif %}

          <!-- Vendor Filter Block -->
          {% assign vendor_blocks = section.blocks | where: "type", "vendor_filter" %}
          {% for block in vendor_blocks %}
            <div class="sidebar-filter-block collapsible-block open" style="
              --blk-title-color: {{ block.settings.title_color | default: '#f7cad0' }};
              --vnd-text-color: {{ block.settings.item_text_color | default: 'rgba(255, 255, 255, 0.85)' }};
              --stk-chk-bg: {{ block.settings.checkbox_bg | default: 'rgba(255, 255, 255, 0.05)' }};
              --stk-chk-border: {{ block.settings.checkbox_border | default: 'rgba(255, 255, 255, 0.2)' }};
              --stk-chk-checked-start: {{ block.settings.checkbox_checked_bg | default: '#c25b82' }};
              --stk-chk-checked-end: {{ block.settings.checkbox_checked_bg | default: '#a24367' }};
              --stk-chk-checked-border: {{ block.settings.title_color | default: '#f7cad0' }};
              --stk-checkmark-color: #ffffff;
            " {{ block.shopify_attributes }}>
              <div class="sidebar-block-header">
                <h4 class="sidebar-block-title">{{ block.settings.title | default: "MARKALAR" }}</h4>
                <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
              </div>
              <div class="sidebar-block-content">
                <div class="sidebar-vendor-options">
                  {% assign vendor_array = block.settings.vendors | split: "," %}
                  {% for vendor in vendor_array %}
                    {% assign clean_vendor = vendor | strip %}
                    {% if clean_vendor != blank %}
                      <label class="stock-option-label vendor-option-label">
                        <input type="checkbox" class="vendor-checkbox-input" value="{{ clean_vendor | escape }}">
                        <span class="custom-check-box"><span class="check-mark">✓</span></span>
                        <span class="stock-text" style="color: var(--vnd-text-color);">{{ clean_vendor }}</span>
                      </label>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}

          <!-- Tag Filter Block -->
          {% assign tag_blocks = section.blocks | where: "type", "tag_filter" %}
          {% for block in tag_blocks %}
            <div class="sidebar-filter-block collapsible-block open" style="
              --blk-title-color: {{ block.settings.title_color | default: '#f7cad0' }};
              --tag-pill-bg: {{ block.settings.pill_bg | default: 'rgba(255, 255, 255, 0.05)' }};
              --tag-pill-border: {{ block.settings.pill_border | default: 'rgba(255, 255, 255, 0.12)' }};
              --tag-pill-text: {{ block.settings.pill_text | default: 'rgba(255, 255, 255, 0.75)' }};
              --tag-active-bg: {{ block.settings.active_pill_bg | default: '#c25b82' }};
              --tag-active-text: {{ block.settings.active_pill_text | default: '#ffffff' }};
            " {{ block.shopify_attributes }}>
              <div class="sidebar-block-header">
                <h4 class="sidebar-block-title">{{ block.settings.title | default: "ÖNE ÇIKAN ETİKETLER" }}</h4>
                <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
              </div>
              <div class="sidebar-block-content">
                <div class="sidebar-tags-wrapper" id="sidebarTagPills">
                  {% assign tag_array = block.settings.tags | split: "," %}
                  {% for tag in tag_array %}
                    {% assign clean_tag = tag | strip %}
                    {% if clean_tag != blank %}
                      <button type="button" class="tag-pill" data-tag="{{ clean_tag | escape }}">
                        <span>#{{ clean_tag }}</span>
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}

          <!-- Sidebar Banner / Promo Block -->
          {% assign banner_blocks = section.blocks | where: "type", "sidebar_banner" %}
          {% for block in banner_blocks %}
            <div class="sidebar-promo-card collapsible-block open" style="
              --bnr-title-color: {{ block.settings.title_color | default: '#ffffff' }};
              --bnr-sub-color: {{ block.settings.subtitle_color | default: 'rgba(255, 255, 255, 0.8)' }};
              --bnr-bg: {{ block.settings.bg_color | default: '#1a121d' }};
              --bnr-border: {{ block.settings.border_color | default: 'rgba(194, 91, 130, 0.3)' }};
              --bnr-radius: {{ block.settings.border_radius | default: 16 }}px;
            " {{ block.shopify_attributes }}>
              <div class="sidebar-block-header" style="margin-bottom: 8px;">
                <h5 class="promo-card-title" style="margin: 0; color: var(--bnr-title-color);">{{ block.settings.title }}</h5>
                <button type="button" class="sidebar-accordion-toggle" aria-label="Aç / Kapat"><span class="accordion-icon">−</span></button>
              </div>
              <div class="sidebar-block-content">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 300 | image_tag: class: 'promo-card-img', loading: 'lazy' }}
                {% endif %}
                <div class="promo-card-content">
                  <p class="promo-card-desc">{{ block.settings.subtitle }}</p>
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" class="promo-card-link">İncele →</a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}

        </div>
      </aside>

      <!-- Sağ Ekran Ürün Izgarası (Right Product Grid Area) -->
      <main class="collection-products-area">
        {% assign card_blocks = section.blocks | where: "type", "product_card" %}

        <div class="collection-products-grid">
          {% if card_blocks.size > 0 %}
            {% for block in card_blocks %}
              {% assign prod = block.settings.product %}
              {% if prod != blank %}
                {% assign raw_price = prod.price | divided_by: 100.0 %}
                {% assign card_title = prod.title %}
                {% assign card_vendor = prod.vendor | default: 'Lumière' %}
                {% assign card_tags = prod.tags | join: ',' | default: 'Organik,Anti-Aging' %}
              {% else %}
                {% assign price_str = block.settings.price | default: '0' %}
                {% assign raw_price = price_str | remove: '₺' | remove: '.' | replace: ',', '.' | plus: 0 %}
                {% assign card_title = block.settings.title %}
                {% assign card_vendor = 'Lumière' %}
                {% assign card_tags = 'Organik,Anti-Aging,Leke Karşıtı,Vegan' %}
              {% endif %}

              {% assign is_in_stock = true %}
              {% if prod != blank %}
                {% assign is_in_stock = prod.available %}
              {% elsif block.settings.is_in_stock == false or forloop.index == 5 or forloop.index == 9 %}
                {% assign is_in_stock = false %}
              {% endif %}

              <div class="haute-product-card"
                data-category="{{ block.settings.category | default: 'all' }}"
                data-price="{{ raw_price }}"
                data-index="{{ forloop.index }}"
                data-title="{{ card_title | escape }}"
                data-vendor="{{ card_vendor | escape }}"
                data-tags="{{ card_tags | escape }}"
                data-stock="{% if is_in_stock %}in_stock{% else %}out_of_stock{% endif %}"
                style="
                  --item-card-bg: {{ block.settings.card_bg_color }};
                  --item-card-border: {{ block.settings.card_border_color }};
                  --item-card-radius: {{ block.settings.card_border_radius }}px;
                  --item-card-blur: {{ block.settings.card_blur }}px;
                  --item-card-padding: {{ block.settings.card_padding }}px;
                  --card-badge-start: {{ block.settings.badge_bg_start }};
                  --card-badge-end: {{ block.settings.badge_bg_end }};
                  --card-badge-text: {{ block.settings.badge_text_color }};
                  --card-title-color: {{ block.settings.title_color }};
                  --card-desc-color: {{ block.settings.desc_color }};
                  --card-price-color: {{ block.settings.price_color }};
                  --card-compare-color: {{ block.settings.compare_price_color }};
                  --card-qadd-bg: {{ block.settings.quick_add_bg }};
                  --card-qadd-text: {{ block.settings.quick_add_text_color }};
                  --card-qadd-border: {{ block.settings.quick_add_border }};
                " {{ block.shopify_attributes }}>
                <div class="card-image-wrapper">
                  <a href="{{ prod.url | default: block.settings.url | default: '#' }}">
                    {% if block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 450 | image_tag: class: 'card-img', loading: 'lazy' }}
                    {% elsif prod != blank and prod.featured_image %}
                      {{ prod.featured_image | image_url: width: 450 | image_tag: class: 'card-img', loading: 'lazy' }}
                    {% else %}
                      {% assign mod2 = forloop.index | modulo: 2 %}
                      {% if mod2 == 0 %}
                        <img src="{{ 'luxury-cream.jpg' | asset_url }}" class="card-img" alt="Demo Ürün" width="400" height="400" loading="lazy">
                      {% else %}
                        <img src="{{ 'luxury-serum.jpg' | asset_url }}" class="card-img" alt="Demo Ürün" width="400" height="400" loading="lazy">
                      {% endif %}
                    {% endif %}
                  </a>

                  {% if is_in_stock == false %}
                    <span class="card-badge badge-out-stock">TÜKENDİ</span>
                  {% elsif block.settings.badge_text != blank %}
                    <span class="card-badge">{{ block.settings.badge_text }}</span>
                  {% endif %}

                  <button type="button" class="card-wishlist-btn" aria-label="Favorilere Ekle">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                </div>

                <div class="card-content-wrapper">
                  <div class="card-rating-stars">★★★★★ <span class="rating-val">5.0</span></div>

                  <h3 class="card-title">
                    <a href="{{ prod.url | default: block.settings.url | default: '#' }}">
                      {% if prod != blank %}{{ prod.title }}{% else %}{{ block.settings.title }}{% endif %}
                    </a>
                  </h3>

                  <p class="card-desc">
                    {% if prod != blank and prod.description != blank %}{{ prod.description | strip_html | truncate: 75 }}{% else %}{{ block.settings.description }}{% endif %}
                  </p>

                  <div class="card-price-row">
                    <span class="price-main">
                      {% if prod != blank %}{{ prod.price | money }}{% else %}{{ block.settings.price }}{% endif %}
                    </span>
                    <span class="price-compare">
                      {% if prod != blank and prod.compare_at_price %}{{ prod.compare_at_price | money }}{% else %}{{ block.settings.compare_price }}{% endif %}
                    </span>
                  </div>

                  <button type="button" class="card-quick-add-btn demo-add-btn {% if is_in_stock == false %}disabled{% endif %}" {% if is_in_stock == false %}disabled{% endif %}>
                    <span>{% if is_in_stock %}{{ block.settings.quick_add_text }}{% else %}Tükendi{% endif %}</span>
                  </button>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="grid-empty-state">
              <p>Bu koleksiyonda henüz ürün bulunmuyor.</p>
            </div>
          {% endif %}
        </div>
      </main>

    </div>

  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    // Accordion Toggle for Sidebar Filter Blocks (+ / -)
    document.addEventListener('click', function(e) {
      const header = e.target.closest('.sidebar-block-header');
      if (!header) return;

      const block = header.closest('.collapsible-block');
      if (!block) return;

      const icon = header.querySelector('.accordion-icon');
      const isCollapsed = block.classList.contains('collapsed');

      if (isCollapsed) {
        block.classList.remove('collapsed');
        block.classList.add('open');
        if (icon) icon.textContent = '−';
      } else {
        block.classList.remove('open');
        block.classList.add('collapsed');
        if (icon) icon.textContent = '+';
      }
    });

    function applyUnifiedFilters() {
      const grid = document.querySelector('.collection-products-grid');
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll('.haute-product-card'));
      
      const activeCatPill = document.querySelector('#categoryFilterPills .filter-pill.active');
      const selectedCategory = activeCatPill ? activeCatPill.getAttribute('data-category') : 'all';

      const stockInputs = Array.from(document.querySelectorAll('.stock-checkbox-input:checked')).map(i => i.value);

      const minInput = document.getElementById('minPriceInput');
      const maxInput = document.getElementById('maxPriceInput');
      const minPrice = minInput ? (parseFloat(minInput.value) || 0) : 0;
      const maxPrice = maxInput ? (parseFloat(maxInput.value) || 999999) : 999999;

      const vendorInputs = Array.from(document.querySelectorAll('.vendor-checkbox-input:checked')).map(i => i.value.toLowerCase());

      const activeTagPills = Array.from(document.querySelectorAll('#sidebarTagPills .tag-pill.active')).map(p => (p.getAttribute('data-tag') || '').toLowerCase());

      cards.forEach(card => {
        const cardCategory = card.getAttribute('data-category') || 'all';
        const cardStock = card.getAttribute('data-stock') || 'in_stock';
        const cardPrice = parseFloat(card.getAttribute('data-price')) || 0;
        const cardVendor = (card.getAttribute('data-vendor') || '').toLowerCase();
        const cardTags = (card.getAttribute('data-tags') || '').toLowerCase();

        const categoryMatch = (selectedCategory === 'all' || cardCategory === selectedCategory);
        const stockMatch = (stockInputs.length === 0 || stockInputs.includes(cardStock));
        const priceMatch = (cardPrice >= minPrice && cardPrice <= maxPrice);
        const vendorMatch = (vendorInputs.length === 0 || vendorInputs.some(v => cardVendor.includes(v)));
        const tagMatch = (activeTagPills.length === 0 || activeTagPills.some(t => cardTags.includes(t)));

        if (categoryMatch && stockMatch && priceMatch && vendorMatch && tagMatch) {
          card.style.display = '';
          card.style.opacity = '1';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Category Filter Listener
    const catPills = document.querySelectorAll('#categoryFilterPills .filter-pill');
    catPills.forEach(pill => {
      pill.addEventListener('click', function() {
        catPills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        applyUnifiedFilters();
      });
    });

    // Stock Availability Listener
    const stockCheckboxes = document.querySelectorAll('.stock-checkbox-input');
    stockCheckboxes.forEach(cb => {
      cb.addEventListener('change', applyUnifiedFilters);
    });

    // Price Inputs Listener
    const minInput = document.getElementById('minPriceInput');
    const maxInput = document.getElementById('maxPriceInput');
    if (minInput) minInput.addEventListener('input', applyUnifiedFilters);
    if (maxInput) maxInput.addEventListener('input', applyUnifiedFilters);

    // Vendor Checkboxes Listener
    const vendorCheckboxes = document.querySelectorAll('.vendor-checkbox-input');
    vendorCheckboxes.forEach(cb => {
      cb.addEventListener('change', applyUnifiedFilters);
    });

    // Tag Pills Listener
    const tagPills = document.querySelectorAll('#sidebarTagPills .tag-pill');
    tagPills.forEach(pill => {
      pill.addEventListener('click', function() {
        this.classList.toggle('active');
        applyUnifiedFilters();
      });
    });

    // Reset Filters Listener
    const resetBtn = document.getElementById('resetSidebarFiltersBtn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        catPills.forEach((p, index) => {
          if (index === 0) p.classList.add('active');
          else p.classList.remove('active');
        });
        stockCheckboxes.forEach(cb => cb.checked = true);
        vendorCheckboxes.forEach(cb => cb.checked = false);
        tagPills.forEach(p => p.classList.remove('active'));
        if (minInput) minInput.value = minInput.getAttribute('value') || 0;
        if (maxInput) maxInput.value = maxInput.getAttribute('value') || 1000;
        applyUnifiedFilters();
      });
    }
  });
{% endjavascript %}

