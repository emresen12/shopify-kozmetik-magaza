<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- SEARCH BAR TOGGLE ---
    const searchWrapper = document.getElementById('searchWrapper');
    const searchToggleBtn = document.getElementById('searchToggleBtn');
    const searchCloseBtn = document.getElementById('searchCloseBtn');
    const searchInput = document.getElementById('searchInput');

    if (searchWrapper && searchToggleBtn && searchCloseBtn && searchInput) {
      searchToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        searchWrapper.classList.add('active');
        searchInput.focus();
      });

      searchCloseBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        searchWrapper.classList.remove('active');
      });

      document.addEventListener('click', (e) => {
        if (!searchWrapper.contains(e.target)) {
          searchWrapper.classList.remove('active');
        }
      });
    }

    // --- SIDE DRAWERS LOGIC (NAV MENU, AUTH & CART) ---
    const navDrawer = document.getElementById('navDrawer');
    const authDrawer = document.getElementById('authDrawer');
    const cartDrawer = document.getElementById('cartDrawer');
    
    const navTrigger = document.getElementById('navDrawerTrigger');
    const authTrigger = document.getElementById('authDrawerTrigger');
    const cartTrigger = document.getElementById('cartDrawerTrigger');

    const navAuthBtn = document.getElementById('navDrawerAuthBtn');
    const navCartBtn = document.getElementById('navDrawerCartBtn');

    if (navDrawer && navTrigger) {
      navTrigger.addEventListener('click', () => {
        openDrawer(navDrawer);
      });
    }

    if (navAuthBtn) {
      navAuthBtn.addEventListener('click', () => {
        closeDrawer(navDrawer);
        if (authDrawer) openDrawer(authDrawer);
      });
    }

    if (navCartBtn) {
      navCartBtn.addEventListener('click', () => {
        closeDrawer(navDrawer);
        if (cartDrawer) openDrawer(cartDrawer);
      });
    }

    function openDrawer(drawer) {
      if (drawer) {
        drawer.classList.add('active');
        drawer.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
      }
    }

    function closeDrawer(drawer) {
      if (drawer) {
        drawer.classList.remove('active');
        drawer.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }
    }

    if (authTrigger && authDrawer) {
      authTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        openDrawer(authDrawer);
      });
    }

    if (cartTrigger && cartDrawer) {
      cartTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        openDrawer(cartDrawer);
      });
    }

    // Close drawers on backdrop or close button click
    const closeBtns = document.querySelectorAll('[data-close-drawer]');
    closeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        closeDrawer(navDrawer);
        closeDrawer(authDrawer);
        closeDrawer(cartDrawer);
      });
    });

    // --- DYNAMIC CART MANAGEMENT ENGINE ---
    let cartItems = [];

    const cartBadgeCount = document.getElementById('cartBadgeCount');
    const drawerCartItemCount = document.getElementById('drawerCartItemCount');
    const cartDrawerItems = document.getElementById('cartDrawerItems');
    const drawerSubtotal = document.getElementById('drawerSubtotal');
    const drawerTotal = document.getElementById('drawerTotal');
    const freeShippingProgress = document.getElementById('freeShippingProgress');
    const freeShippingText = document.getElementById('freeShippingText');

    function parsePriceNum(priceStr) {
      if (typeof priceStr === 'number') return priceStr;
      if (!priceStr) return 0;
      let clean = String(priceStr).replace(/[^0-9,.]/g, '');
      if (clean.includes(',')) {
        clean = clean.replace(/\./g, '').replace(',', '.');
      }
      return parseFloat(clean) || 0;
    }

    function formatMoneyTL(amount) {
      return '₺' + amount.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function updateCartUI() {
      let totalCount = 0;
      let totalPrice = 0;

      cartItems.forEach(item => {
        totalCount += item.qty;
        totalPrice += item.price * item.qty;
      });

      if (cartBadgeCount) cartBadgeCount.innerText = totalCount;
      if (drawerCartItemCount) drawerCartItemCount.innerText = totalCount;
      if (drawerSubtotal) drawerSubtotal.innerText = formatMoneyTL(totalPrice);
      if (drawerTotal) drawerTotal.innerText = formatMoneyTL(totalPrice);

      // Free shipping threshold (₺500)
      if (freeShippingProgress && freeShippingText) {
        const threshold = 500;
        if (totalPrice >= threshold || totalCount === 0) {
          freeShippingProgress.style.width = '100%';
          freeShippingText.innerText = "🎉 ₺500 üzeri Kargo Bedava!";
        } else {
          const pct = Math.min(100, Math.round((totalPrice / threshold) * 100));
          const remaining = threshold - totalPrice;
          freeShippingProgress.style.width = pct + '%';
          freeShippingText.innerText = '🚚 Kargo Bedava için ' + formatMoneyTL(remaining) + ' daha ekleyin!';
        }
      }

      if (!cartDrawerItems) return;

      if (cartItems.length === 0) {
        cartDrawerItems.innerHTML = `
          <div class="empty-cart-msg" id="emptyCartMsg">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            <h4 class="empty-cart-title">Sepetiniz henüz boş</h4>
            <p class="empty-cart-subtitle">Seçkin cilt bakım ürünlerimizi keşfetmek için alışverişe başlayın.</p>
            <a href="/collections/all" class="empty-cart-shop-btn">Alışverişe Başla</a>
          </div>
        `;
        return;
      }

      let html = '';
      cartItems.forEach((item, idx) => {
        const lineTotal = formatMoneyTL(item.price * item.qty);
        html += `
          <div class="drawer-cart-item" data-cart-index="${idx}">
            <img src="${item.img}" alt="${item.title}" class="cart-item-img" width="80" height="80">
            <div class="cart-item-info">
              <h4 class="cart-item-title">${item.title}</h4>
              <div class="cart-item-bottom">
                <div class="drawer-qty-picker">
                  <button type="button" class="drawer-qty-btn dqty-minus" data-idx="${idx}">-</button>
                  <input type="text" value="${item.qty}" readonly class="drawer-qty-val">
                  <button type="button" class="drawer-qty-btn dqty-plus" data-idx="${idx}">+</button>
                </div>
                <span class="cart-item-price">${lineTotal}</span>
              </div>
            </div>
            <button type="button" class="cart-item-remove" data-idx="${idx}" title="Kaldır">✕</button>
          </div>
        `;
      });

      cartDrawerItems.innerHTML = html;

      // Event listeners for +, -, remove
      cartDrawerItems.querySelectorAll('.dqty-plus').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx'));
          cartItems[idx].qty++;
          updateCartUI();
        });
      });

      cartDrawerItems.querySelectorAll('.dqty-minus').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx'));
          if (cartItems[idx].qty > 1) {
            cartItems[idx].qty--;
          } else {
            cartItems.splice(idx, 1);
          }
          updateCartUI();
        });
      });

      cartDrawerItems.querySelectorAll('.cart-item-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-idx'));
          cartItems.splice(idx, 1);
          updateCartUI();
        });
      });
    }

    // Initialize Empty State
    updateCartUI();

    // Global Add To Cart Function
    window.lumiereAddToCart = function(itemData) {
      const title = itemData.title || "Lüks Cilt Bakım Ürünü";
      const price = parsePriceNum(itemData.price || "₺450,00");
      const img = itemData.img || "{{ 'luxury-serum.jpg' | asset_url }}";

      const existingIndex = cartItems.findIndex(i => i.title === title);
      if (existingIndex > -1) {
        cartItems[existingIndex].qty += 1;
      } else {
        cartItems.push({
          title: title,
          price: price,
          img: img,
          qty: 1
        });
      }

      updateCartUI();
      openDrawer(cartDrawer);
    };

    // Global Click Delegation for "Sepete Ekle" Buttons
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.demo-add-btn, .card-quick-add-btn, .compact-quick-add-btn, [data-add-to-cart]');
      if (btn) {
        e.preventDefault();
        
        const card = btn.closest('.haute-product-card, .compact-product-card, .featured-product-container, .product-single-container') || document;
        
        let title = '';
        let priceStr = '';
        let imgUrl = '';

        const titleEl = card.querySelector('.card-title a, .card-title, .compact-card__title a, .product-title, h1, h3');
        if (titleEl) title = titleEl.innerText.trim();

        const priceEl = card.querySelector('.price-main, .compact-price, .current-price, .price');
        if (priceEl) priceStr = priceEl.innerText.trim();

        const imgEl = card.querySelector('.card-img, .compact-card__img, img');
        if (imgEl) imgUrl = imgEl.src;

        // Button Animation Feedback
        const origText = btn.innerText;
        btn.innerText = '✓ Sepete Eklendi!';
        btn.style.background = 'linear-gradient(135deg, #4ade80 0%, #22c55e 100%)';
        btn.style.color = '#ffffff';

        setTimeout(() => {
          btn.innerText = origText;
          btn.style.background = '';
          btn.style.color = '';
        }, 1500);

        window.lumiereAddToCart({
          title: title || 'Lumière Radiance Serum 30ml',
          price: priceStr || '₺450,00',
          img: imgUrl || "{{ 'luxury-serum.jpg' | asset_url }}"
        });
      }
    });

    // --- AUTH DRAWER TABS SWITCHER ---
    const tabBtns = document.querySelectorAll('.auth-tab-btn');
    const tabContents = document.querySelectorAll('.auth-tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => c.classList.remove('active'));

        btn.classList.add('active');
        const targetId = btn.getAttribute('data-tab');
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });

    // --- DEMO LOGIN BUTTON CLICK ---
    const demoLoginBtn = document.querySelector('.demo-login-btn');
    if (demoLoginBtn) {
      demoLoginBtn.addEventListener('click', () => {
        document.getElementById('CustomerEmail').value = 'demo@lumierebeauty.com';
        document.getElementById('CustomerPassword').value = '12345678';
        demoLoginBtn.innerText = '✓ Demo Bilgileri Dolduruldu';
      });
    }

    // --- SMART SCROLL HIDE/SHOW HEADER ---
    let lastScrollY = window.scrollY;
    const headerEl = document.querySelector('.theme-header');

    if (headerEl) {
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;

        if (currentScrollY <= 80) {
          headerEl.classList.remove('header-hidden');
        } else if (currentScrollY > lastScrollY && currentScrollY > 160) {
          headerEl.classList.add('header-hidden');
        } else if (currentScrollY < lastScrollY - 6) {
          headerEl.classList.remove('header-hidden');
        }

        lastScrollY = currentScrollY;
      }, { passive: true });
    }
  });
</script>

