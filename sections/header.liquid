    {
      "type": "image_picker",
      "id": "logo",
      "label": "Özel Logo Görseli"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Marka Adı (Metin Logo)",
      "default": "LUMIÈRE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Gezinti Menüsü"
