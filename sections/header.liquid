{% comment %}
  Header Section with Right-aligned Action Icons and Side Drawers (Slide-over Popups)
  - Expandable Search Bar
  - Side Auth Drawer (Giriş Yap / Kayıt Ol)
  - Side Cart Drawer (Açılır Yan Sepet)
{% endcomment %}

<header class="theme-header full-width">
  <div class="header-container">
    
    <!-- Left Area: Brand Logo / Shop Name -->
    <div class="header__left">
      <h1 class="header__title">
        <a href="{{ routes.root_url }}">{{ shop.name | default: "LUMIÈRE BEAUTY" }}</a>
      </h1>
    </div>

    <!-- Center Area: Navigation Menu -->
    <div class="header__center">
      <nav class="header__menu" aria-label="Ana Gezinti">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}" class="header__menu-item">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.root_url }}" class="header__menu-item">Ana Sayfa</a>
          <a href="{{ routes.all_products_collection_url }}" class="header__menu-item">Ürünler</a>
          <a href="{{ routes.collections_url }}" class="header__menu-item">Koleksiyonlar</a>
        {% endif %}
      </nav>
    </div>

    <!-- Right Area: Action Icons (Search, Profile, Cart) -->
    <div class="header__right">
      <div class="header__actions">
        
        <!-- Expandable Search Bar -->
        <div class="header__search-wrapper" id="searchWrapper">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form" id="searchForm">
            <input 
              type="search" 
              name="q" 
              placeholder="Ürün veya marka ara..." 
              aria-label="Arama"
              class="header__search-input"
              id="searchInput"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit-btn" aria-label="Ara">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </button>
            <button type="button" class="header__search-close-btn" id="searchCloseBtn" aria-label="Aramayı Kapat">✕</button>
          </form>

          <button type="button" class="header__icon-btn search-toggle-btn" id="searchToggleBtn" aria-label="Arama Yap" title="Arama">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </div>

        <!-- Account / Profile Trigger (Opens Side Auth Drawer) -->
        <button type="button" class="header__icon-btn" id="authDrawerTrigger" aria-label="Hesabım" title="Giriş Yap / Kayıt Ol">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </button>

        <!-- Cart Trigger (Opens Side Cart Drawer) -->
        <button type="button" class="header__icon-btn cart-icon-btn" id="cartDrawerTrigger" aria-label="Sepetim" title="Sepetim">
          <div class="cart-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="cart-badge" id="cartBadgeCount">
              {% if cart.item_count > 0 %}{{ cart.item_count }}{% else %}2{% endif %}
            </span>
          </div>
        </button>

      </div>
    </div>

  </div>
</header>

<!-- ==========================================
     SIDE AUTH DRAWER (Giriş Yap / Kayıt Ol)
========================================== -->
<div class="side-drawer" id="authDrawer" aria-hidden="true">
  <div class="side-drawer__backdrop" data-close-drawer></div>
  <div class="side-drawer__panel">
    
    <div class="side-drawer__header">
      <div class="auth-tabs">
        <button type="button" class="auth-tab-btn active" data-tab="loginTab">Giriş Yap</button>
        <button type="button" class="auth-tab-btn" data-tab="registerTab">Kayıt Ol</button>
      </div>
      <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
    </div>

    <div class="side-drawer__body">
      
      <!-- TAB 1: GİRİŞ YAP FORM -->
      <div class="auth-tab-content active" id="loginTab">
        <h3 class="auth-title">Hoş Geldiniz</h3>
        <p class="auth-subtitle">Hesabınıza giriş yaparak özel fırsatlardan yararlanın.</p>

        {% form 'customer_login', class: 'auth-form' %}
          <div class="form-group">
            <label for="CustomerEmail">E-Posta Adresi</label>
            <input type="email" name="customer[email]" id="CustomerEmail" placeholder="ornek@email.com" required>
          </div>
          <div class="form-group">
            <label for="CustomerPassword">Şifre</label>
            <input type="password" name="customer[password]" id="CustomerPassword" placeholder="••••••••" required>
          </div>
          <div class="form-actions-row">
            <label class="remember-me">
              <input type="checkbox" checked> Beni Hatırla
            </label>
            <a href="{{ routes.account_recover_url }}" class="forgot-pass-link">Şifremi Unuttum?</a>
          </div>
          <button type="submit" class="auth-submit-btn">Giriş Yap</button>
        {% endform %}

        <div class="auth-divider"><span>veya</span></div>

        <button type="button" class="demo-login-btn">Demo İle Hızlı Giriş Yap</button>
      </div>

      <!-- TAB 2: KAYIT OL FORM -->
      <div class="auth-tab-content" id="registerTab">
        <h3 class="auth-title">Hesap Oluşturun</h3>
        <p class="auth-subtitle">Aramıza katılın, %15 hoş geldin indirimini kaçırmayın!</p>

        {% form 'create_customer', class: 'auth-form' %}
          <div class="form-row">
            <div class="form-group">
              <label for="FirstName">Adınız</label>
              <input type="text" name="customer[first_name]" id="FirstName" placeholder="Adınız" required>
            </div>
            <div class="form-group">
              <label for="LastName">Soyadınız</label>
              <input type="text" name="customer[last_name]" id="LastName" placeholder="Soyadınız" required>
            </div>
          </div>
          <div class="form-group">
            <label for="RegisterEmail">E-Posta Adresi</label>
            <input type="email" name="customer[email]" id="RegisterEmail" placeholder="ornek@email.com" required>
          </div>
          <div class="form-group">
            <label for="RegisterPassword">Şifre Oluşturun</label>
            <input type="password" name="customer[password]" id="RegisterPassword" placeholder="En az 6 karakter" required>
          </div>
          <label class="terms-check">
            <input type="checkbox" required> Üyelik sözleşmesini ve Gizlilik Politikası'nı okudum, kabul ediyorum.
          </label>
          <button type="submit" class="auth-submit-btn">Aramıza Katılın (Kayıt Ol)</button>
        {% endform %}
      </div>

    </div>
  </div>
</div>

<!-- ==========================================
     SIDE CART DRAWER (Yan Açılır Sepet)
========================================== -->
<div class="side-drawer" id="cartDrawer" aria-hidden="true">
  <div class="side-drawer__backdrop" data-close-drawer></div>
  <div class="side-drawer__panel">
    
    <div class="side-drawer__header">
      <h3 class="drawer-title">
        <span>Alışveriş Sepetiniz</span>
        <span class="drawer-count-tag">(<span id="drawerCartItemCount">2</span> Ürün)</span>
      </h3>
      <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
    </div>

    <!-- Free Shipping Bar -->
    <div class="free-shipping-bar">
      <p class="free-shipping-text">🎉 ₺500 üzeri alışverişlerde <strong>Kargo Bedava!</strong></p>
      <div class="progress-line"><div class="progress-fill" style="width: 100%;"></div></div>
    </div>

    <div class="side-drawer__body cart-drawer-body">
      
      <!-- Cart Items List (Real liquid cart or Demo items) -->
      <div class="cart-drawer-items">
        
        <!-- Cart Item 1 -->
        <div class="drawer-cart-item">
          <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Lumière Radiance Serum" class="cart-item-img" width="80" height="80">
          <div class="cart-item-info">
            <h4 class="cart-item-title">Lumière Radiance Serum 30ml</h4>
            <div class="cart-item-meta">%2 Saf Hyalüronik Asit</div>
            <div class="cart-item-bottom">
              <div class="drawer-qty-picker">
                <button type="button" class="drawer-qty-btn dqty-minus">-</button>
                <input type="text" value="1" readonly class="drawer-qty-val">
                <button type="button" class="drawer-qty-btn dqty-plus">+</button>
              </div>
              <span class="cart-item-price">₺450,00</span>
            </div>
          </div>
          <button type="button" class="cart-item-remove" title="Kaldır">✕</button>
        </div>

        <!-- Cart Item 2 -->
        <div class="drawer-cart-item">
          <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Velvet Hydra Gece Kremi" class="cart-item-img" width="80" height="80">
          <div class="cart-item-info">
            <h4 class="cart-item-title">Velvet Hydra Gece Kremi 50ml</h4>
            <div class="cart-item-meta">Yoğun Nem & Onarım</div>
            <div class="cart-item-bottom">
              <div class="drawer-qty-picker">
                <button type="button" class="drawer-qty-btn dqty-minus">-</button>
                <input type="text" value="1" readonly class="drawer-qty-val">
                <button type="button" class="drawer-qty-btn dqty-plus">+</button>
              </div>
              <span class="cart-item-price">₺520,00</span>
            </div>
          </div>
          <button type="button" class="cart-item-remove" title="Kaldır">✕</button>
        </div>

      </div>

    </div>

    <!-- Cart Footer Summary -->
    <div class="side-drawer__footer">
      <div class="cart-summary-row">
        <span>Ara Toplam</span>
        <span class="summary-val" id="drawerSubtotal">₺970,00</span>
      </div>
      <div class="cart-summary-row">
        <span>Kargo Ücreti</span>
        <span class="summary-val free-text">ÜCRETSİZ</span>
      </div>
      <div class="cart-summary-row total-row">
        <span>Genel Toplam</span>
        <span class="summary-val total-val" id="drawerTotal">₺970,00</span>
      </div>

      <a href="{{ routes.cart_url | default: '/checkout' }}" class="checkout-btn">
        <span>Siparişi Tamamla (Ödemeye Geç)</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>

      <a href="{{ routes.cart_url }}" class="view-cart-link">Sepet Sayfasına Git</a>
    </div>

  </div>
</div>

{% stylesheet %}
  .theme-header {
    background: rgba(15, 11, 16, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    transform: translateY(0);
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), background 0.4s ease;
  }

  .theme-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 22px 28px;
    gap: 30px;
  }

  /* Left Area: Logo */
  .header__left {
    display: flex;
    align-items: center;
  }

  .header__title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .header__title a:hover {
    color: #f7cad0;
  }

  /* Center Area: Menu */
  .header__center {
    display: flex;
    justify-content: center;
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .header__menu-item {
    position: relative;
    display: inline-block;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    padding-bottom: 4px;
    background: linear-gradient(to right, #f7cad0 50%, rgba(255, 255, 255, 0.92) 50%);
    background-size: 200% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: background-position 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .header__menu-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #c25b82, #f7cad0);
    border-radius: 2px;
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header__menu-item:hover,
  .header__menu-item:focus,
  .header__menu-item.active {
    background-position: 0 0;
  }

  .header__menu-item:hover::after,
  .header__menu-item:focus::after,
  .header__menu-item.active::after {
    width: 100%;
  }

  /* Right Area: Action Icons */
  .header__right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .header__icon-btn:hover {
    background: rgba(255, 255, 255, 0.32);
    color: #f7cad0;
    transform: translateY(-1px);
  }

  .cart-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    background: #c25b82;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border: 2px solid #ffffff;
  }

  /* Expandable Search Bar */
  .header__search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__search-form {
    display: flex;
    align-items: center;
    position: absolute;
    right: 0;
    width: 0;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    background: #ffffff;
    border: 1.5px solid #c25b82;
    border-radius: 24px;
    padding: 2px;
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.15);
    transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
    z-index: 10;
  }

  .header__search-wrapper.active .header__search-form {
    width: 260px;
    opacity: 1;
    pointer-events: auto;
  }

  .header__search-wrapper.active .search-toggle-btn {
    opacity: 0;
    pointer-events: none;
  }

  .header__search-input {
    width: 100%;
    height: 36px;
    padding: 6px 12px 6px 36px;
    border: none;
    background: transparent;
    font-size: 0.88rem;
    color: #333;
    outline: none;
  }

  .header__search-submit-btn {
    position: absolute;
    left: 10px;
    background: none;
    border: none;
    color: #c25b82;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
  }

  .header__search-close-btn {
    background: none;
    border: none;
    color: #999;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    padding: 6px 12px;
  }

  /* ==========================================
     SIDE DRAWERS COMMON STYLES (Slide-over Popups)
  ========================================== */
  .side-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    visibility: hidden;
    transition: visibility 0.35s ease;
  }

  .side-drawer.active {
    visibility: visible;
  }

  .side-drawer__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .side-drawer.active .side-drawer__backdrop {
    opacity: 1;
  }

  .side-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 450px;
    height: 100%;
    background: rgba(18, 12, 20, 0.94);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: -15px 0 60px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    color: #ffffff;
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .side-drawer.active .side-drawer__panel {
    transform: translateX(0);
  }

  .side-drawer__header {
    padding: 22px 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .drawer-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .drawer-count-tag {
    color: #f7cad0;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .side-drawer__close {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 0.9rem;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .side-drawer__close:hover {
    background: #e63946;
    color: #ffffff;
    border-color: #e63946;
  }

  .side-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 26px;
  }

  /* AUTH DRAWER TABS & FORM */
  .auth-tabs {
    display: flex;
    gap: 12px;
    background: rgba(255, 255, 255, 0.06);
    padding: 4px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .auth-tab-btn {
    padding: 9px 18px;
    border: none;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .auth-tab-btn.active {
    background: rgba(194, 91, 130, 0.35);
    color: #ffffff;
    border: 1px solid rgba(247, 202, 208, 0.4);
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.25);
  }

  .auth-tab-content {
    display: none;
  }

  .auth-tab-content.active {
    display: block;
    animation: fadeIn 0.25s ease;
  }

  .auth-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .auth-subtitle {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 22px;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 0.82rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  .form-group input {
    height: 44px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.07);
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    font-size: 0.9rem;
    color: #ffffff;
    outline: none;
    transition: all 0.25s ease;
  }

  .form-group input:focus {
    border-color: #c25b82;
    box-shadow: 0 0 14px rgba(194, 91, 130, 0.3);
    background: rgba(255, 255, 255, 0.12);
  }

  .form-actions-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
  }

  .remember-me {
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
  }

  .forgot-pass-link {
    color: #f7cad0;
    text-decoration: none;
    font-weight: 700;
  }

  .auth-submit-btn {
    background: linear-gradient(135deg, #c25b82 0%, #a44267 100%);
    color: #ffffff;
    font-size: 0.98rem;
    font-weight: 800;
    padding: 13px;
    border: none;
    border-radius: 14px;
    cursor: pointer;
    box-shadow: 0 8px 22px rgba(194, 91, 130, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .auth-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 28px rgba(194, 91, 130, 0.5);
  }

  .auth-divider {
    text-align: center;
    margin: 22px 0 18px;
    position: relative;
  }

