        { "type": "text", "id": "title", "label": "Başlık Metni", "default": "Alışveriş Sepetiniz" },
        { "type": "color", "id": "title_color", "label": "Metin Rengi", "default": "#ffffff" },
        { "type": "checkbox", "id": "show_count", "label": "Ürün Sayacı Gösterilsin mi?", "default": true }
