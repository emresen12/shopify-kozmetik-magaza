{% comment %}
  Header Section with Right-aligned Action Icons and Side Drawers (Slide-over Popups)
  - Expandable Search Bar
  - Side Auth Drawer (Giriş Yap / Kayıt Ol)
  - Interactive Dynamic Side Cart Drawer (Açılır Yan Sepet & Realtime Add To Cart Engine)
{% endcomment %}

<header class="theme-header full-width">
  <div class="header-container">
    
    <!-- Left Area: Brand Logo / Shop Name & 3-Line Hamburger Menu Icon -->
    <div class="header__left">
      <button type="button" class="header__icon-btn menu-drawer-toggle-btn" id="navDrawerTrigger" aria-label="Menüyü Aç" title="Menü">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <h1 class="header__title">
        <a href="{{ routes.root_url }}">{{ shop.name | default: "EMRE ŞEN" }}</a>
      </h1>
    </div>

    <!-- Center Area: Navigation Menu -->
    <div class="header__center">
      <nav class="header__menu" aria-label="Ana Gezinti">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}" class="header__menu-item">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.root_url }}" class="header__menu-item">Ana Sayfa</a>
          <a href="{{ routes.all_products_collection_url }}" class="header__menu-item">Ürünler</a>
          <a href="{{ routes.collections_url }}" class="header__menu-item">Koleksiyonlar</a>
        {% endif %}
      </nav>
    </div>

    <!-- Right Area: Action Icons (Search, Profile, Cart) -->
    <div class="header__right">
      <div class="header__actions">
        
        <!-- Expandable Search Bar -->
        <div class="header__search-wrapper" id="searchWrapper">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form" id="searchForm">
            <input 
              type="search" 
              name="q" 
              placeholder="Ürün veya marka ara..." 
              aria-label="Arama"
              class="header__search-input"
              id="searchInput"
              autocomplete="off"
            >
            <button type="submit" class="header__search-submit-btn" aria-label="Ara">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
            </button>
            <button type="button" class="header__search-close-btn" id="searchCloseBtn" aria-label="Aramayı Kapat">✕</button>
          </form>

          <button type="button" class="header__icon-btn search-toggle-btn" id="searchToggleBtn" aria-label="Arama Yap" title="Arama">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </div>

        <!-- Account / Profile Trigger (Opens Side Auth Drawer) -->
        <button type="button" class="header__icon-btn" id="authDrawerTrigger" aria-label="Hesabım" title="Giriş Yap / Kayıt Ol">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </button>

        <!-- Cart Trigger (Opens Side Cart Drawer) -->
        <button type="button" class="header__icon-btn cart-icon-btn" id="cartDrawerTrigger" aria-label="Sepetim" title="Sepetim">
          <div class="cart-icon-wrapper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="cart-badge" id="cartBadgeCount">{{ cart.item_count }}</span>
          </div>
        </button>

      </div>
    </div>

  </div>
</header>

<!-- ==========================================
     SIDE NAV MENU DRAWER (3 Çizgili Yan Açılır Menü)
========================================== -->
<div class="side-drawer" id="navDrawer" aria-hidden="true">
  <div class="side-drawer__backdrop" data-close-drawer></div>
  <div class="side-drawer__panel nav-drawer-panel">
    
    {% assign b_n_head = section.blocks | where: "type", "drawer_nav_header" %}
    {% assign b_n_link = section.blocks | where: "type", "drawer_nav_link" %}
    {% assign b_n_menu = section.blocks | where: "type", "drawer_nav_menu" %}
    {% assign b_n_acc  = section.blocks | where: "type", "drawer_nav_account" %}
    {% assign b_n_crt  = section.blocks | where: "type", "drawer_nav_cart" %}
    {% assign b_n_acts = section.blocks | where: "type", "drawer_nav_actions" %}
    {% assign b_n_prm  = section.blocks | where: "type", "drawer_nav_promo" %}
    {% assign nav_blocks_size = b_n_head.size | plus: b_n_link.size | plus: b_n_menu.size | plus: b_n_acc.size | plus: b_n_crt.size | plus: b_n_acts.size | plus: b_n_prm.size %}

    {% if nav_blocks_size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}
          
          {% when 'drawer_nav_header' %}
            <div class="side-drawer__header" {{ block.shopify_attributes }}>
              <h3 class="drawer-title" style="color: {{ block.settings.title_color | default: '#ffffff' }};">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
                <span>{{ block.settings.title | default: "Menü" }}</span>
              </h3>
              <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
            </div>

          {% when 'drawer_nav_link' %}
            <div class="nav-drawer-single-link-wrapper" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.url | default: '#' }}" class="nav-drawer-link-item">
                <span class="link-bullet">{{ block.settings.icon | default: "✦" }}</span>
                <span>{{ block.settings.title | default: "Sayfa Linki" }}</span>
              </a>
            </div>

          {% when 'drawer_nav_menu' %}
            <div class="side-drawer__body nav-drawer-body" {{ block.shopify_attributes }}>
              <nav class="nav-drawer-links-wrapper">
                {% assign nav_linklist_handle = block.settings.menu | default: section.settings.menu %}
                {% if nav_linklist_handle != blank and linklists[nav_linklist_handle].links.size > 0 %}
                  {% for link in linklists[nav_linklist_handle].links %}
                    <a href="{{ link.url }}" class="nav-drawer-link-item {% if link.active %}active{% endif %}">
                      <span class="link-bullet">✦</span>
                      <span>{{ link.title }}</span>
                    </a>
                  {% endfor %}
                {% else %}
                  <a href="{{ routes.root_url }}" class="nav-drawer-link-item active">
                    <span class="link-bullet">✦</span>
                    <span>Ana Sayfa</span>
                  </a>
                  <a href="{{ routes.all_products_collection_url }}" class="nav-drawer-link-item">
                    <span class="link-bullet">✦</span>
                    <span>Ürünler</span>
                  </a>
                  <a href="{{ routes.collections_url }}" class="nav-drawer-link-item">
                    <span class="link-bullet">✦</span>
                    <span>Katalog / Koleksiyonlar</span>
                  </a>
                {% endif %}
              </nav>
            </div>

          {% when 'drawer_nav_account' %}
            <div class="nav-drawer-action-single" {{ block.shopify_attributes }}>
              <button type="button" class="nav-action-btn account-action-btn" id="navDrawerAuthBtn" style="
                --btn-bg: {{ block.settings.btn_bg | default: 'rgba(255, 255, 255, 0.05)' }};
                --btn-border: {{ block.settings.btn_border | default: 'rgba(255, 255, 255, 0.12)' }};
                --btn-color: {{ block.settings.btn_color | default: '#ffffff' }};
              ">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>{{ block.settings.label | default: "Hesabım" }}</span>
              </button>
            </div>

          {% when 'drawer_nav_cart' %}
            <div class="nav-drawer-action-single" {{ block.shopify_attributes }}>
              <button type="button" class="nav-action-btn cart-action-btn" id="navDrawerCartBtn" style="
                --btn-bg: {{ block.settings.btn_bg | default: 'rgba(255, 255, 255, 0.05)' }};
                --btn-border: {{ block.settings.btn_border | default: 'rgba(255, 255, 255, 0.12)' }};
                --btn-color: {{ block.settings.btn_color | default: '#ffffff' }};
              ">
                <div class="nav-cart-icon-wrap">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  <span class="nav-cart-count">{{ cart.item_count }}</span>
                </div>
                <span>{{ block.settings.label | default: "Sepetim" }}</span>
              </button>
            </div>

          {% when 'drawer_nav_actions' %}
            <div class="nav-drawer-actions-wrapper" style="
              --btn-bg: {{ block.settings.btn_bg | default: 'rgba(255, 255, 255, 0.05)' }};
              --btn-border: {{ block.settings.btn_border | default: 'rgba(255, 255, 255, 0.12)' }};
              --btn-color: {{ block.settings.btn_text_color | default: '#ffffff' }};
            " {{ block.shopify_attributes }}>
              <button type="button" class="nav-action-btn account-action-btn" id="navDrawerAuthBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>{{ block.settings.account_label | default: "Hesabım" }}</span>
              </button>

              <button type="button" class="nav-action-btn cart-action-btn" id="navDrawerCartBtn">
                <div class="nav-cart-icon-wrap">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  <span class="nav-cart-count">{{ cart.item_count }}</span>
                </div>
                <span>{{ block.settings.cart_label | default: "Sepetim" }}</span>
              </button>
            </div>

          {% when 'drawer_nav_promo' %}
            <div class="nav-drawer-promo-card" style="
              background: {{ block.settings.bg_color | default: 'rgba(194, 91, 130, 0.15)' }};
              border: 1px solid {{ block.settings.border_color | default: '#f7cad0' }};
            " {{ block.shopify_attributes }}>
              <span class="promo-icon">{{ block.settings.icon | default: "✨" }}</span>
              <p class="promo-text">{{ block.settings.text | default: "Özel Teklifler ve Yeni Ürünleri Keşfedin" }}</p>
            </div>

        {% endcase %}
      {% endfor %}

    {% else %}
      <!-- Fallback when no blocks added -->
      <div class="side-drawer__header">
        <h3 class="drawer-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span>Menü</span>
        </h3>
        <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
      </div>

      <div class="side-drawer__body nav-drawer-body">
        <nav class="nav-drawer-links-wrapper">
          <a href="{{ routes.root_url }}" class="nav-drawer-link-item active">
            <span class="link-bullet">✦</span>
            <span>Ana Sayfa</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="nav-drawer-link-item">
            <span class="link-bullet">✦</span>
            <span>Ürünler</span>
          </a>
          <a href="{{ routes.collections_url }}" class="nav-drawer-link-item">
            <span class="link-bullet">✦</span>
            <span>Katalog</span>
          </a>
        </nav>
      </div>

      <div class="nav-drawer-actions-wrapper">
        <button type="button" class="nav-action-btn account-action-btn" id="navDrawerAuthBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span>Hesabım</span>
        </button>

        <button type="button" class="nav-action-btn cart-action-btn" id="navDrawerCartBtn">
          <div class="nav-cart-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="nav-cart-count">{{ cart.item_count }}</span>
          </div>
          <span>Sepetim</span>
        </button>
      </div>
    {% endif %}

  </div>
</div>

<!-- ==========================================
     SIDE AUTH DRAWER (Giriş Yap / Kayıt Ol Yan Açılır Penceresi)
========================================== -->
<div class="side-drawer" id="authDrawer" aria-hidden="true">
  <div class="side-drawer__backdrop" data-close-drawer></div>
  <div class="side-drawer__panel">
    
    {% assign b_a_head = section.blocks | where: "type", "drawer_auth_header" %}
    {% assign b_a_welc = section.blocks | where: "type", "drawer_auth_welcome" %}
    {% assign b_a_tabs = section.blocks | where: "type", "drawer_auth_tabs" %}
    {% assign b_a_log  = section.blocks | where: "type", "drawer_auth_login" %}
    {% assign b_a_reg  = section.blocks | where: "type", "drawer_auth_register" %}
    {% assign b_a_demo = section.blocks | where: "type", "drawer_auth_demo" %}
    {% assign b_a_trst = section.blocks | where: "type", "drawer_auth_trust" %}
    {% assign auth_blocks_size = b_a_head.size | plus: b_a_welc.size | plus: b_a_tabs.size | plus: b_a_log.size | plus: b_a_reg.size | plus: b_a_demo.size | plus: b_a_trst.size %}

    {% if auth_blocks_size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'drawer_auth_header' %}
            <div class="side-drawer__header" {{ block.shopify_attributes }}>
              <h3 class="drawer-title" style="color: {{ block.settings.title_color | default: '#ffffff' }};">
                <span>{{ block.settings.title | default: "Hesap İşlemleri" }}</span>
              </h3>
              <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
            </div>

          {% when 'drawer_auth_welcome' %}
            <div class="drawer-auth-welcome-block" style="
              background: {{ block.settings.bg_color | default: '#1a0d18' }};
              border: 1px solid {{ block.settings.border_color | default: '#3d1f35' }};
            " {{ block.shopify_attributes }}>
              <span class="auth-welcome-icon">{{ block.settings.icon | default: "💎" }}</span>
              <p class="auth-welcome-text" style="color: {{ block.settings.text_color | default: '#f7cad0' }};">
                {{ block.settings.text | default: "Üye olun, ilk alışverişinizde %10 indirim ve 500 Hoş Geldin Puanı kazanın!" }}
              </p>
            </div>

          {% when 'drawer_auth_tabs' %}
            <div class="auth-tabs" {{ block.shopify_attributes }}>
              <button type="button" class="auth-tab-btn active" data-tab="loginTab">{{ block.settings.tab_1_label | default: "Giriş Yap" }}</button>
              <button type="button" class="auth-tab-btn" data-tab="registerTab">{{ block.settings.tab_2_label | default: "Kayıt Ol" }}</button>
            </div>

          {% when 'drawer_auth_login' %}
            <div class="side-drawer__body auth-drawer-body-login" {{ block.shopify_attributes }}>
              <div class="auth-tab-content active" id="loginTab">
                {% form 'customer_login', class: 'auth-form' %}
                  <div class="form-group">
                    <label for="CustomerEmail">{{ block.settings.email_label | default: "E-Posta Adresi" }}</label>
                    <input type="email" name="customer[email]" id="CustomerEmail" placeholder="{{ block.settings.email_placeholder | default: 'ornek@email.com' }}" required>
                  </div>
                  <div class="form-group">
                    <label for="CustomerPassword">{{ block.settings.password_label | default: "Şifre" }}</label>
                    <input type="password" name="customer[password]" id="CustomerPassword" placeholder="••••••••" required>
                  </div>
                  <div class="auth-forgot-row">
                    <a href="#recover" class="forgot-link">{{ block.settings.forgot_text | default: "Şifremi Unuttum" }}</a>
                  </div>
                  <button type="submit" class="auth-submit-btn" style="
                    background: linear-gradient(135deg, {{ block.settings.bg_gradient_start | default: '#c25b82' }} 0%, {{ block.settings.bg_gradient_end | default: '#a24367' }} 100%);
                    color: {{ block.settings.text_color | default: '#ffffff' }};
                  ">
                    {{ block.settings.submit_text | default: "Giriş Yap" }}
                  </button>
                {% endform %}
              </div>
            </div>

          {% when 'drawer_auth_register' %}
            <div class="side-drawer__body auth-drawer-body-register" {{ block.shopify_attributes }}>
              <div class="auth-tab-content" id="registerTab">
                {% form 'create_customer', class: 'auth-form' %}
                  <div class="form-row">
                    <div class="form-group">
                      <label for="FirstName">{{ block.settings.first_name_label | default: "Adınız" }}</label>
                      <input type="text" name="customer[first_name]" id="FirstName" placeholder="{{ block.settings.first_name_label | default: 'Adınız' }}" required>
                    </div>
                    <div class="form-group">
                      <label for="LastName">{{ block.settings.last_name_label | default: "Soyadınız" }}</label>
                      <input type="text" name="customer[last_name]" id="LastName" placeholder="{{ block.settings.last_name_label | default: 'Soyadınız' }}" required>
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="RegisterEmail">{{ block.settings.email_label | default: "E-Posta Adresi" }}</label>
                    <input type="email" name="customer[email]" id="RegisterEmail" placeholder="ornek@email.com" required>
                  </div>
                  <div class="form-group">
                    <label for="RegisterPassword">{{ block.settings.password_label | default: "Şifre Oluşturun" }}</label>
                    <input type="password" name="customer[password]" id="RegisterPassword" placeholder="En az 6 karakter" required>
                  </div>
                  <label class="terms-check">
                    <input type="checkbox" required> {{ block.settings.terms_text | default: "Üyelik sözleşmesini kabul ediyorum." }}
                  </label>
                  <button type="submit" class="auth-submit-btn" style="
                    background: linear-gradient(135deg, {{ block.settings.bg_gradient_start | default: '#c25b82' }} 0%, {{ block.settings.bg_gradient_end | default: '#a24367' }} 100%);
                    color: {{ block.settings.text_color | default: '#ffffff' }};
                  ">
                    {{ block.settings.submit_text | default: "Kayıt Ol" }}
                  </button>
                {% endform %}
              </div>
            </div>

          {% when 'drawer_auth_demo' %}
            <div class="demo-login-box" style="background: {{ block.settings.bg_color | default: '#151019' }};" {{ block.shopify_attributes }}>
              <p class="demo-login-text">{{ block.settings.title | default: "💡 Hızlı Deneme İçin:" }}</p>
              <button type="button" class="demo-login-btn">{{ block.settings.button_text | default: "Demo Üye Bilgilerini Doldur" }}</button>
            </div>

          {% when 'drawer_auth_trust' %}
            <div class="drawer-trust-badges-block" style="background: {{ block.settings.bg_color | default: '#120d15' }};" {{ block.shopify_attributes }}>
              <div class="trust-badge-item">🔒 <span>{{ block.settings.badge_1 | default: "256-Bit SSL Koruma" }}</span></div>
              <div class="trust-badge-item">💎 <span>{{ block.settings.badge_2 | default: "VIP Ayrıcalıklar" }}</span></div>
              <div class="trust-badge-item">⚡ <span>{{ block.settings.badge_3 | default: "Hızlı Üyelik" }}</span></div>
            </div>

        {% endcase %}
      {% endfor %}

    {% else %}

      <!-- DEFAULT FALLBACK AUTH DRAWER -->
      <div class="side-drawer__header">
        <h3 class="drawer-title">Hesap İşlemleri</h3>
        <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
      </div>

      <div class="auth-tabs">
        <button type="button" class="auth-tab-btn active" data-tab="loginTab">Giriş Yap</button>
        <button type="button" class="auth-tab-btn" data-tab="registerTab">Kayıt Ol</button>
      </div>

      <div class="side-drawer__body">
        
        <!-- LOGIN TAB CONTENT -->
        <div class="auth-tab-content active" id="loginTab">
          {% form 'customer_login', class: 'auth-form' %}
            <div class="form-group">
              <label for="CustomerEmail">E-Posta Adresi</label>
              <input type="email" name="customer[email]" id="CustomerEmail" placeholder="ornek@email.com" required>
            </div>
            <div class="form-group">
              <label for="CustomerPassword">Şifre</label>
              <input type="password" name="customer[password]" id="CustomerPassword" placeholder="••••••••" required>
            </div>
            <div class="auth-forgot-row">
              <a href="#recover" class="forgot-link">Şifremi Unuttum</a>
            </div>
            <button type="submit" class="auth-submit-btn">Giriş Yap</button>
          {% endform %}
          
          <div class="demo-login-box">
            <p class="demo-login-text">💡 Hızlı Deneme İçin:</p>
            <button type="button" class="demo-login-btn">Demo Üye Bilgilerini Doldur</button>
          </div>
        </div>

        <!-- REGISTER TAB CONTENT -->
        <div class="auth-tab-content" id="registerTab">
          {% form 'create_customer', class: 'auth-form' %}
            <div class="form-row">
              <div class="form-group">
                <label for="FirstName">Adınız</label>
                <input type="text" name="customer[first_name]" id="FirstName" placeholder="Adınız" required>
              </div>
              <div class="form-group">
                <label for="LastName">Soyadınız</label>
                <input type="text" name="customer[last_name]" id="LastName" placeholder="Soyadınız" required>
              </div>
            </div>
            <div class="form-group">
              <label for="RegisterEmail">E-Posta Adresi</label>
              <input type="email" name="customer[email]" id="RegisterEmail" placeholder="ornek@email.com" required>
            </div>
            <div class="form-group">
              <label for="RegisterPassword">Şifre Oluşturun</label>
              <input type="password" name="customer[password]" id="RegisterPassword" placeholder="En az 6 karakter" required>
            </div>
            <label class="terms-check">
              <input type="checkbox" required> Üyelik sözleşmesini kabul ediyorum.
            </label>
            <button type="submit" class="auth-submit-btn">Kayıt Ol</button>
          {% endform %}
        </div>

      </div>

    {% endif %}

  </div>
</div>

<!-- ==========================================
     SIDE CART DRAWER (Yan Açılır Dinamik Sepet)
========================================== -->
<div class="side-drawer" id="cartDrawer" aria-hidden="true">
  <div class="side-drawer__backdrop" data-close-drawer></div>
  <div class="side-drawer__panel">
    
    {% assign b_header = section.blocks | where: "type", "drawer_cart_header" %}
    {% assign b_ship = section.blocks | where: "type", "drawer_shipping_bar" %}
    {% assign b_items = section.blocks | where: "type", "drawer_cart_items" %}
    {% assign b_empty = section.blocks | where: "type", "drawer_empty_cart" %}
    {% assign b_note = section.blocks | where: "type", "drawer_cart_note" %}
    {% assign b_disc = section.blocks | where: "type", "drawer_discount_box" %}
    {% assign b_subtotal = section.blocks | where: "type", "drawer_subtotal" %}
    {% assign b_checkout = section.blocks | where: "type", "drawer_checkout_btn" %}
    {% assign b_view = section.blocks | where: "type", "drawer_view_cart_link" %}
    {% assign b_trust = section.blocks | where: "type", "drawer_trust_badges" %}
    {% assign b_promo = section.blocks | where: "type", "drawer_promo_announcement" %}
    {% assign cart_blocks_size = b_header.size | plus: b_ship.size | plus: b_items.size | plus: b_empty.size | plus: b_note.size | plus: b_disc.size | plus: b_subtotal.size | plus: b_checkout.size | plus: b_view.size | plus: b_trust.size | plus: b_promo.size %}

    {% if cart_blocks_size > 0 %}
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'drawer_cart_header' %}
            <div class="side-drawer__header" {{ block.shopify_attributes }}>
              <h3 class="drawer-title" style="color: {{ block.settings.title_color }};">
                <span>{{ block.settings.title | default: "Alışveriş Sepetiniz" }}</span>
                {% if block.settings.show_count %}
                  <span class="drawer-count-tag">(<span id="drawerCartItemCount">{{ cart.item_count }}</span> Ürün)</span>
                {% endif %}
              </h3>
              <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
            </div>

          {% when 'drawer_shipping_bar' %}
            <div class="free-shipping-bar" style="background: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
              <p class="free-shipping-text" id="freeShippingText" style="color: {{ block.settings.text_color }};">
                {{ block.settings.icon }} {{ block.settings.text | default: "₺500 üzeri alışverişlerde Kargo Bedava!" }}
              </p>
              <div class="progress-line"><div class="progress-fill" id="freeShippingProgress" style="width: 0%; background: {{ block.settings.progress_color }};"></div></div>
            </div>

          {% when 'drawer_cart_items' %}
            <div class="side-drawer__body cart-drawer-body" {{ block.shopify_attributes }}>
              <div class="cart-drawer-items" id="cartDrawerItems">
                {% if cart.item_count > 0 %}
                  {% for item in cart.items %}
                    <div class="drawer-cart-item">
                      {% if item.image %}
                        {{ item.image | image_url: width: 160 | image_tag: class: 'cart-item-img', loading: 'lazy' }}
                      {% else %}
                        <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="{{ item.product.title }}" class="cart-item-img" width="80" height="80">
                      {% endif %}
                      <div class="cart-item-info">
                        <h4 class="cart-item-title">{{ item.product.title }}</h4>
                        <div class="cart-item-bottom">
                          <div class="drawer-qty-picker">
                            <button type="button" class="drawer-qty-btn dqty-minus">-</button>
                            <input type="text" value="{{ item.quantity }}" readonly class="drawer-qty-val">
                            <button type="button" class="drawer-qty-btn dqty-plus">+</button>
                          </div>
                          <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                        </div>
                      </div>
                      <button type="button" class="cart-item-remove" title="Kaldır">✕</button>
                    </div>
                  {% endfor %}
                {% else %}
                  <div class="empty-cart-msg" id="emptyCartMsg">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    <h4 class="empty-cart-title">Sepetiniz henüz boş</h4>
                    <p class="empty-cart-subtitle">Seçkin cilt bakım ürünlerimizi keşfetmek için alışverişe başlayın.</p>
                    <a href="{{ routes.all_products_collection_url }}" class="empty-cart-shop-btn">Alışverişe Başla</a>
                  </div>
                {% endif %}
              </div>
            </div>

          {% when 'drawer_cart_note' %}
            <div class="drawer-cart-note-block" {{ block.shopify_attributes }}>
              <details class="cart-note-details">
                <summary class="cart-note-summary">
                  <span>{{ block.settings.label | default: "📝 Sipariş Notu Ekleyin" }}</span>
                </summary>
                <textarea name="note" class="drawer-note-input" placeholder="{{ block.settings.placeholder | default: 'Özel hediye notu veya kargo talimatınız...' }}">{{ cart.note }}</textarea>
              </details>
            </div>

          {% when 'drawer_discount_box' %}
            <div class="drawer-discount-block" {{ block.shopify_attributes }}>
              <div class="discount-input-row">
                <input type="text" class="drawer-discount-input" placeholder="{{ block.settings.placeholder | default: 'İndirim Kodu' }}">
                <button type="button" class="drawer-discount-btn">{{ block.settings.btn_text | default: "Uygula" }}</button>
              </div>
            </div>

          {% when 'drawer_subtotal' %}
            <div class="side-drawer__footer" {{ block.shopify_attributes }}>
              <div class="cart-summary-row">
                <span>{{ block.settings.subtotal_label | default: "Ara Toplam" }}</span>
                <span class="summary-val" id="drawerSubtotal">{{ cart.total_price | money }}</span>
              </div>
              <div class="cart-summary-row">
                <span>{{ block.settings.shipping_label | default: "Kargo Ücreti" }}</span>
                <span class="summary-val free-text">{{ block.settings.free_shipping_label | default: "ÜCRETSİZ" }}</span>
              </div>
              <div class="cart-summary-row total-row">
                <span>{{ block.settings.total_label | default: "Genel Toplam" }}</span>
                <span class="summary-val total-val" id="drawerTotal">{{ cart.total_price | money }}</span>
              </div>
            </div>

          {% when 'drawer_checkout_btn' %}
            <div class="drawer-checkout-block-wrapper" {{ block.shopify_attributes }}>
              <a href="{% if cart.item_count > 0 %}/checkout{% else %}{{ routes.cart_url }}{% endif %}" class="checkout-btn" style="
                background: linear-gradient(135deg, {{ block.settings.bg_gradient_start | default: '#c25b82' }} 0%, {{ block.settings.bg_gradient_end | default: '#a24367' }} 100%);
                color: {{ block.settings.text_color | default: '#ffffff' }};
              ">
                <span>{{ block.settings.text | default: "Siparişi Tamamla (Ödemeye Geç)" }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12" 5 19 12 12 19"/></svg>
              </a>
            </div>

          {% when 'drawer_view_cart_link' %}
            <div class="drawer-view-cart-block-wrapper" {{ block.shopify_attributes }}>
              <a href="{{ routes.cart_url }}" class="view-cart-link" style="color: {{ block.settings.text_color | default: 'rgba(255, 255, 255, 0.6)' }};">
                {{ block.settings.text | default: "Sepet Sayfasına Git" }}
              </a>
            </div>

          {% when 'drawer_trust_badges' %}
            <div class="drawer-trust-badges-block" style="background: {{ block.settings.bg_color | default: 'rgba(255, 255, 255, 0.03)' }};" {{ block.shopify_attributes }}>
              <div class="trust-badge-item">🔒 <span>{{ block.settings.badge_1 | default: "256-Bit SSL Ödeme" }}</span></div>
              <div class="trust-badge-item">⚡ <span>{{ block.settings.badge_2 | default: "24h Hızlı Kargo" }}</span></div>
              <div class="trust-badge-item">↩️ <span>{{ block.settings.badge_3 | default: "Ücretsiz İade" }}</span></div>
            </div>

          {% when 'drawer_promo_announcement' %}
            <div class="drawer-promo-block" style="
              background: {{ block.settings.bg_color | default: 'rgba(194, 91, 130, 0.15)' }};
              border: 1px solid {{ block.settings.border_color | default: 'rgba(247, 202, 208, 0.3)' }};
            " {{ block.shopify_attributes }}>
              <span class="promo-icon">{{ block.settings.icon | default: "🎁" }}</span>
              <p class="promo-text" style="color: {{ block.settings.text_color | default: '#f7cad0' }};">{{ block.settings.text | default: "₺750 üzeri alışverişlerde Nemlendirici Gece Maskesi Hediye!" }}</p>
            </div>

        {% endcase %}
      {% endfor %}

    {% else %}

      <!-- DEFAULT FALLBACK CART DRAWER ITEMS -->
      <div class="side-drawer__header">
        <h3 class="drawer-title">
          <span>Alışveriş Sepetiniz</span>
          <span class="drawer-count-tag">(<span id="drawerCartItemCount">{{ cart.item_count }}</span> Ürün)</span>
        </h3>
        <button type="button" class="side-drawer__close" data-close-drawer aria-label="Kapat">✕</button>
      </div>

      <div class="free-shipping-bar">
        <p class="free-shipping-text" id="freeShippingText">🎉 {{ section.settings.free_shipping_text | default: "₺500 üzeri alışverişlerde Kargo Bedava!" }}</p>
        <div class="progress-line"><div class="progress-fill" id="freeShippingProgress" style="width: 0%;"></div></div>
      </div>

      <div class="side-drawer__body cart-drawer-body">
        <div class="cart-drawer-items" id="cartDrawerItems">
          {% if cart.item_count > 0 %}
            {% for item in cart.items %}
              <div class="drawer-cart-item">
                {% if item.image %}
                  {{ item.image | image_url: width: 160 | image_tag: class: 'cart-item-img', loading: 'lazy' }}
                {% else %}
                  <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="{{ item.product.title }}" class="cart-item-img" width="80" height="80">
                {% endif %}
                <div class="cart-item-info">
                  <h4 class="cart-item-title">{{ item.product.title }}</h4>
                  <div class="cart-item-bottom">
                    <div class="drawer-qty-picker">
                      <button type="button" class="drawer-qty-btn dqty-minus">-</button>
                      <input type="text" value="{{ item.quantity }}" readonly class="drawer-qty-val">
                      <button type="button" class="drawer-qty-btn dqty-plus">+</button>
                    </div>
                    <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                  </div>
                </div>
                <button type="button" class="cart-item-remove" title="Kaldır">✕</button>
              </div>
            {% endfor %}
          {% else %}
            <div class="empty-cart-msg" id="emptyCartMsg">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <h4 class="empty-cart-title">Sepetiniz henüz boş</h4>
              <p class="empty-cart-subtitle">Seçkin cilt bakım ürünlerimizi keşfetmek için alışverişe başlayın.</p>
              <a href="{{ routes.all_products_collection_url }}" class="empty-cart-shop-btn">Alışverişe Başla</a>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="side-drawer__footer">
        <div class="cart-summary-row">
          <span>Ara Toplam</span>
          <span class="summary-val" id="drawerSubtotal">{{ cart.total_price | money }}</span>
        </div>
        <div class="cart-summary-row">
          <span>Kargo Ücreti</span>
          <span class="summary-val free-text">ÜCRETSİZ</span>
        </div>
        <div class="cart-summary-row total-row">
          <span>Genel Toplam</span>
          <span class="summary-val total-val" id="drawerTotal">{{ cart.total_price | money }}</span>
        </div>

        <a href="{% if cart.item_count > 0 %}/checkout{% else %}{{ routes.cart_url }}{% endif %}" class="checkout-btn">
          <span>Siparişi Tamamla (Ödemeye Geç)</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12" 5 19 12 12 19"/></svg>
        </a>

        <a href="{{ routes.cart_url }}" class="view-cart-link">Sepet Sayfasına Git</a>
      </div>

    {% endif %}

  </div>
</div>

{% stylesheet %}
  .theme-header {
    background: rgba(15, 11, 16, 0.72);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    transform: translateY(0);
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1), background 0.4s ease;
  }

  .theme-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 22px 28px;
    gap: 30px;
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-drawer-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    width: 38px;
    height: 38px;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .menu-drawer-toggle-btn:hover {
    background: rgba(194, 91, 130, 0.25);
    border-color: #f7cad0;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.3);
  }

  .nav-drawer-links-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px 0;
  }

  .nav-drawer-link-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-drawer-link-item:hover,
  .nav-drawer-link-item.active {
    background: linear-gradient(135deg, rgba(194, 91, 130, 0.3) 0%, rgba(162, 67, 103, 0.3) 100%);
    border-color: #f7cad0;
    color: #ffffff;
    transform: translateX(4px);
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.25);
  }

  .link-bullet {
    color: #f7cad0;
    font-size: 11px;
    transition: transform 0.2s ease;
  }

  .nav-drawer-link-item:hover .link-bullet {
    transform: scale(1.3);
  }

  .nav-drawer-single-link-wrapper {
    padding: 4px 24px;
  }

  .nav-drawer-action-single {
    padding: 6px 24px;
  }

  .nav-drawer-actions-wrapper {
    padding: 20px 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  .nav-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: 14px;
    background: var(--btn-bg, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--btn-border, rgba(255, 255, 255, 0.12));
    color: var(--btn-color, #ffffff);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    width: 100%;
  }

  .nav-action-btn:hover {
    background: linear-gradient(135deg, rgba(194, 91, 130, 0.35) 0%, rgba(162, 67, 103, 0.35) 100%);
    border-color: #f7cad0;
    box-shadow: 0 6px 18px rgba(194, 91, 130, 0.3);
  }

  .nav-cart-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #c25b82;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 10px;
    border: 1px solid #f7cad0;
  }

  .nav-drawer-promo-card {
    margin: 10px 24px 20px 24px;
    padding: 14px 18px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: #ffffff;
  }

  .header__title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.2s;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .header__title a:hover {
    color: #f7cad0;
  }

  .header__center {
    display: flex;
    justify-content: center;
  }

  .header__menu {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .header__menu-item {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    position: relative;
    padding: 6px 0;
    transition: color 0.25s ease;
  }

  .header__menu-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(90deg, #c25b82, #f7cad0);
    transition: width 0.3s ease;
  }

  .header__menu-item:hover {
    color: #ffffff;
  }

  .header__menu-item:hover::after {
    width: 100%;
  }

  .header__right {
    display: flex;
    align-items: center;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__icon-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, transform 0.2s ease;
  }

  .header__icon-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .cart-icon-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-badge {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #c25b82;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(194, 91, 130, 0.6);
  }

  .header__search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .header__search-form {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%) scaleX(0);
    transform-origin: right center;
    opacity: 0;
    width: 280px;
    display: flex;
    align-items: center;
    background: rgba(20, 14, 22, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 30px;
    padding: 4px 12px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .header__search-wrapper.active .header__search-form {
    transform: translateY(-50%) scaleX(1);
    opacity: 1;
    z-index: 10;
  }

  .search-toggle-btn {
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .header__search-wrapper.active .search-toggle-btn {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .header__search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 0.88rem;
    padding: 6px 8px;
  }

  .header__search-submit-btn,
  .header__search-close-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 4px;
  }

  /* Slide Drawers General */
  .side-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    visibility: hidden;
    transition: visibility 0.4s ease;
  }

  .side-drawer.active {
    visibility: visible;
  }

  .side-drawer__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

