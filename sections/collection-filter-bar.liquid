{% comment %}
  Modular Collection Filter & Sort Bar Section
  Includes independent Theme Blocks for Category Pills, Grid View Switcher (2'li, 3'lü, 4'lü), and Sort Box.
  All elements appear in Shopify Theme Editor tree as customizable Theme Blocks!
{% endcomment %}

<div class="collection-filter-bar-section full-width" style="
  --bar-max-width: {{ section.settings.max_width }}px;
  --margin-top: {{ section.settings.margin_top }}px;
  --margin-bottom: {{ section.settings.margin_bottom }}px;
  --bar-bg: {{ section.settings.bar_bg }};
  --bar-border: {{ section.settings.bar_border_color }};
  --bar-radius: {{ section.settings.bar_radius }}px;
  --bar-blur: {{ section.settings.bar_blur }}px;
  --pill-font-size: {{ section.settings.pill_font_size }}px;
  --pill-font-weight: {{ section.settings.pill_font_weight }};
  --pill-bg: {{ section.settings.pill_bg }};
  --pill-color: {{ section.settings.pill_text_color }};
  --pill-border: {{ section.settings.pill_border_color }};
  --pill-active-bg: {{ section.settings.pill_active_bg }};
  --pill-active-color: {{ section.settings.pill_active_text_color }};
  --pill-active-border: {{ section.settings.pill_active_border_color }};
">
  <div class="filter-bar-container">
    <div class="collection-filter-bar">
      
      <!-- Interactive Category Filter Pills -->
      {% assign pill_blocks = section.blocks | where: "type", "filter_pill" %}
      <div class="filter-pills" id="categoryFilterPills">
        {% if pill_blocks.size > 0 %}
          {% for block in pill_blocks %}
            <button type="button" class="filter-pill {% if block.settings.is_active or forloop.first %}active{% endif %}" data-category="{{ block.settings.category | default: 'all' }}" {{ block.shopify_attributes }}>
              {{ block.settings.label }}
            </button>
          {% endfor %}
        {% else %}
          <button type="button" class="filter-pill active" data-category="all">Tüm Ürünler</button>
          <button type="button" class="filter-pill" data-category="serum">Serumlar</button>
          <button type="button" class="filter-pill" data-category="moisturizer">Nemlendiriciler</button>
          <button type="button" class="filter-pill" data-category="mask">Yüz Maskeleri</button>
          <button type="button" class="filter-pill" data-category="eye-care">Göz Bakımı</button>
        {% endif %}
      </div>

      <!-- Right Controls Group (Grid Switcher & Sort Box Theme Blocks) -->
      <div class="filter-right-controls">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'grid_switcher' %}
              <div class="grid-layout-switcher" id="gridLayoutSwitcher" style="
                --switcher-label-color: {{ block.settings.label_color }};
                --btn-bg: {{ block.settings.btn_bg }};
                --btn-color: {{ block.settings.btn_text_color }};
                --btn-border: {{ block.settings.btn_border_color }};
                --active-bg: {{ block.settings.active_bg }};
                --active-color: {{ block.settings.active_text_color }};
                --active-border: {{ block.settings.active_border_color }};
              " {{ block.shopify_attributes }}>
                <span class="switcher-label">{{ block.settings.label | default: "Görünüm:" }}</span>
                <button type="button" class="grid-switch-btn" data-cols="2" title="2 Sütunlu Görünüm">
                  <span>2'li</span>
                </button>
                <button type="button" class="grid-switch-btn" data-cols="3" title="3 Sütunlu Görünüm">
                  <span>3'lü</span>
                </button>
                <button type="button" class="grid-switch-btn active" data-cols="4" title="4 Sütunlu Görünüm">
                  <span>4'lü</span>
                </button>
              </div>

            {% when 'sort_box' %}
              <div class="collection-sort-box" style="
                --sort-label-color: {{ block.settings.label_color }};
                --sort-select-bg: {{ block.settings.select_bg }};
                --sort-select-color: {{ block.settings.select_text_color }};
                --sort-select-border: {{ block.settings.select_border_color }};
              " {{ block.shopify_attributes }}>
                <span class="sort-label">{{ block.settings.label | default: "Sırala:" }}</span>
                <select class="dark-sort-select">
                  <option value="manual">Öne Çıkanlar</option>
                  <option value="price-ascending">Fiyat: Düşükten Yükseğe</option>
                  <option value="price-descending">Fiyat: Yüksekten Düşüğe</option>
                  <option value="created-descending">En Yeniler</option>
                </select>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Category Filter Interaction
    const pills = document.querySelectorAll('#categoryFilterPills .filter-pill');
    const cards = document.querySelectorAll('.haute-product-card');

    pills.forEach(pill => {
      pill.addEventListener('click', function() {
        const selectedCategory = this.getAttribute('data-category');

        pills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');

        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-category') || 'all';
          if (selectedCategory === 'all' || cardCategory === selectedCategory || cardCategory === 'all') {
            card.style.display = 'flex';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Grid Columns Switcher (2'li, 3'lü, 4'lü)
    const switchBtns = document.querySelectorAll('#gridLayoutSwitcher .grid-switch-btn');
    const productGrid = document.querySelector('.collection-products-grid');

    switchBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const cols = this.getAttribute('data-cols');
        switchBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        if (productGrid) {
          productGrid.style.setProperty('--grid-columns-desktop', cols);
        }
      });
    });
  });
{% endjavascript %}

{% stylesheet %}
  .filter-bar-container {
    max-width: var(--bar-max-width, 1320px);
    margin: var(--margin-top, 40px) auto var(--margin-bottom, 36px);
    padding: 0 24px;
  }

  .collection-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding: 14px 20px;
    background: var(--bar-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--bar-border, rgba(255, 255, 255, 0.1));
    backdrop-filter: blur(var(--bar-blur, 16px));
    border-radius: var(--bar-radius, 20px);
  }

  .filter-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-pill {
    padding: 8px 18px;
    background: var(--pill-bg, transparent);
    border: 1px solid var(--pill-border, rgba(255, 255, 255, 0.15));
    border-radius: 12px;
    color: var(--pill-color, rgba(255, 255, 255, 0.75));
    font-size: var(--pill-font-size, 14px);
    font-weight: var(--pill-font-weight, 700);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: var(--pill-active-bg, rgba(194, 91, 130, 0.3));
    border-color: var(--pill-active-border, #f7cad0);
    color: var(--pill-active-color, #ffffff);
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.2);
  }

  .filter-right-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .grid-layout-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 8px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .switcher-label {
    font-size: 13px;
    color: var(--switcher-label-color, rgba(255, 255, 255, 0.6));
    font-weight: 600;
    margin-right: 4px;
  }

  .grid-switch-btn {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--btn-bg, transparent);
    border: 1px solid var(--btn-border, transparent);
    color: var(--btn-color, rgba(255, 255, 255, 0.7));
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .grid-switch-btn.active,
  .grid-switch-btn:hover {
    background: var(--active-bg, rgba(194, 91, 130, 0.3));
    border-color: var(--active-border, #f7cad0);
    color: var(--active-color, #ffffff);
  }

  .collection-sort-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sort-label {
    font-size: 14px;
    color: var(--sort-label-color, rgba(255, 255, 255, 0.7));
    font-weight: 600;
  }

  .dark-sort-select {
    background: var(--sort-select-bg, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--sort-select-border, rgba(255, 255, 255, 0.2));
    border-radius: 10px;
    color: var(--sort-select-color, #ffffff);
    padding: 8px 14px;
    font-size: 14px;
    outline: none;
    cursor: pointer;
  }

  .dark-sort-select option {
    background: #130d16;
    color: #ffffff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koleksiyon Filtre Barı",
