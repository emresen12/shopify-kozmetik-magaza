            { "value": "price-descending", "label": "Fiyat: Yüksekten Düşüğe" },
            { "value": "created-descending", "label": "En Yeniler" },
            { "value": "created-ascending", "label": "En Eskiler" },
            { "value": "title-ascending", "label": "Alfabetik: A-Z" },
            { "value": "title-descending", "label": "Alfabetik: Z-A" }
          ],
          "default": "manual"
        },
        {
          "type": "checkbox",
          "id": "is_default",
          "label": "Varsayılan Seçili Gelsin",
          "default": false
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Yazı Rengi",
          "default": "rgba(255, 255, 255, 0.75)"
        },
        {
          "type": "color",
          "id": "active_bg_start",
          "label": "Aktif Gradyan Başlangıç",
          "default": "rgba(194, 91, 130, 0.3)"
        },
        {
          "type": "color",
          "id": "active_bg_end",
          "label": "Aktif Gradyan Bitiş",
          "default": "rgba(162, 67, 103, 0.3)"
