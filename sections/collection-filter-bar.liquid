{% comment %}
  Modular Collection Filter & Sort Bar Section
  Renders Top Filter Controls (Görünüm Switcher & Sort Box).
{% endcomment %}

<div class="collection-filter-bar-section full-width" style="
  --bar-max-width: {{ section.settings.max_width }}px;
  --margin-top: {{ section.settings.margin_top }}px;
  --margin-bottom: {{ section.settings.margin_bottom }}px;
  --bar-bg: {{ section.settings.bar_bg }};
  --bar-border: {{ section.settings.bar_border_color }};
  --bar-radius: {{ section.settings.bar_radius }}px;
  --bar-blur: {{ section.settings.bar_blur }}px;
">
  <div class="filter-bar-container">
    
    <!-- Top Filter Bar: ONLY Görünüm Switcher (Left) and Sırala (Right) -->
    <div class="collection-filter-bar">
      
      <!-- Left: Grid View Switcher -->
      <div class="filter-left-controls">
        {% for block in section.blocks %}
          {% if block.type == 'grid_switcher' %}
            <div class="grid-layout-switcher" id="gridLayoutSwitcher" style="
              --switcher-label-color: {{ block.settings.label_color }};
              --btn-bg: {{ block.settings.btn_bg }};
              --btn-color: {{ block.settings.btn_text_color }};
              --btn-border: {{ block.settings.btn_border_color }};
              --active-bg: {{ block.settings.active_bg }};
              --active-color: {{ block.settings.active_text_color }};
              --active-border: {{ block.settings.active_border_color }};
            " {{ block.shopify_attributes }}>
              <span class="switcher-label">{{ block.settings.label | default: "Görünüm:" }}</span>
              <button type="button" class="grid-switch-btn" data-cols="2" title="2 Sütunlu Görünüm">
                <span>2'li</span>
              </button>
              <button type="button" class="grid-switch-btn" data-cols="3" title="3 Sütunlu Görünüm">
                <span>3'lü</span>
              </button>
              <button type="button" class="grid-switch-btn active" data-cols="4" title="4 Sütunlu Görünüm">
                <span>4'lü</span>
              </button>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Right: Sort Box Dropdown -->
      <div class="filter-right-controls">
        {% for block in section.blocks %}
          {% if block.type == 'sort_box' %}
            <div class="collection-sort-box custom-sort-container" style="
              --sort-label-color: {{ block.settings.label_color }};
              --sort-select-bg: {{ block.settings.select_bg }};
              --sort-select-color: {{ block.settings.select_text_color }};
              --sort-select-border: {{ block.settings.select_border_color }};
            " {{ block.shopify_attributes }}>
              
              <button type="button" class="custom-sort-trigger" id="customSortBtn" aria-expanded="false" aria-haspopup="true">
                <span class="sort-label">{{ block.settings.label | default: "Sırala" }}</span>
                <svg class="sort-arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>

              <div class="custom-sort-menu" id="customSortMenu" role="menu" aria-hidden="true">
                <button type="button" class="sort-option-btn active" data-sort="manual" role="menuitem">
                  <span class="sort-option-text">Öne Çıkanlar</span>
                  <span class="sort-option-check">✓</span>
                </button>
                <button type="button" class="sort-option-btn" data-sort="price-ascending" role="menuitem">
                  <span class="sort-option-text">Fiyat: Düşükten Yükseğe</span>
                  <span class="sort-option-check">✓</span>
                </button>
                <button type="button" class="sort-option-btn" data-sort="price-descending" role="menuitem">
                  <span class="sort-option-text">Fiyat: Yüksekten Düşüğe</span>
                  <span class="sort-option-check">✓</span>
                </button>
                <button type="button" class="sort-option-btn" data-sort="created-descending" role="menuitem">
                  <span class="sort-option-text">En Yeniler</span>
                  <span class="sort-option-check">✓</span>
                </button>
              </div>

            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Grid Columns Switcher (2'li, 3'lü, 4'lü)
    const switchBtns = document.querySelectorAll('#gridLayoutSwitcher .grid-switch-btn');
    const productGrid = document.querySelector('.collection-products-grid');

    switchBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const cols = this.getAttribute('data-cols');
        switchBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        if (productGrid) {
          productGrid.style.setProperty('--grid-columns-desktop', cols);
        }
      });
    });

    // 2. Custom Sort Dropdown & Realtime Sorting Interaction
    const customSortContainers = document.querySelectorAll('.custom-sort-container');

    customSortContainers.forEach(container => {
      const trigger = container.querySelector('.custom-sort-trigger');
      const menu = container.querySelector('.custom-sort-menu');
      const options = container.querySelectorAll('.sort-option-btn');

      if (trigger && menu) {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = container.classList.contains('open');

          customSortContainers.forEach(c => {
            if (c !== container) {
              c.classList.remove('open');
              const trg = c.querySelector('.custom-sort-trigger');
              if (trg) trg.setAttribute('aria-expanded', 'false');
            }
          });

          if (!isOpen) {
            container.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            container.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });

        options.forEach(opt => {
          opt.addEventListener('click', function(e) {
            e.stopPropagation();
            const sortVal = this.getAttribute('data-sort');

            options.forEach(o => o.classList.remove('active'));
            this.classList.add('active');

            container.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');

            sortProducts(sortVal);
          });
        });
      }
    });

    // Close sort menu when clicking outside
    document.addEventListener('click', () => {
      customSortContainers.forEach(c => {
        c.classList.remove('open');
        const trigger = c.querySelector('.custom-sort-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    });

    function sortProducts(value) {
      const grid = document.querySelector('.collection-products-grid');
      if (!grid) return;

      const cardsArray = Array.from(grid.querySelectorAll('.haute-product-card'));

      cardsArray.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price')) || 0;
        const priceB = parseFloat(b.getAttribute('data-price')) || 0;
        const indexA = parseInt(a.getAttribute('data-index')) || 0;
        const indexB = parseInt(b.getAttribute('data-index')) || 0;

        if (value === 'price-ascending') {
          return priceA - priceB;
        } else if (value === 'price-descending') {
          return priceB - priceA;
        } else if (value === 'created-descending') {
          return indexB - indexA;
        } else {
          return indexA - indexB;
        }
      });

      cardsArray.forEach(card => grid.appendChild(card));
    }
  });
{% endjavascript %}

{% stylesheet %}
  .filter-bar-container {
    max-width: var(--bar-max-width, 1320px);
    margin: var(--margin-top, 40px) auto var(--margin-bottom, 20px);
    padding: 0 24px;
  }

  .collection-filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding: 14px 20px;
    background: var(--bar-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--bar-border, rgba(255, 255, 255, 0.1));
    backdrop-filter: blur(var(--bar-blur, 16px));
    border-radius: var(--bar-radius, 20px);
  }

  .filter-left-controls,
  .filter-right-controls {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .grid-layout-switcher {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 8px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .switcher-label {
    font-size: 13px;
    color: var(--switcher-label-color, rgba(255, 255, 255, 0.6));
    font-weight: 600;
    margin-right: 4px;
  }

  .grid-switch-btn {
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--btn-bg, transparent);
    border: 1px solid var(--btn-border, transparent);
    color: var(--btn-color, rgba(255, 255, 255, 0.7));
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .grid-switch-btn.active,
  .grid-switch-btn:hover {
    background: var(--active-bg, rgba(194, 91, 130, 0.3));
    border-color: var(--active-border, #f7cad0);
    color: var(--active-color, #ffffff);
  }

  .collection-sort-box {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .custom-sort-container {
    position: relative;
    display: inline-block;
  }

  .custom-sort-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--sort-select-bg, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--sort-select-border, rgba(255, 255, 255, 0.2));
    border-radius: 12px;
    padding: 8px 16px;
    color: var(--sort-select-color, #ffffff);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .custom-sort-trigger:hover {
    background: rgba(194, 91, 130, 0.25);
    border-color: #f7cad0;
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.2);
  }

  .sort-arrow-icon {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .custom-sort-container.open .sort-arrow-icon {
    transform: rotate(180deg);
  }

  .custom-sort-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 230px;
    background: #151019;
    border: 1px solid rgba(247, 202, 208, 0.3);
    border-radius: 16px;
    padding: 8px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.96);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1000;
  }

  .custom-sort-container.open .custom-sort-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .sort-option-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 11px 16px;
    border-radius: 10px;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sort-option-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .sort-option-btn.active {
    background: linear-gradient(135deg, rgba(194, 91, 130, 0.3) 0%, rgba(162, 67, 103, 0.3) 100%);
    color: #f7cad0;
    font-weight: 700;
  }

  .sort-option-check {
    opacity: 0;
    font-size: 14px;
    font-weight: 800;
    color: #f7cad0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    transform: scale(0.6);
  }

  .sort-option-btn.active .sort-option-check {
    opacity: 1;
    transform: scale(1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koleksiyon Filtre Barı",
  "settings": [
    {
      "type": "header",
      "content": "Genel Konteyner Ayarları"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maksimum Konteyner Genişliği",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Üst Dış Boşluk (Margin Top)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Alt Dış Boşluk (Margin Bottom)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Çubuk Stil & Cam (Glassmorphism) Ayarları"
    },
    {
      "type": "color",
      "id": "bar_bg",
      "label": "Çubuk Arka Plan Rengi",
      "default": "#151019"
    },
    {
      "type": "color",
      "id": "bar_border_color",
      "label": "Çubuk Kenarlık Rengi",
      "default": "#261a29"
    },
    {
      "type": "range",
      "id": "bar_radius",
