      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Görünüm Etiketi",
          "default": "Görünüm:"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Etiket Metin Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Buton Arka Plan Rengi",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Buton Metin Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "btn_border_color",
          "label": "Buton Kenarlık Rengi",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "active_bg",
          "label": "Aktif Buton Arka Plan Rengi",
          "default": "#c25b82"
        },
        {
          "type": "color",
          "id": "active_text_color",
          "label": "Aktif Buton Metin Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "active_border_color",
          "label": "Aktif Buton Kenarlık Rengi",
          "default": "#f7cad0"
        }
      ]
    },
    {
      "type": "sort_box",
      "name": "Sıralama Kutusu",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Sıralama Etiketi",
          "default": "Sırala:"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Etiket Metin Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "select_bg",
          "label": "Seçim Kutusu Arka Plan Rengi",
          "default": "#151019"
        },
        {
          "type": "color",
          "id": "select_text_color",
          "label": "Seçim Kutusu Metin Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "select_border_color",
          "label": "Seçim Kutusu Kenarlık Rengi",
          "default": "#261a29"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Koleksiyon Filtre Barı",
      "blocks": [
        { "type": "grid_switcher", "settings": { "label": "Görünüm:" } },
