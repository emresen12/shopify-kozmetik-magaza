{% comment %}
  Modular Collection Filter & Sort Bar Section
  Renders Top Filter Controls (Görünüm & Sırala Dropdowns side by side).
  Includes Visual Grid Layout Icons for "Görünüm" dropdown options.
  All options and dropdown titles are customizable section blocks.
{% endcomment %}

<div class="collection-filter-bar-section full-width" style="
  --bar-max-width: {{ section.settings.max_width }}px;
  --margin-top: {{ section.settings.margin_top }}px;
  --margin-bottom: {{ section.settings.margin_bottom }}px;
">
  <div class="filter-bar-container">
    
    <div class="collection-controls-inline">
      
      <!-- 1. Görünüm Dropdown Button -->
      {% assign grid_hdr = section.blocks | where: "type", "switcher_header" | first %}
      <div class="custom-sort-container custom-dropdown-container">
        <button type="button" class="custom-sort-trigger" aria-expanded="false" aria-haspopup="true"
          style="
            --sort-select-bg: {{ grid_hdr.settings.bg_color | default: 'rgba(255, 255, 255, 0.08)' }};
            --sort-select-color: {{ grid_hdr.settings.text_color | default: '#ffffff' }};
            --sort-select-border: {{ grid_hdr.settings.border_color | default: 'rgba(255, 255, 255, 0.2)' }};
            --sort-hover-bg: {{ grid_hdr.settings.hover_bg | default: 'rgba(194, 91, 130, 0.25)' }};
          "
          {% if grid_hdr %}{{ grid_hdr.shopify_attributes }}{% endif %}>
          <span class="sort-label">{{ grid_hdr.settings.label | default: "Görünüm" }}</span>
          <svg class="sort-arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="custom-sort-menu grid-dropdown-menu" role="menu" aria-hidden="true">
          {% for block in section.blocks %}
            {% if block.type == 'grid_button' %}
              {% assign cols_val = block.settings.cols | default: '4' %}
              <button type="button" class="sort-option-btn grid-option-btn {% if block.settings.is_active %}active{% endif %}"
                data-cols="{{ cols_val }}"
                role="menuitem"
                style="
                  --opt-text-color: {{ block.settings.btn_text_color | default: 'rgba(255, 255, 255, 0.75)' }};
                  --opt-active-bg-start: {{ block.settings.active_bg | default: 'rgba(194, 91, 130, 0.3)' }};
                  --opt-active-bg-end: {{ block.settings.active_bg | default: 'rgba(162, 67, 103, 0.3)' }};
                  --opt-active-color: {{ block.settings.active_text_color | default: '#f7cad0' }};
                "
                {{ block.shopify_attributes }}>
                
                <span class="grid-option-left">
                  {% case cols_val %}
                    {% when '1' %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="2" width="14" height="12" rx="2" />
                      </svg>
                    {% when '2' %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1.5" y="2" width="5.5" height="12" rx="1.5" />
                        <rect x="9" y="2" width="5.5" height="12" rx="1.5" />
                      </svg>
                    {% when '3' %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="2" width="3.8" height="12" rx="1" />
                        <rect x="6.1" y="2" width="3.8" height="12" rx="1" />
                        <rect x="11.2" y="2" width="3.8" height="12" rx="1" />
                      </svg>
                    {% when '4' %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="2" width="6" height="5.5" rx="1" />
                        <rect x="9" y="2" width="6" height="5.5" rx="1" />
                        <rect x="1" y="8.5" width="6" height="5.5" rx="1" />
                        <rect x="9" y="8.5" width="6" height="5.5" rx="1" />
                      </svg>
                    {% when '5' %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="2" width="3.8" height="5.5" rx="1" />
                        <rect x="6.1" y="2" width="3.8" height="5.5" rx="1" />
                        <rect x="11.2" y="2" width="3.8" height="5.5" rx="1" />
                        <rect x="1" y="8.5" width="3.8" height="5.5" rx="1" />
                        <rect x="6.1" y="8.5" width="3.8" height="5.5" rx="1" />
                        <rect x="11.2" y="8.5" width="3.8" height="5.5" rx="1" />
                      </svg>
                    {% else %}
                      <svg class="grid-shape-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <rect x="1" y="2" width="6" height="5.5" rx="1" />
                        <rect x="9" y="2" width="6" height="5.5" rx="1" />
                        <rect x="1" y="8.5" width="6" height="5.5" rx="1" />
                        <rect x="9" y="8.5" width="6" height="5.5" rx="1" />
                      </svg>
                  {% endcase %}
                  <span class="sort-option-text">{{ block.settings.label | default: "4'lü Izgara" }}</span>
                </span>

                <span class="sort-option-check">✓</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- 2. Sırala Dropdown Button (Side by side) -->
      {% assign sort_hdr = section.blocks | where: "type", "sort_dropdown" | first %}
      <div class="custom-sort-container sort-dropdown-container">
        <button type="button" class="custom-sort-trigger" aria-expanded="false" aria-haspopup="true"
          style="
            --sort-select-bg: {{ sort_hdr.settings.bg_color | default: 'rgba(255, 255, 255, 0.08)' }};
            --sort-select-color: {{ sort_hdr.settings.text_color | default: '#ffffff' }};
            --sort-select-border: {{ sort_hdr.settings.border_color | default: 'rgba(255, 255, 255, 0.2)' }};
            --sort-hover-bg: {{ sort_hdr.settings.hover_bg | default: 'rgba(194, 91, 130, 0.25)' }};
          "
          {% if sort_hdr %}{{ sort_hdr.shopify_attributes }}{% endif %}>
          <span class="sort-label">{{ sort_hdr.settings.label | default: "Sırala" }}</span>
          <svg class="sort-arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="custom-sort-menu sort-dropdown-menu" role="menu" aria-hidden="true">
          {% for block in section.blocks %}
            {% if block.type == 'sort_option' %}
              <button type="button" class="sort-option-btn {% if block.settings.is_default %}active{% endif %}"
                data-sort="{{ block.settings.sort_value | default: 'manual' }}"
                role="menuitem"
                style="
                  --opt-text-color: {{ block.settings.text_color | default: 'rgba(255, 255, 255, 0.85)' }};
                  --opt-active-bg-start: {{ block.settings.active_bg_start | default: 'rgba(194, 91, 130, 0.3)' }};
                  --opt-active-bg-end: {{ block.settings.active_bg_end | default: 'rgba(162, 67, 103, 0.3)' }};
                  --opt-active-color: {{ block.settings.active_text_color | default: '#f7cad0' }};
                "
                {{ block.shopify_attributes }}>
                <span class="sort-option-text">{{ block.settings.label }}</span>
                <span class="sort-option-check">✓</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>

  </div>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const customDropdownContainers = document.querySelectorAll('.custom-sort-container');

    customDropdownContainers.forEach(container => {
      const trigger = container.querySelector('.custom-sort-trigger');
      const menu = container.querySelector('.custom-sort-menu');

      if (trigger && menu) {
        // Toggle dropdown open/close on trigger click
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = container.classList.contains('open');

          // Close other open dropdowns
          customDropdownContainers.forEach(c => {
            if (c !== container) {
              c.classList.remove('open');
              const trg = c.querySelector('.custom-sort-trigger');
              if (trg) trg.setAttribute('aria-expanded', 'false');
            }
          });

          if (!isOpen) {
            container.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            container.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });

        // Grid Switcher option click handlers (Görünüm label stays "Görünüm")
        const gridOptions = container.querySelectorAll('.grid-option-btn');
        gridOptions.forEach(opt => {
          opt.addEventListener('click', function(e) {
            e.stopPropagation();
            const cols = this.getAttribute('data-cols');

            gridOptions.forEach(o => o.classList.remove('active'));
            this.classList.add('active');

            container.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');

            const productGrid = document.querySelector('.collection-products-grid');
            if (productGrid && cols) {
              productGrid.style.setProperty('--grid-columns-desktop', cols);
            }
          });
        });

        // Sorting option click handlers (Sırala label stays "Sırala")
        const sortOptions = container.querySelectorAll('.sort-option-btn:not(.grid-option-btn)');
        sortOptions.forEach(opt => {
          opt.addEventListener('click', function(e) {
            e.stopPropagation();
            const sortVal = this.getAttribute('data-sort');

            sortOptions.forEach(o => o.classList.remove('active'));
            this.classList.add('active');

            container.classList.remove('open');
            trigger.setAttribute('aria-expanded', 'false');

            sortProducts(sortVal);
          });
        });
      }
    });

    // Close open dropdowns when clicking outside
    document.addEventListener('click', () => {
      customDropdownContainers.forEach(c => {
        c.classList.remove('open');
        const trigger = c.querySelector('.custom-sort-trigger');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      });
    });

    function sortProducts(value) {
      const grid = document.querySelector('.collection-products-grid');
      if (!grid) return;

      const cardsArray = Array.from(grid.querySelectorAll('.haute-product-card'));

      cardsArray.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price')) || 0;
        const priceB = parseFloat(b.getAttribute('data-price')) || 0;
        const indexA = parseInt(a.getAttribute('data-index')) || 0;
        const indexB = parseInt(b.getAttribute('data-index')) || 0;
        const titleA = a.querySelector('.card-title')?.innerText.trim().toLowerCase() || '';
        const titleB = b.querySelector('.card-title')?.innerText.trim().toLowerCase() || '';

        if (value === 'price-ascending') {
          return priceA - priceB;
        } else if (value === 'price-descending') {
          return priceB - priceA;
        } else if (value === 'created-descending') {
          return indexB - indexA;
        } else if (value === 'created-ascending') {
          return indexA - indexB;
        } else if (value === 'title-ascending') {
          return titleA.localeCompare(titleB, 'tr');
        } else if (value === 'title-descending') {
          return titleB.localeCompare(titleA, 'tr');
        } else {
          return indexA - indexB;
        }
      });

      cardsArray.forEach(card => grid.appendChild(card));
    }
  });
{% endjavascript %}

{% stylesheet %}
  .collection-filter-bar-section {
    position: relative;
    z-index: 100 !important;
    overflow: visible !important;
  }

  .filter-bar-container {
    max-width: var(--bar-max-width, 1320px);
    margin: var(--margin-top, 40px) auto var(--margin-bottom, 20px);
    padding: 0 24px;
    position: relative;
    z-index: 100 !important;
    overflow: visible !important;
  }

  .collection-controls-inline {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 101 !important;
    overflow: visible !important;
  }

  @media (max-width: 767px) {
    .filter-bar-container {
      padding: 0 16px;
      margin-top: 15px !important;
      margin-bottom: 15px !important;
    }

    .collection-controls-inline {
      justify-content: space-between;
      width: 100%;
      gap: 8px;
    }

    .custom-sort-container {
      flex: 1;
      min-width: 0;
    }

    .custom-sort-trigger {
      width: 100%;
      justify-content: space-between;
      padding: 8px 12px;
      font-size: 13px;
    }

    .sort-label {
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .custom-sort-menu {
      min-width: 100%;
      width: 100%;
      left: 0;
      right: 0;
    }
  }

  .custom-sort-container {
    position: relative;
    display: inline-block;
    z-index: 103 !important;
    overflow: visible !important;
  }

  .custom-sort-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--sort-select-bg, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--sort-select-border, rgba(255, 255, 255, 0.2));
    border-radius: 12px;
    padding: 9px 18px;
    color: var(--sort-select-color, #ffffff);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .custom-sort-trigger:hover {
    background: var(--sort-hover-bg, rgba(194, 91, 130, 0.25));
    border-color: #f7cad0;
    box-shadow: 0 4px 14px rgba(194, 91, 130, 0.2);
  }

  .sort-arrow-icon {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .custom-sort-container.open .sort-arrow-icon {
    transform: rotate(180deg);
  }

  .custom-sort-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: #151019;
    border: 1px solid rgba(247, 202, 208, 0.3);
    border-radius: 16px;
    padding: 8px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.96);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 999999 !important;
  }

  .custom-sort-container.open .custom-sort-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .sort-option-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    background: transparent;
    border: none;
    color: var(--opt-text-color, rgba(255, 255, 255, 0.75));
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sort-option-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  .sort-option-btn.active {
    background: linear-gradient(135deg, var(--opt-active-bg-start, rgba(194, 91, 130, 0.3)) 0%, var(--opt-active-bg-end, rgba(162, 67, 103, 0.3)) 100%);
    color: var(--opt-active-color, #f7cad0);
    font-weight: 700;
  }

  .grid-option-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .grid-shape-icon {
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .sort-option-btn:hover .grid-shape-icon,
  .sort-option-btn.active .grid-shape-icon {
    opacity: 1;
    color: #f7cad0;
    transform: scale(1.1);
  }

  .sort-option-check {
    opacity: 0;
    font-size: 14px;
    font-weight: 800;
    color: #f7cad0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    transform: scale(0.6);
  }

  .sort-option-btn.active .sort-option-check {
    opacity: 1;
    transform: scale(1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Koleksiyon Filtre Barı",
  "settings": [
    {
      "type": "header",
      "content": "Genel Konteyner Ayarları"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maksimum Konteyner Genişliği",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Üst Dış Boşluk (Margin Top)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Alt Dış Boşluk (Margin Bottom)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "switcher_header",
      "name": "Görünüm Başlığı",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Buton Başlığı / Etiket",
          "default": "Görünüm"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Buton Arka Plan Rengi",
          "default": "rgba(255, 255, 255, 0.08)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Buton Yazı Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Buton Kenarlık Rengi",
          "default": "rgba(255, 255, 255, 0.2)"
        },
        {
          "type": "color",
          "id": "hover_bg",
          "label": "Hover Arka Plan Rengi",
          "default": "rgba(194, 91, 130, 0.25)"
        }
      ]
    },
    {
      "type": "grid_button",
      "name": "Görünüm Seçeneği",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Seçenek Etiketi",
          "default": "4'lü"
        },
        {
          "type": "select",
          "id": "cols",
          "label": "Sütun Sayısı",
          "options": [
            { "value": "1", "label": "1 Sütun (Tekli)" },
            { "value": "2", "label": "2 Sütun (İkili)" },
            { "value": "3", "label": "3 Sütun (Üçlü)" },
            { "value": "4", "label": "4 Sütun (Dörtlü)" },
            { "value": "5", "label": "5 Sütun (Beşli)" }
          ],
          "default": "4"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Varsayılan Seçili Gelsin",
          "default": false
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Yazı Rengi",
          "default": "rgba(255, 255, 255, 0.75)"
        },
        {
          "type": "color",
          "id": "active_bg",
          "label": "Aktif Arka Plan Rengi",
          "default": "rgba(194, 91, 130, 0.3)"
        },
        {
          "type": "color",
          "id": "active_text_color",
          "label": "Aktif Metin Rengi",
          "default": "#f7cad0"
        }
      ]
    },
    {
      "type": "sort_dropdown",
      "name": "Sıralama Başlığı",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Buton Başlığı / Etiket",
          "default": "Sırala"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Buton Arka Plan Rengi",
          "default": "rgba(255, 255, 255, 0.08)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Buton Yazı Rengi",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Buton Kenarlık Rengi",
          "default": "rgba(255, 255, 255, 0.2)"
        },
        {
          "type": "color",
          "id": "hover_bg",
