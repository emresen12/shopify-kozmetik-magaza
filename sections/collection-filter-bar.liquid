        {
          "type": "color",
          "id": "active_text_color",
          "label": "Aktif Metin Rengi",
          "default": "#f7cad0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Koleksiyon Filtre Barı",
      "blocks": [
        { "type": "switcher_header", "settings": { "label": "Görünüm" } },
        { "type": "grid_button", "settings": { "label": "2'li", "cols": "2" } },
        { "type": "grid_button", "settings": { "label": "3'lü", "cols": "3" } },
