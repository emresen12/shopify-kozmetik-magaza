{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    // --- THUMBNAIL SWITCHER ---
    const mainImg = document.getElementById('MainProductMediaImage');
    const thumbs = document.querySelectorAll('.thumb-btn');

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        thumbs.forEach(t => t.classList.remove('active'));
        thumb.classList.add('active');

        const newUrl = thumb.getAttribute('data-img-url');
        if (mainImg && newUrl) {
          mainImg.style.opacity = '0.3';
          setTimeout(() => {
            mainImg.src = newUrl;
            mainImg.style.opacity = '1';
          }, 150);
        }
      });
    });

    // --- VARIANT PILLS ---
    const vPills = document.querySelectorAll('.v-pill-btn');
    vPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const parent = pill.closest('.v-pills-row');
        if (parent) {
          parent.querySelectorAll('.v-pill-btn').forEach(b => b.classList.remove('active'));
          pill.classList.add('active');
        }
      });
    });

    // --- AJAX ADD TO CART ---
    const addToCartForm = document.getElementById('SpProductForm');
    if (addToCartForm) {
      addToCartForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const btn = addToCartForm.querySelector('button[type="submit"]');
        if (btn) btn.disabled = true;

        const formData = new FormData(addToCartForm);
        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(res => res.json())
        .then(data => {
          if (btn) btn.disabled = false;
          // Open the side cart drawer
          const cartDrawerTrigger = document.getElementById('cartDrawerTrigger');
          if (cartDrawerTrigger) {
             cartDrawerTrigger.click();
          }
        })
        .catch(err => {
          console.error(err);
          if (btn) btn.disabled = false;
        });
      });
    }

    // --- OTHER PRODUCTS SLIDER ARROWS ---
    const prevBtn = document.getElementById('SpOtherSliderPrev');
    const nextBtn = document.getElementById('SpOtherSliderNext');
    const track = document.getElementById('SpOtherProductsTrack');

    if (prevBtn && nextBtn && track) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -340, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 340, behavior: 'smooth' });
      });
    }
  });
{% endjavascript %}

