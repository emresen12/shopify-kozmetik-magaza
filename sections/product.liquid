{% stylesheet %}
  .single-product-page-section {
    position: relative;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    background: var(--bg-color);
    color: #ffffff;
    min-height: 100vh;
  }

  .luxury-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 500px;
    background: radial-gradient(circle, rgba(247, 202, 208, 0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  /* HERO BUY BOX */
  .single-product-hero-container {
    max-width: 1280px;
    margin: 0 auto 100px auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    position: relative;
    z-index: 2;
    align-items: start;
  }

  .single-product-hero-container[data-image-pos="right"] {
    grid-template-columns: 0.9fr 1.1fr;
  }
  .single-product-hero-container[data-image-pos="right"] .single-product__media-col {
    order: 2;
  }
  .single-product-hero-container[data-image-pos="right"] .single-product__info-col {
    order: 1;
  }

  .sticky-media-frame {
    position: sticky;
    top: 110px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 0;
  }
  
  .sp-bottom-sections-wrap {
    position: relative;
    z-index: 10;
    background: var(--bg-color);
    padding-top: 40px;
    margin-top: -100px;
  }

  .main-image-viewport {
    position: relative;
    flex-grow: 1;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .main-image-viewport:hover {
    border-color: rgba(247, 202, 208, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .viewport-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .media-thumbnails-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .sticky-media-frame[data-thumb-pos^="overlay_"] .media-thumbnails-row {
    position: absolute;
    z-index: 10;
    flex-direction: column;
    flex-wrap: nowrap;
    overflow-y: auto;
    max-height: calc(100% - 40px);
    margin: 20px;
  }

  .sticky-media-frame[data-thumb-pos="overlay_top_left"] .media-thumbnails-row {
    top: 0; left: 0;
  }
  .sticky-media-frame[data-thumb-pos="overlay_bottom_left"] .media-thumbnails-row {
    bottom: 0; left: 0;
  }
  .sticky-media-frame[data-thumb-pos="overlay_top_right"] .media-thumbnails-row {
    top: 0; right: 0;
  }
  .sticky-media-frame[data-thumb-pos="overlay_bottom_right"] .media-thumbnails-row {
    bottom: 0; right: 0;
  }

  .sticky-media-frame[data-thumb-pos^="overlay_"] .media-thumbnails-row::-webkit-scrollbar {
    width: 4px;
  }

  .sticky-media-frame[data-thumb-pos^="overlay_"] .media-thumbnails-row::-webkit-scrollbar-thumb {
    background-color: rgba(255,255,255,0.2);
    border-radius: 4px;
  }

  .thumb-btn {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    transition: all 0.3s ease;
    opacity: 0.6;
  }

  .thumb-btn:hover {
    opacity: 1;
    border-color: rgba(247, 202, 208, 0.4);
  }

  .thumb-btn.active {
    opacity: 1;
    border-color: #f7cad0;
    box-shadow: 0 0 12px rgba(247, 202, 208, 0.25);
  }

  .thumb-btn-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .minimal-info-box {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .vendor-tag {
    display: inline-block;
    padding: 5px 14px;
    border-radius: 20px;
    background: rgba(194, 91, 130, 0.2);
    border: 1px solid rgba(247, 202, 208, 0.4);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #f7cad0;
  }

  .sp-title {
    margin: 0;
    font-size: 2.4rem;
