              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title }}" class="rel-img" loading="lazy">
              {% else %}
                <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="{{ block.settings.title }}" class="rel-img" loading="lazy">
              {% endif %}
