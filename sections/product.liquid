              {% endif %}
              <h4 class="rel-title"><a href="{{ block.settings.url | default: '/products/gift-card' }}">{{ block.settings.title | default: "Crème de la Rose Anti-Age" }}</a></h4>
              <span class="rel-price">{{ block.settings.price | default: "₺1.850,00" }}</span>
            </div>
          </div>
        {% endfor %}
      {% elsif collections.all.products.size > 0 %}
