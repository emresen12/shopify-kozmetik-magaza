{% comment %}
  Chanel & Zara Inspired High-Fashion Product Page Section
  Ultra-customizable block settings for every single element on the product page.
  Dynamically synced with Shopify Collections & Collection Product Grid Catalog.
{% endcomment %}

<div class="single-product-page-section full-width" id="singleProductPage" style="
  --padding-top: {{ section.settings.padding_top | default: 90 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 120 }}px;
  --bg-color: {{ section.settings.bg_color | default: '#0b080c' }};
  --accent-gold: {{ section.settings.accent_gold | default: '#f7cad0' }};
">
  <!-- Ambient Atmosphere Glow -->
  <div class="luxury-ambient-glow"></div>

  <!-- ==========================================
       1. HERO PRODUCT BUY BOX SECTION
  ========================================== -->
  <div class="single-product-hero-container" data-image-pos="{{ section.settings.image_position | default: 'left' }}">

    <!-- LEFT: MINIMAL MEDIA GALLERY & THUMBNAIL BLOCKS -->
    <div class="single-product__media-col">
      {% assign media_gallery_block = section.blocks | where: "type", "product_media_gallery" | first %}
      {% assign media_thumbnail_blocks = section.blocks | where: "type", "media_thumbnail" %}

      <div class="sticky-media-frame" 
        data-thumb-pos="{{ media_gallery_block.settings.thumb_pos | default: 'bottom' }}"
        style="
          {% if media_gallery_block.settings.border_radius %}border-radius: {{ media_gallery_block.settings.border_radius }}px;{% endif %}
          {% if media_gallery_block.settings.bg_color != blank %}background-color: {{ media_gallery_block.settings.bg_color }};{% endif %}
        "
        {% if media_gallery_block %} {{ media_gallery_block.shopify_attributes }} {% endif %}
      >
        <div class="main-image-viewport" style="aspect-ratio: {{ media_gallery_block.settings.aspect_ratio | default: '4 / 5' }};">
          {% if product.featured_media %}
            <img 
              id="MainProductMediaImage"
              src="{{ product.featured_media | image_url: width: 1400 }}" 
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              class="viewport-img"
              width="1000"
              height="1000"
              loading="eager"
            >
          {% else %}
            <img 
              id="MainProductMediaImage"
              src="{{ 'luxury-serum.jpg' | asset_url }}" 
              alt="{{ product.title | escape }}" 
              class="viewport-img"
              width="1000"
              height="1000"
              loading="eager"
            >
          {% endif %}
        </div>

        {% if media_gallery_block.settings.show_thumbnails == blank or media_gallery_block.settings.show_thumbnails == true %}
          <div class="media-thumbnails-row">
            {% if media_thumbnail_blocks.size > 0 %}
              {% for block in media_thumbnail_blocks %}
                <button 
                  type="button" 
                  class="thumb-btn {% if forloop.first %}active{% endif %}"
                  data-img-url="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 }}{% else %}{{ 'luxury-serum.jpg' | asset_url }}{% endif %}"
                  aria-label="{{ block.settings.alt | default: 'Küçük Görsel' }}"
                  style="
                    {% if block.settings.thumb_size %}width: {{ block.settings.thumb_size }}px; height: {{ block.settings.thumb_size }}px;{% endif %}
                    {% if block.settings.border_radius %}border-radius: {{ block.settings.border_radius }}px;{% endif %}
                  "
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 180, height: 180, crop: 'center' }}" alt="{{ block.settings.alt | default: 'Görsel' }}" class="thumb-btn-img" loading="lazy">
                  {% else %}
                    <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Görsel {{ forloop.index }}" class="thumb-btn-img">
                  {% endif %}
                </button>
              {% endfor %}
            {% elsif product.media.size > 1 %}
              {% for media in product.media %}
                <button 
                  type="button" 
                  class="thumb-btn {% if forloop.first %}active{% endif %}"
                  data-img-url="{{ media | image_url: width: 1400 }}"
                  aria-label="Görsel {{ forloop.index }}"
                >
                  {{ media | image_url: width: 180, height: 180, crop: 'center' | image_tag: class: 'thumb-btn-img', loading: 'lazy' }}
                </button>
              {% endfor %}
            {% else %}
              <button type="button" class="thumb-btn active" data-img-url="{{ 'luxury-serum.jpg' | asset_url }}">
                <img src="{{ 'luxury-serum.jpg' | asset_url }}" alt="Görsel 1" class="thumb-btn-img">
              </button>
              <button type="button" class="thumb-btn" data-img-url="{{ 'luxury-cream.jpg' | asset_url }}">
                <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Görsel 2" class="thumb-btn-img">
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>


    <!-- RIGHT: HERO BUY BOX BLOCKS -->
    <div class="single-product__info-col">
      <div class="minimal-info-box">

        {% for block in section.blocks %}
          {% case block.type %}

            {% comment %} --- MARKA / KATEGORİ --- {% endcomment %}
            {% when 'vendor_badge' %}
              <div class="sp-block block-vendor" {{ block.shopify_attributes }}>
                <span class="vendor-tag" style="
                  {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                  {% if block.settings.font_size %}font-size: {{ block.settings.font_size }}px;{% endif %}
                  {% if block.settings.letter_spacing != blank %}letter-spacing: {{ block.settings.letter_spacing }};{% endif %}
                ">
                  {{ product.vendor | default: block.settings.default_vendor | default: "CHANEL • HAUTE BEAUTÉ" | upcase }}
                </span>
              </div>

            {% comment %} --- BAŞLIK --- {% endcomment %}
            {% when 'title' %}
              <div class="sp-block block-title" {{ block.shopify_attributes }}>
                <h1 class="sp-title" style="
                  {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
                  {% if block.settings.font_size %}font-size: {{ block.settings.font_size }}px;{% endif %}
                  {% if block.settings.font_weight != blank %}font-weight: {{ block.settings.font_weight }};{% endif %}
                ">
                  {{ block.settings.custom_title | default: product.title | default: "Rose Gold Elixir de Jeunesse" }}
                </h1>
              </div>

            {% comment %} --- FİYAT --- {% endcomment %}
            {% when 'price' %}
              <div class="sp-block block-price" {{ block.shopify_attributes }}>
                <div class="price-row">
                  <span class="price-current" id="SpProductPrice" style="
                    {% if block.settings.price_color != blank %}color: {{ block.settings.price_color }};{% endif %}
                    {% if block.settings.font_size %}font-size: {{ block.settings.font_size }}px;{% endif %}
                  ">
                    {{ product.selected_or_first_available_variant.price | default: 125000 | money }}
                  </span>
                  {% if product.compare_at_price > product.price or block.settings.demo_compare_price != blank %}
                    <span class="price-compare" id="SpComparePrice" style="
                      {% if block.settings.compare_color != blank %}color: {{ block.settings.compare_color }};{% endif %}
                    ">
                      {{ product.selected_or_first_available_variant.compare_at_price | default: block.settings.demo_compare_price | default: "₺1.650,00" }}
                    </span>
                  {% endif %}
                </div>
                {% if block.settings.show_tax_notice %}
                  <span class="sp-tax-notice" style="display: block; font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 4px;">
                    {{ block.settings.tax_notice_text | default: "KDV dahil • Kargo sepette hesaplanır" }}
                  </span>
                {% endif %}
              </div>

            {% comment %} --- VARYANT SEÇİMİ --- {% endcomment %}
            {% when 'variant_picker' %}
              <div class="sp-block block-variants" {{ block.shopify_attributes }}>
                {% unless product.has_only_default_variant %}
                  <div class="variant-groups-wrap">
                    {% for option in product.options_with_values %}
                      <div class="v-group">
                        <label class="v-label" style="{% if block.settings.label_size %}font-size: {{ block.settings.label_size }}px;{% endif %}">{{ option.name }}</label>
                        <div class="v-pills-row">
                          {% for value in option.values %}
                            <button 
                              type="button" 
                              class="v-pill-btn {% if option.selected_value == value %}active{% endif %}"
                              data-value="{{ value | escape }}"
                              style="{% if block.settings.pill_border_radius %}border-radius: {{ block.settings.pill_border_radius }}px;{% endif %}"
                            >
                              <span>{{ value }}</span>
                            </button>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="v-group">
                    <label class="v-label" style="{% if block.settings.label_size %}font-size: {{ block.settings.label_size }}px;{% endif %}">HACİM</label>
                    <div class="v-pills-row">
                      <button type="button" class="v-pill-btn" style="{% if block.settings.pill_border_radius %}border-radius: {{ block.settings.pill_border_radius }}px;{% endif %}">30 ML</button>
                      <button type="button" class="v-pill-btn active" style="{% if block.settings.pill_border_radius %}border-radius: {{ block.settings.pill_border_radius }}px;{% endif %}">50 ML</button>
                      <button type="button" class="v-pill-btn" style="{% if block.settings.pill_border_radius %}border-radius: {{ block.settings.pill_border_radius }}px;{% endif %}">100 ML</button>
                    </div>
                  </div>
                {% endunless %}
              </div>

            {% comment %} --- SATIN ALMA BUTONLARI --- {% endcomment %}
            {% when 'buy_buttons' %}
              <div class="sp-block block-buy-buttons" {{ block.shopify_attributes }}>
                {% form 'product', product, id: 'SpProductForm', class: 'sp-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: 12345678 }}">
                  <input type="hidden" name="quantity" value="1">

                  <div class="buy-action-row">
                    <button type="submit" name="add" class="sp-add-to-cart-btn" style="
                      {% if block.settings.button_bg != blank %}background-color: {{ block.settings.button_bg }};{% endif %}
                      {% if block.settings.button_text_color != blank %}color: {{ block.settings.button_text_color }};{% endif %}
                      {% if block.settings.button_border_radius %}border-radius: {{ block.settings.button_border_radius }}px;{% endif %}
                    ">
                      <span>{{ block.settings.button_text | default: "SEPETE EKLE" }}</span>
                    </button>
                  </div>
                {% endform %}
              </div>

            {% comment %} --- AKORDEON SEKMELER --- {% endcomment %}
            {% when 'collapsible_tab' %}
              <div class="sp-block block-accordion" {{ block.shopify_attributes }}>
                <details class="sp-accordion-details" {% if block.settings.open_by_default %}open{% endif %} style="
                  {% if block.settings.border_color != blank %}border-color: {{ block.settings.border_color }};{% endif %}
                ">
                  <summary class="sp-accordion-summary" style="
                    {% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}
                  ">
                    <span>
                      {% if block.settings.icon != blank %}<span style="margin-right: 8px;">{{ block.settings.icon }}</span>{% endif %}
                      {{ block.settings.heading | default: "ÜRÜN DETAYLARI & İÇERİK" }}
                    </span>
                    <span class="sp-acc-plus">+</span>
                  </summary>
                  <div class="sp-accordion-body" style="
                    {% if block.settings.content_color != blank %}color: {{ block.settings.content_color }};{% endif %}
                  ">
                    {{ block.settings.content | default: "Isparta gülü ve 24k altın özleri içeren hücre yenileyici elit formül. Cildi derinlemesine nemlendirir ve ışıltı kazandırır." }}
                  </div>
                </details>
              </div>

          {% endcase %}
        {% endfor %}

      </div>
    </div>

  </div>


  <!-- ==========================================
       STANDALONE SECTION HEADINGS & TEXT BLOCKS
  ========================================== -->
  <div class="sp-bottom-sections-wrap">
  {% for block in section.blocks %}
    {% if block.type == 'section_heading' %}
      <div class="sp-section-header align-{{ block.settings.align | default: 'center' }}" style="
        {% if block.settings.margin_bottom %}margin-bottom: {{ block.settings.margin_bottom }}px;{% endif %}
      " {{ block.shopify_attributes }}>
        {% if block.settings.subtitle != blank %}
          <span class="sec-subtitle" style="{% if block.settings.subtitle_color != blank %}color: {{ block.settings.subtitle_color }};{% endif %}">{{ block.settings.subtitle }}</span>
        {% endif %}
        {% if block.settings.title != blank %}
          <h3 class="sec-title" style="{% if block.settings.title_color != blank %}color: {{ block.settings.title_color }};{% endif %}">{{ block.settings.title }}</h3>
        {% endif %}
      </div>
    {% elsif block.type == 'text_block' %}
      <div class="sp-text-block align-{{ block.settings.align | default: 'center' }}" {{ block.shopify_attributes }}>
        <div class="sp-text-content" style="
          {% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}
          {% if block.settings.font_size %}font-size: {{ block.settings.font_size }}px;{% endif %}
          {% if block.settings.max_width %}max-width: {{ block.settings.max_width }}px; margin: 0 auto;{% endif %}
        ">
          {{ block.settings.content }}
        </div>
      </div>
    {% endif %}
  {% endfor %}


  <!-- ==========================================
       2. EDITORIAL BANNER (FULL WIDTH BLOCK)
  ========================================== -->
  {% for block in section.blocks %}
    {% if block.type == 'editorial_banner' %}
      <div class="sp-editorial-banner-wrap" {{ block.shopify_attributes }}>
        <div class="editorial-card" style="
          {% if block.settings.height %}height: {{ block.settings.height }}px;{% endif %}
          {% if block.settings.card_border_radius %}border-radius: {{ block.settings.card_border_radius }}px;{% endif %}
        ">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1800 }}" alt="Editorial" class="editorial-img" loading="lazy">
          {% else %}
            <img src="{{ 'luxury-cream.jpg' | asset_url }}" alt="Editorial" class="editorial-img" loading="lazy">
          {% endif %}
          <div class="editorial-content" style="text-align: {{ block.settings.text_align | default: 'left' }};">
            <span class="ed-tag">{{ block.settings.subtitle | default: "LA MAISON DE BEAUTÉ" }}</span>
            <h2 class="ed-title">{{ block.settings.title | default: "Işıltının ve Zarafetin En Saf Hali" }}</h2>
            <p class="ed-desc">{{ block.settings.text | default: "Nadir botanik özler ve 24K altın minerallerinin buluştuğu zamansız bir ritüel." }}</p>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}


  <!-- ==========================================
       3. FORMULA NOTES GROUP (OUTER GROUP + INNER HEADER + INNER CARDS SIDE-BY-SIDE)
  ========================================== -->
  {% assign formula_group_block = section.blocks | where: "type", "formula_group" | first %}
  {% assign formula_header_block = section.blocks | where: "type", "formula_header" | first %}
  {% assign formula_card_blocks  = section.blocks | where: "type", "formula_card" %}
  {% if formula_group_block != blank or formula_header_block != blank or formula_card_blocks.size > 0 %}
    <div class="sp-formula-section" 
      style="
        {% if formula_group_block.settings.bg_color != blank %}background-color: {{ formula_group_block.settings.bg_color }}; padding: 40px; border-radius: 16px;{% endif %}
        {% if formula_group_block.settings.border_color != blank %}border: 1px solid {{ formula_group_block.settings.border_color }};{% endif %}
      "
      {% if formula_group_block %} {{ formula_group_block.shopify_attributes }} {% endif %}
    >
      <div class="sp-section-header" {% if formula_header_block %} {{ formula_header_block.shopify_attributes }} {% endif %}>
        <span class="sec-subtitle" style="{% if formula_header_block.settings.subtitle_color != blank %}color: {{ formula_header_block.settings.subtitle_color }};{% endif %}">
          {{ formula_header_block.settings.subtitle | default: formula_group_block.settings.subtitle | default: "SAVOIR-FAIRE & SENSORIALITY" }}
        </span>
        <h3 class="sec-title" style="{% if formula_header_block.settings.title_color != blank %}color: {{ formula_header_block.settings.title_color }};{% endif %}">
          {{ formula_header_block.settings.title | default: formula_group_block.settings.title | default: "Doku & Koku Notaları" }}
        </h3>
      </div>

      <div class="formula-notes-grid" style="grid-template-columns: repeat({{ formula_group_block.settings.columns_desktop | default: 3 }}, 1fr);">
        {% if formula_card_blocks.size > 0 %}
          {% for block in formula_card_blocks %}
            <div class="fn-card" 
              style="
                {% if block.settings.bg_color != blank %}background-color: {{ block.settings.bg_color }};{% endif %}
                {% if block.settings.border_color != blank %}border-color: {{ block.settings.border_color }};{% endif %}
              "
              {{ block.shopify_attributes }}
            >
              <span class="fn-icon" style="{% if block.settings.icon_color != blank %}color: {{ block.settings.icon_color }};{% endif %}">
                {{ block.settings.icon | default: "✨" }}
              </span>
              <h4 style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}">
                {{ block.settings.title | default: "FORMÜL DOKUSU" }}
              </h4>
              <p style="{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }}; opacity: 0.8;{% endif %}">
                {{ block.settings.text | default: "İpeksi, yağlı his bırakmayan sıvı nektar dokusu." }}
              </p>
            </div>
          {% endfor %}
        {% else %}
          <div class="fn-card">
            <span class="fn-icon">✨</span>
            <h4>FORMÜL DOKUSU</h4>
            <p>İpeksi, yağlı his bırakmayan sıvı nektar dokusu.</p>
          </div>
          <div class="fn-card">
            <span class="fn-icon">🌹</span>
            <h4>KOKU İMZASI</h4>
            <p>Isparta gülü, taze bergamot ve hafif amber alt notaları.</p>
          </div>
          <div class="fn-card">
            <span class="fn-icon">🧪</span>
            <h4>KLİNİK SONUÇLAR</h4>
            <p>%96 İlk kullanımda daha parlak cilt, %94 28 günde sıkılaşma.</p>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}


  <!-- ==========================================
       4. APPLICATION RITUAL GROUP (OUTER GROUP + INNER HEADER + INNER STEP CARDS SIDE-BY-SIDE)
  ========================================== -->
  {% assign ritual_group_block = section.blocks | where: "type", "ritual_group" | first %}
  {% assign ritual_header_block = section.blocks | where: "type", "ritual_header" | first %}
  {% assign ritual_step_blocks  = section.blocks | where: "type", "ritual_step" %}
  {% if ritual_group_block != blank or ritual_header_block != blank or ritual_step_blocks.size > 0 %}
    <div class="sp-ritual-section" 
      style="
        {% if ritual_group_block.settings.bg_color != blank %}background-color: {{ ritual_group_block.settings.bg_color }}; padding: 40px; border-radius: 16px;{% endif %}
        {% if ritual_group_block.settings.border_color != blank %}border: 1px solid {{ ritual_group_block.settings.border_color }};{% endif %}
      "
      {% if ritual_group_block %} {{ ritual_group_block.shopify_attributes }} {% endif %}
    >
      <div class="sp-section-header" {% if ritual_header_block %} {{ ritual_header_block.shopify_attributes }} {% endif %}>
        <span class="sec-subtitle" style="{% if ritual_header_block.settings.subtitle_color != blank %}color: {{ ritual_header_block.settings.subtitle_color }};{% endif %}">
          {{ ritual_header_block.settings.subtitle | default: ritual_group_block.settings.subtitle | default: "APPLICATION RITUAL" }}
        </span>
        <h3 class="sec-title" style="{% if ritual_header_block.settings.title_color != blank %}color: {{ ritual_header_block.settings.title_color }};{% endif %}">
          {{ ritual_header_block.settings.title | default: ritual_group_block.settings.title | default: "Güzellik Ritüeli" }}
        </h3>
      </div>

      <div class="ritual-grid">
        {% if ritual_step_blocks.size > 0 %}
          {% for block in ritual_step_blocks %}
            <div class="ritual-card" 
              style="
                {% if block.settings.bg_color != blank %}background-color: {{ block.settings.bg_color }};{% endif %}
                {% if block.settings.border_color != blank %}border-color: {{ block.settings.border_color }};{% endif %}
              "
              {{ block.shopify_attributes }}
            >
              <span class="step-num" style="{% if block.settings.step_num_color != blank %}color: {{ block.settings.step_num_color }};{% endif %}">
                {{ block.settings.step_number | default: "01" }}
              </span>
              <h4>{{ block.settings.title | default: "HAZIRLIK" }}</h4>
              <p>{{ block.settings.text | default: "Cildinizi nazik bir misel su ile temizleyin ve tonikleyin." }}</p>
            </div>
          {% endfor %}
        {% else %}
          <div class="ritual-card">
            <span class="step-num">01</span>
            <h4>HAZIRLIK</h4>
            <p>Cildinizi nazik bir misel su ile temizleyin ve tonikleyin.</p>
          </div>
          <div class="ritual-card">
            <span class="step-num">02</span>
            <h4>UYGULAMA</h4>
            <p>3-4 damla iksiri avucunuza alıp dairesel masajla yedirin.</p>
          </div>
          <div class="ritual-card">
            <span class="step-num">03</span>
            <h4>MÜKEMMELLİK</h4>
            <p>Nemlendirici kreminiz ile ışıltılı görünümü mühürleyin.</p>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}


  <!-- ==========================================
       5. REVIEWS GROUP (OUTER GROUP + INNER HEADER + SCORE CARD + INNER REVIEW CARDS SIDE-BY-SIDE)
  ========================================== -->
  {% assign reviews_group_block = section.blocks | where: "type", "reviews_group" | first %}
  {% assign reviews_header_block = section.blocks | where: "type", "reviews_header" | first %}
  {% assign reviews_score_block  = section.blocks | where: "type", "reviews_score" | first %}
  {% assign review_item_blocks   = section.blocks | where: "type", "review_item" %}
  {% if reviews_group_block != blank or reviews_header_block != blank or reviews_score_block != blank or review_item_blocks.size > 0 %}
    <div class="sp-reviews-section" 
      style="{% if reviews_group_block.settings.bg_color != blank %}background-color: {{ reviews_group_block.settings.bg_color }}; padding: 40px; border-radius: 16px;{% endif %}"
      {% if reviews_group_block %} {{ reviews_group_block.shopify_attributes }} {% endif %}
    >
      <div class="sp-section-header" {% if reviews_header_block %} {{ reviews_header_block.shopify_attributes }} {% endif %}>
        <span class="sec-subtitle">
          {{ reviews_header_block.settings.subtitle | default: reviews_group_block.settings.subtitle | default: "CLIENT EXPERIENCE" }}
        </span>
        <h3 class="sec-title">
          {{ reviews_header_block.settings.title | default: reviews_group_block.settings.title | default: "Müşteri Değerlendirmeleri" }}
        </h3>
      </div>

      <div class="reviews-wrapper">
        <!-- Score Card (Left) -->
        <div class="reviews-score-card" {% if reviews_score_block %} {{ reviews_score_block.shopify_attributes }} {% endif %}>
          <div class="score-main">
            <span class="big-score" style="{% if reviews_score_block.settings.score_color != blank %}color: {{ reviews_score_block.settings.score_color }};{% endif %}">
              {{ reviews_score_block.settings.score | default: "4.9" }}
            </span>
            <span class="stars-gold" style="{% if reviews_score_block.settings.star_color != blank %}color: {{ reviews_score_block.settings.star_color }};{% endif %}">
              ★★★★★
            </span>
            <span class="total-reviews">{{ reviews_score_block.settings.review_count | default: "128" }} Doğrulanmış Yorum</span>
          </div>
          <div class="score-bars">
            <div class="s-bar-row"><span>5 Yıldız</span><div class="bar-bg"><div class="bar-fill" style="width: 92%;"></div></div><span>92%</span></div>
            <div class="s-bar-row"><span>4 Yıldız</span><div class="bar-bg"><div class="bar-fill" style="width: 6%;"></div></div><span>6%</span></div>
            <div class="s-bar-row"><span>3 Yıldız</span><div class="bar-bg"><div class="bar-fill" style="width: 2%;"></div></div><span>2%</span></div>
          </div>
        </div>

        <!-- Review Cards (Right) -->
        <div class="reviews-cards-grid">
          {% if review_item_blocks.size > 0 %}
            {% for block in review_item_blocks %}
              <div class="review-item-card" 
                style="
                  {% if block.settings.bg_color != blank %}background-color: {{ block.settings.bg_color }};{% endif %}
                  {% if block.settings.border_color != blank %}border-color: {{ block.settings.border_color }};{% endif %}
                "
                {{ block.shopify_attributes }}
              >
                <div class="rev-header">
                  <span class="rev-stars">
                    {% assign r_count = block.settings.rating | default: 5 %}
                    {% for i in (1..r_count) %}★{% endfor %}
                  </span>
                  <span class="rev-date">{{ block.settings.date | default: "12 Temmuz 2026" }}</span>
                </div>
                <h5 class="rev-author">{{ block.settings.author | default: "Zeynep K." }} <span class="v-badge-sm">✓ {{ block.settings.badge | default: "Onaylı Alıcı" }}</span></h5>
                <p class="rev-text">"{{ block.settings.comment | default: "Kullanmaya başladığım ilk haftadan itibaren cildimdeki ışıltıyı herkes fark etti." }}"</p>
              </div>
            {% endfor %}
          {% else %}
