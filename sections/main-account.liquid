{% comment %}
  Modular Customer Account Dashboard Section (Full Block Architecture)
  Every panel, sentence, card, order history box, and address box is a customizable Theme Block.
{% endcomment %}

<div class="customer-account-section full-width" style="
  --bg-color: {{ section.settings.bg_color | default: '#0b080c' }};
  --max-width: {{ section.settings.max_width | default: 1100 }}px;
  --padding-top: {{ section.settings.padding_top | default: 80 }}px;
  --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
">
  <div class="account-container">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'welcome_badge' %}
          <div class="account-block block-badge-wrapper" {{ block.shopify_attributes }}>
            <span class="account-badge" style="color: {{ block.settings.text_color }}; background: {{ block.settings.bg_color }};">
              {{ block.settings.text }}
            </span>
          </div>

        {% when 'heading' %}
          <div class="account-block block-heading-wrapper" {{ block.shopify_attributes }}>
            <h1 class="account-main-title" style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px;">
              {{ block.settings.text }} {% if customer %}({{ customer.name }}){% endif %}
            </h1>
          </div>

        {% when 'vip_banner' %}
          <div class="account-block block-vip-banner" style="
            background: {{ block.settings.bg_color }};
            border: 1px solid {{ block.settings.border_color }};
            color: {{ block.settings.text_color }};
          " {{ block.shopify_attributes }}>
            <span class="vip-icon">{{ block.settings.icon }}</span>
            <div class="vip-content">
              <h4 class="vip-title">{{ block.settings.title }}</h4>
              <p class="vip-text">{{ block.settings.text }}</p>
            </div>
          </div>

        {% when 'user_info_card' %}
          <div class="account-block block-profile-card" {{ block.shopify_attributes }}>
            <div class="profile-card-header">
              <div class="profile-avatar">
                <span>{{ customer.first_name | first | default: "M" }}</span>
              </div>
              <div class="profile-details">
                <h3 class="profile-name">{{ customer.name | default: "Sayın Müşterimiz" }}</h3>
                <p class="profile-email">{{ customer.email | default: "musteri@email.com" }}</p>
              </div>
            </div>
            <div class="profile-stats">
              <div class="stat-item">
                <span class="stat-num">{{ customer.orders_count | default: 3 }}</span>
                <span class="stat-label">Toplam Sipariş</span>
              </div>
              <div class="stat-item">
                <span class="stat-num">500</span>
                <span class="stat-label">Sadakat Puanı</span>
              </div>
              <div class="stat-item">
                <span class="stat-num">Aktif</span>
                <span class="stat-label">Üyelik Durumu</span>
              </div>
            </div>
          </div>

        {% when 'order_history' %}
          <div class="account-block block-orders-panel" {{ block.shopify_attributes }}>
            <h2 class="panel-title">{{ block.settings.title | default: "Son Siparişleriniz" }}</h2>
            {% if customer.orders.size > 0 %}
              <div class="orders-table-wrapper">
                <table class="orders-table">
                  <thead>
                    <tr>
                      <th>Sipariş No</th>
                      <th>Tarih</th>
                      <th>Ödeme Durumu</th>
                      <th>Teslimat</th>
                      <th>Toplam</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for order in customer.orders %}
                      <tr>
                        <td><a href="{{ order.customer_url }}" class="order-link">{{ order.name }}</a></td>
                        <td>{{ order.created_at | date: "%d.%m.%Y" }}</td>
                        <td><span class="status-pill status-paid">{{ order.financial_status_label }}</span></td>
                        <td><span class="status-pill status-fulfilled">{{ order.fulfillment_status_label }}</span></td>
                        <td class="order-total-col">{{ order.total_price | money }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% else %}
              <div class="demo-orders-table">
                <div class="demo-order-card">
                  <div class="doc-header">
                    <span class="doc-id">#LM-10492</span>
                    <span class="doc-date">24.07.2026</span>
                  </div>
                  <div class="doc-body">
                    <span>Radiance Glow Hyalüronik Serum 30ml (x1)</span>
                    <span class="status-pill status-paid">Ödendi / Kargoda</span>
                  </div>
                  <div class="doc-footer">
                    <span>Toplam: ₺450,00</span>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>

        {% when 'address_card' %}
          <div class="account-block block-address-panel" {{ block.shopify_attributes }}>
            <h2 class="panel-title">{{ block.settings.title | default: "Kayıtlı Adresleriniz" }}</h2>
            <div class="address-card-glass">
              {% if customer.default_address %}
                <p class="address-name"><strong>{{ customer.default_address.name }}</strong></p>
                <p class="address-line">{{ customer.default_address.address1 }}</p>
                <p class="address-city">{{ customer.default_address.city }} / {{ customer.default_address.country }}</p>
              {% else %}
                <p class="address-name"><strong>Demo Teslimat Adresi</strong></p>
                <p class="address-line">Bağdat Caddesi No: 142 Daire: 8, Kadıköy</p>
                <p class="address-city">İstanbul / Türkiye</p>
              {% endif %}
              <a href="{{ routes.account_addresses_url }}" class="edit-address-btn">Adresleri Yönet ({{ customer.addresses_count | default: 1 }})</a>
            </div>
          </div>

        {% when 'logout_button' %}
          <div class="account-block block-logout-wrapper" {{ block.shopify_attributes }}>
            <a href="{{ routes.account_logout_url }}" class="account-logout-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              <span>{{ block.settings.text | default: "Hesaptan Güvenli Çıkış Yap" }}</span>
            </a>
          </div>

      {% endcase %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .customer-account-section {
    background: var(--bg-color, #0b080c);
    padding-top: var(--padding-top, 80px);
    padding-bottom: var(--padding-bottom, 100px);
    padding-left: 20px;
    padding-right: 20px;
    min-height: 80vh;
  }

  .account-container {
    max-width: var(--max-width, 1100px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .account-block {
    width: 100%;
  }

  .account-badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .account-main-title {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .block-vip-banner {
    padding: 20px 24px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .vip-icon {
    font-size: 2rem;
  }

  .vip-title {
    margin: 0 0 4px 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .vip-text {
    margin: 0;
    font-size: 0.88rem;
    opacity: 0.85;
  }

  .block-profile-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 28px;
    backdrop-filter: blur(16px);
  }

  .profile-card-header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 24px;
  }

  .profile-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c25b82, #a24367);
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(194, 91, 130, 0.4);
  }

  .profile-name {
    margin: 0 0 4px 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
  }

  .profile-email {
    margin: 0;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .profile-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 20px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: #f7cad0;
  }

  .stat-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .block-orders-panel, .block-address-panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 28px;
  }

  .panel-title {
    margin: 0 0 20px 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .demo-order-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .doc-header, .doc-body, .doc-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .status-pill {
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(74, 222, 128, 0.2);
    color: #4ade80;
  }

  .address-card-glass {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    padding: 20px;
    color: rgba(255, 255, 255, 0.85);
  }

  .address-name { margin: 0 0 6px 0; color: #ffffff; }
  .address-line { margin: 0 0 4px 0; font-size: 0.88rem; }
  .address-city { margin: 0 0 16px 0; font-size: 0.84rem; color: rgba(255,255,255,0.6); }

  .edit-address-btn {
    display: inline-block;
    padding: 8px 18px;
    border-radius: 10px;
    background: rgba(194, 91, 130, 0.25);
    border: 1px solid #f7cad0;
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
  }

  .account-logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 14px;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .account-logout-btn:hover {
    background: rgba(239, 68, 68, 0.3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Müşteri Hesabım Paneli",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Arka Plan Rengi",
      "default": "#0b080c"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maksimum Genişlik (px)",
      "min": 700,
      "max": 1400,
      "step": 50,
      "default": 1100
    }
  ],
  "blocks": [
    {
      "type": "welcome_badge",
      "name": "🏷️ Rozet Cümlesi",
      "settings": [
        { "type": "text", "id": "text", "label": "Rozet Metni", "default": "👑 VIP SEÇKİN ÜYE" },
        { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#f7cad0" },
        { "type": "color", "id": "bg_color", "label": "Arka Plan", "default": "rgba(194, 91, 130, 0.2)" }
      ]
    },
    {
      "type": "heading",
      "name": "👑 Ana Başlık Cümlesi",
      "settings": [
        { "type": "text", "id": "text", "label": "Başlık Metni", "default": "Hesabım & Profilim" },
        { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#ffffff" },
        { "type": "range", "id": "font_size", "label": "Yazı Boyutu (px)", "min": 20, "max": 60, "step": 2, "default": 36 }
      ]
    },
    {
      "type": "vip_banner",
      "name": "✨ VIP Ayrıcalık Kutusu",
      "settings": [
        { "type": "text", "id": "icon", "label": "İkon", "default": "✨" },
        { "type": "text", "id": "title", "label": "Kutu Başlığı", "default": "500 VIP Sadakat Puanınız Bulunmaktadır!" },
        { "type": "textarea", "id": "text", "label": "Açıklama Cümlesi", "default": "Bir sonraki siparişinizde ₺50 indirim kuponu olarak kullanabilirsiniz." },
        { "type": "color", "id": "text_color", "label": "Metin Rengi", "default": "#f7cad0" },
        { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "rgba(194, 91, 130, 0.15)" },
        { "type": "color", "id": "border_color", "label": "Kenarlık Rengi", "default": "rgba(247, 202, 208, 0.3)" }
      ]
    },
    {
      "type": "user_info_card",
      "name": "👤 Profil Bilgi Kartı",
      "settings": []
    },
    {
      "type": "order_history",
      "name": "📦 Sipariş Geçmişi",
      "settings": [
        { "type": "text", "id": "title", "label": "Kutu Başlığı", "default": "Son Siparişleriniz" }
      ]
    },
    {
      "type": "address_card",
      "name": "🏠 Kayıtlı Adreslerim",
      "settings": [
        { "type": "text", "id": "title", "label": "Kutu Başlığı", "default": "Kayıtlı Adresleriniz" }
      ]
    },
    {
      "type": "logout_button",
      "name": "🚪 Çıkış Yap Butonu",
      "settings": [
        { "type": "text", "id": "text", "label": "Buton Metni", "default": "Hesaptan Güvenli Çıkış Yap" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Müşteri Hesabım Paneli"
    }
  ]
}
{% endschema %}
